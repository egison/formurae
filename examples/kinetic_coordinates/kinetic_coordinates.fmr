  populationError_down5[i,j] = f_down5'[i,j] + (-1) * (if scenario < (1 / 2) then (18797 / 180000) else if scenario < (3 / 2) then (1 / 9) + (1 / 9) * amplitude * cos(2 * dy * j + 2 * elapsed'[i,j] + dx * i + shear * sin(dy * j) + stretch * sin(dx * i)) else (1 / 9) + (-1 / 3) * amplitude * sin(dx * i + shear * sin(dy * j) + stretch * sin(dx * i)) + (1 / 3) * amplitude**2 * sin(dx * i + shear * sin(dy * j) + stretch * sin(dx * i))**2)
  populationError_down6[i,j] = f_down6'[i,j] + (-1) * (if scenario < (1 / 2) then (11593 / 360000) else if scenario < (3 / 2) then (1 / 36) + (1 / 36) * amplitude * cos((-3) * elapsed'[i,j] + 2 * dy * j + dx * i + shear * sin(dy * j) + stretch * sin(dx * i)) else (1 / 36) + (1 / 12) * amplitude * sin(dx * i + shear * sin(dy * j) + stretch * sin(dx * i)) + (1 / 12) * amplitude**2 * sin(dx * i + shear * sin(dy * j) + stretch * sin(dx * i))**2)
