  populationError_down8[i,j] = f_down8'[i,j] + (-1) * (if scenario < (1 / 2) then (2057 / 72000) else if scenario < (3 / 2) then (1 / 36) + (1 / 36) * amplitude * cos(elapsed'[i,j] + 2 * dy * j + dx * i + shear * sin(dy * j) + stretch * sin(dx * i)) else (1 / 36) + (-1 / 12) * amplitude * sin(dx * i + shear * sin(dy * j) + stretch * sin(dx * i)) + (1 / 12) * amplitude**2 * sin(dx * i + shear * sin(dy * j) + stretch * sin(dx * i))**2)
  populationError_down9[i,j] = f_down9'[i,j] + (-1) * (if scenario < (1 / 2) then (1937 / 72000) else if scenario < (3 / 2) then (1 / 36) + (1 / 36) * amplitude * cos((-1) * elapsed'[i,j] + 2 * dy * j + dx * i + shear * sin(dy * j) + stretch * sin(dx * i)) else (1 / 36) + (1 / 12) * amplitude * sin(dx * i + shear * sin(dy * j) + stretch * sin(dx * i)) + (1 / 12) * amplitude**2 * sin(dx * i + shear * sin(dy * j) + stretch * sin(dx * i))**2)
  square_down1[i,j] = populationError_down1[i,j]**2
  square_down2[i,j] = populationError_down2[i,j]**2
  square_down3[i,j] = populationError_down3[i,j]**2
