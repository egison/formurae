declare symbol x, y
declare symbol stretch, shear, scenario, amplitude, tau, dt, area, cell
declare symbol i, j, k, l, m, n, a, b

def feDimension : Integer := 2
def feCoordinates : Vector MathValue := [| x, y |]
def dimension : Integer := feDimension
def coordinates : Vector MathValue := feCoordinates
def FormuraeInternalCheckIndexShape expected value :=
  match assert "index extent does not match tensor slot"
               (length expected <= length (tensorShape value) && all (\(n, actual) -> n = 0 || n = actual) (zip expected (tensorShape value))) as bool with
    | #True -> value
def FormuraeInternalCheckAppendIndexShape expected value :=
  let shape := drop (length (tensorIndices value)) (tensorShape value)
   in match assert "index extent does not match tensor slot"
                   (length expected <= length shape && all (\(n, actual) -> n = 0 || n = actual) (zip expected shape)) as bool with
        | #True -> value


def feGeometryMetricRows := [[(1+stretch*cos(x))^2, (1+stretch*cos(x))*shear*cos(y)], [(1+stretch*cos(x))*shear*cos(y), 1+(shear*cos(y))^2]]
def feGeometryMetricRaw := (FE.metricTensor feDimension (\row column -> nth column (nth row feGeometryMetricRows)))_formuraeTensorIndex1_formuraeTensorIndex2
def feGeometrySymmetryVerified : Bool := assert "metric tensor must be symmetric" (FE.tensorComponentAt feGeometryMetricRaw [1,2] = FE.tensorComponentAt feGeometryMetricRaw [2,1])
def feGeometryOrthogonalityVerified : Bool := False
def feGeometryScaleRaw axis := sqrt (FE.tensorComponentAt feGeometryMetricRaw [axis, axis])
def feGeometryInverseMetricRaw := (FE.inverseMetricTensor feDimension feGeometryMetricRaw)~formuraeTensorIndex1~formuraeTensorIndex2
def feGeometryVolumeRaw := 1+stretch*cos(x)
def feGeometryMetric := match feGeometrySymmetryVerified as bool with
  | #True -> feGeometryMetricRaw
def feGeometryScale axis := match feGeometrySymmetryVerified as bool with
  | #True -> feGeometryScaleRaw axis
def feGeometryInverseMetric := match feGeometrySymmetryVerified as bool with
  | #True -> feGeometryInverseMetricRaw
def feGeometryVolume := match feGeometrySymmetryVerified as bool with
  | #True -> feGeometryVolumeRaw

def feGeometryScales : Vector MathValue := [| 1, 1 |]
def feGeometryId : Integer := 1
def fePrimitiveManifestId : String := "sha256:0ee432464c88e9939507b33379103bdddb344f032bbfef930eda05467060d009"
def metric_i_j := feGeometryMetric_i_j
def inverseMetric~i~j := feGeometryInverseMetric~i~j
def volume := feGeometryVolume
def epsilon : Tensor Integer := ε dimension
def FormuraeInternalKroneckerDelta : Tensor Integer := FE.kroneckerDelta dimension
def g_i_j := metric_i_j
def g~i~j := inverseMetric~i~j
def FormuraeInternalDiff value := Formurae.gridDiff value

