  sw'[i,j,k] = cell * shearing'[i,j,k]**2
  sr'[i,j,k] = far[i,j,k] * sw'[i,j,k]
  pfront'[i,j,k] = if radius**2 * compression'[i,j,k]**2 > front then far[i,j,k] else 0
  sfront'[i,j,k] = if radius**2 * shearing'[i,j,k]**2 > front then far[i,j,k] else 0
end function
