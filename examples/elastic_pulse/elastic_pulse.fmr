  energy'[i,j,k] = ((-2) * cell * lambda * shear * wavenumber * sigma_up1_up2[i,j,k] * sigma_up3_up3[i,j,k] * cos(dy * j * wavenumber) + (-1) * cell * lambda * sigma_up1_up1[i,j,k] * sigma_up2_up2[i,j,k] + (-1) * cell * lambda * sigma_up1_up1[i,j,k] * sigma_up3_up3[i,j,k] + (-1) * cell * lambda * sigma_up2_up2[i,j,k] * sigma_up3_up3[i,j,k] + (-1) * cell * lambda * sigma_up2_up2[i,j,k] * sigma_up3_up3[i,j,k] * shear**2 * wavenumber**2 * cos(dy * j * wavenumber)**2 + 2 * cell * lambda * sigma_up1_up1[i,j,k] * sigma_up2_up2[i,j,k] * shear**2 * wavenumber**2 * cos(dy * j * wavenumber)**2 + 2 * cell * lambda * shear**2 * wavenumber**2 * sigma_up2_up2[i,j,k]**2 * cos(dy * j * wavenumber)**2 + 2 * cell * mu * sigma_up1_up1[i,j,k] * sigma_up2_up2[i,j,k] * shear**2 * wavenumber**2 * cos(dy * j * wavenumber)**2 + 2 * cell * mu * shear**2 * wavenumber**2 * sigma_up2_up2[i,j,k]**2 * cos(dy * j * wavenumber)**2 + 2 * cell * mu * shear**2 * wavenumber**2 * sigma_up2_up3[i,j,k]**2 * cos(dy * j * wavenumber)**2 + 2 * cell * mu * sigma_up1_up2[i,j,k]**2 + 2 * cell * mu * sigma_up1_up3[i,j,k]**2 + 2 * cell * mu * sigma_up2_up3[i,j,k]**2 + 2 * cell * rho0 * mu**2 * shear**2 * wavenumber**2 * v_up2[i,j,k]**2 * cos(dy * j * wavenumber)**2 + 2 * cell * rho0 * mu**2 * v_up1[i,j,k]**2 + 2 * cell * rho0 * mu**2 * v_up2[i,j,k]**2 + 2 * cell * rho0 * mu**2 * v_up3[i,j,k]**2 + 3 * cell * lambda * mu * rho0 * shear**2 * wavenumber**2 * v_up2[i,j,k]**2 * cos(dy * j * wavenumber)**2 + 3 * cell * lambda * mu * rho0 * v_up1[i,j,k]**2 + 3 * cell * lambda * mu * rho0 * v_up2[i,j,k]**2 + 3 * cell * lambda * mu * rho0 * v_up3[i,j,k]**2 + 3 * cell * lambda * shear**2 * wavenumber**2 * sigma_up2_up3[i,j,k]**2 * cos(dy * j * wavenumber)**2 + 3 * cell * lambda * sigma_up1_up2[i,j,k]**2 + 3 * cell * lambda * sigma_up1_up3[i,j,k]**2 + 3 * cell * lambda * sigma_up2_up3[i,j,k]**2 + 4 * cell * lambda * shear * wavenumber * sigma_up1_up1[i,j,k] * sigma_up1_up2[i,j,k] * cos(dy * j * wavenumber) + 4 * cell * lambda * shear * wavenumber * sigma_up1_up2[i,j,k] * sigma_up2_up2[i,j,k] * cos(dy * j * wavenumber) + 4 * cell * lambda * sigma_up1_up2[i,j,k] * sigma_up2_up2[i,j,k] * shear**3 * wavenumber**3 * cos(dy * j * wavenumber)**3 + 4 * cell * lambda * shear**2 * wavenumber**2 * sigma_up1_up2[i,j,k]**2 * cos(dy * j * wavenumber)**2 + 4 * cell * mu * shear * wavenumber * sigma_up1_up1[i,j,k] * sigma_up1_up2[i,j,k] * cos(dy * j * wavenumber) + 4 * cell * mu * shear * wavenumber * sigma_up1_up2[i,j,k] * sigma_up2_up2[i,j,k] * cos(dy * j * wavenumber) + 4 * cell * mu * shear * wavenumber * sigma_up1_up3[i,j,k] * sigma_up2_up3[i,j,k] * cos(dy * j * wavenumber) + 4 * cell * mu * sigma_up1_up2[i,j,k] * sigma_up2_up2[i,j,k] * shear**3 * wavenumber**3 * cos(dy * j * wavenumber)**3 + 4 * cell * mu * shear**2 * wavenumber**2 * sigma_up1_up2[i,j,k]**2 * cos(dy * j * wavenumber)**2 + 4 * cell * rho0 * shear * wavenumber * v_up1[i,j,k] * v_up2[i,j,k] * mu**2 * cos(dy * j * wavenumber) + 6 * cell * lambda * mu * rho0 * shear * wavenumber * v_up1[i,j,k] * v_up2[i,j,k] * cos(dy * j * wavenumber) + 6 * cell * lambda * shear * wavenumber * sigma_up1_up3[i,j,k] * sigma_up2_up3[i,j,k] * cos(dy * j * wavenumber) + cell * lambda * shear**4 * wavenumber**4 * sigma_up2_up2[i,j,k]**2 * cos(dy * j * wavenumber)**4 + cell * lambda * sigma_up1_up1[i,j,k]**2 + cell * lambda * sigma_up2_up2[i,j,k]**2 + cell * lambda * sigma_up3_up3[i,j,k]**2 + cell * mu * shear**4 * wavenumber**4 * sigma_up2_up2[i,j,k]**2 * cos(dy * j * wavenumber)**4 + cell * mu * sigma_up1_up1[i,j,k]**2 + cell * mu * sigma_up2_up2[i,j,k]**2 + cell * mu * sigma_up3_up3[i,j,k]**2) / (4 * mu**2 + 6 * lambda * mu)
  modified'[i,j,k] = energy'[i,j,k] + (-1 / 4) * cell * shear * wavenumber * force_up1[i,j,k] * force_up2[i,j,k] * dt**2 * rho0**(-1) * cos(dy * j * wavenumber) + (-1 / 8) * cell * dt**2 * rho0**(-1) * shear**2 * wavenumber**2 * force_up2[i,j,k]**2 * cos(dy * j * wavenumber)**2 + (-1 / 8) * cell * dt**2 * rho0**(-1) * force_up1[i,j,k]**2 + (-1 / 8) * cell * dt**2 * rho0**(-1) * force_up2[i,j,k]**2 + (-1 / 8) * cell * dt**2 * rho0**(-1) * force_up3[i,j,k]**2
