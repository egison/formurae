end function

begin function (v_up1',v_up2',v_up3',sigma_up1_up1',sigma_up2_up2',sigma_up3_up3',sigma_up1_up2',sigma_up1_up3',sigma_up2_up3',compression',shearing',energy',modified',pw',pr',sw',sr',pfront',sfront',far') = step(v_up1,v_up2,v_up3,sigma_up1_up1,sigma_up2_up2,sigma_up3_up3,sigma_up1_up2,sigma_up1_up3,sigma_up2_up3,compression,shearing,energy,modified,pw,pr,sw,sr,pfront,sfront,far)
