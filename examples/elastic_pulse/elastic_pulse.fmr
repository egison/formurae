  force_up3[i,j,k] = ((-1 / 2) * sigma_up1_up3[i-1,j,k] + (1 / 2) * sigma_up1_up3[i+1,j,k]) / dx + ((-1 / 2) * sigma_up2_up3[i,j-1,k] + (1 / 2) * sigma_up2_up3[i,j+1,k]) / dy + ((-1 / 2) * sigma_up3_up3[i,j,k-1] + (1 / 2) * sigma_up3_up3[i,j,k+1]) / dz
