  nextForce_up2[i,j,k] = (-1) * shear * wavenumber * ((-1 / 2) * (sigma_up1_up1'[i-1,j,k] + shear * wavenumber * sigma_up1_up2'[i-1,j,k] * cos(dy * j * wavenumber)) + (1 / 2) * (sigma_up1_up1'[i+1,j,k] + shear * wavenumber * sigma_up1_up2'[i+1,j,k] * cos(dy * j * wavenumber))) / dx * cos(dy * j * wavenumber) + (-1) * shear * wavenumber * ((-1 / 2) * (sigma_up1_up2'[i,j-1,k] + shear * wavenumber * sigma_up2_up2'[i,j-1,k] * cos(dy * wavenumber * ((-1) + j))) + (1 / 2) * (sigma_up1_up2'[i,j+1,k] + shear * wavenumber * sigma_up2_up2'[i,j+1,k] * cos(dy * wavenumber * (1 + j)))) / dy * cos(dy * j * wavenumber) + (-1) * shear * wavenumber * ((-1 / 2) * (sigma_up1_up3'[i,j,k-1] + shear * wavenumber * sigma_up2_up3'[i,j,k-1] * cos(dy * j * wavenumber)) + (1 / 2) * (sigma_up1_up3'[i,j,k+1] + shear * wavenumber * sigma_up2_up3'[i,j,k+1] * cos(dy * j * wavenumber))) / dz * cos(dy * j * wavenumber) + shear * sigma_up1_up2'[i,j,k] * wavenumber**2 * sin(dy * j * wavenumber) + sigma_up2_up2'[i,j,k] * shear**2 * wavenumber**3 * cos(dy * j * wavenumber) * sin(dy * j * wavenumber) + ((-1 / 2) * (sigma_up1_up2'[i-1,j,k] + shear * wavenumber * sigma_up1_up1'[i-1,j,k] * cos(dy * j * wavenumber) + sigma_up1_up2'[i-1,j,k] * shear**2 * wavenumber**2 * cos(dy * j * wavenumber)**2) + (1 / 2) * (sigma_up1_up2'[i+1,j,k] + shear * wavenumber * sigma_up1_up1'[i+1,j,k] * cos(dy * j * wavenumber) + sigma_up1_up2'[i+1,j,k] * shear**2 * wavenumber**2 * cos(dy * j * wavenumber)**2)) / dx + ((-1 / 2) * (sigma_up2_up2'[i,j-1,k] + shear * wavenumber * sigma_up1_up2'[i,j-1,k] * cos(dy * wavenumber * ((-1) + j)) + sigma_up2_up2'[i,j-1,k] * shear**2 * wavenumber**2 * cos(dy * wavenumber * ((-1) + j))**2) + (1 / 2) * (sigma_up2_up2'[i,j+1,k] + shear * wavenumber * sigma_up1_up2'[i,j+1,k] * cos(dy * wavenumber * (1 + j)) + sigma_up2_up2'[i,j+1,k] * shear**2 * wavenumber**2 * cos(dy * wavenumber * (1 + j))**2)) / dy + ((-1 / 2) * (sigma_up2_up3'[i,j,k-1] + shear * wavenumber * sigma_up1_up3'[i,j,k-1] * cos(dy * j * wavenumber) + sigma_up2_up3'[i,j,k-1] * shear**2 * wavenumber**2 * cos(dy * j * wavenumber)**2) + (1 / 2) * (sigma_up2_up3'[i,j,k+1] + shear * wavenumber * sigma_up1_up3'[i,j,k+1] * cos(dy * j * wavenumber) + sigma_up2_up3'[i,j,k+1] * shear**2 * wavenumber**2 * cos(dy * j * wavenumber)**2)) / dz
  nextForce_up3[i,j,k] = ((-1 / 2) * sigma_up1_up3'[i-1,j,k] + (1 / 2) * sigma_up1_up3'[i+1,j,k]) / dx + ((-1 / 2) * sigma_up2_up3'[i,j-1,k] + (1 / 2) * sigma_up2_up3'[i,j+1,k]) / dy + ((-1 / 2) * sigma_up3_up3'[i,j,k-1] + (1 / 2) * sigma_up3_up3'[i,j,k+1]) / dz
  v_up1'[i,j,k] = half_up1[i,j,k] + (1 / 2) * dt * nextForce_up1[i,j,k] * rho0**(-1)
  v_up2'[i,j,k] = half_up2[i,j,k] + (1 / 2) * dt * nextForce_up2[i,j,k] * rho0**(-1)
  v_up3'[i,j,k] = half_up3[i,j,k] + (1 / 2) * dt * nextForce_up3[i,j,k] * rho0**(-1)
  far'[i,j,k] = far[i,j,k]
  compression'[i,j,k] = ((-1 / 2) * v_up1[i-1,j,k] + (1 / 2) * v_up1[i+1,j,k]) / dx + ((-1 / 2) * v_up2[i,j-1,k] + (1 / 2) * v_up2[i,j+1,k]) / dy + ((-1 / 2) * v_up3[i,j,k-1] + (1 / 2) * v_up3[i,j,k+1]) / dz
  curlv_up1[i,j,k] = (-1) * ((-1 / 2) * (v_up2[i,j,k-1] + shear * wavenumber * v_up1[i,j,k-1] * cos(dy * j * wavenumber) + v_up2[i,j,k-1] * shear**2 * wavenumber**2 * cos(dy * j * wavenumber)**2) + (1 / 2) * (v_up2[i,j,k+1] + shear * wavenumber * v_up1[i,j,k+1] * cos(dy * j * wavenumber) + v_up2[i,j,k+1] * shear**2 * wavenumber**2 * cos(dy * j * wavenumber)**2)) / dz + ((-1 / 2) * v_up3[i,j-1,k] + (1 / 2) * v_up3[i,j+1,k]) / dy
  curlv_up2[i,j,k] = (-1) * ((-1 / 2) * v_up3[i-1,j,k] + (1 / 2) * v_up3[i+1,j,k]) / dx + ((-1 / 2) * (v_up1[i,j,k-1] + shear * wavenumber * v_up2[i,j,k-1] * cos(dy * j * wavenumber)) + (1 / 2) * (v_up1[i,j,k+1] + shear * wavenumber * v_up2[i,j,k+1] * cos(dy * j * wavenumber))) / dz
  curlv_up3[i,j,k] = (-1) * ((-1 / 2) * (v_up1[i,j-1,k] + shear * wavenumber * v_up2[i,j-1,k] * cos(dy * wavenumber * ((-1) + j))) + (1 / 2) * (v_up1[i,j+1,k] + shear * wavenumber * v_up2[i,j+1,k] * cos(dy * wavenumber * (1 + j)))) / dy + ((-1 / 2) * (v_up2[i-1,j,k] + shear * wavenumber * v_up1[i-1,j,k] * cos(dy * j * wavenumber) + v_up2[i-1,j,k] * shear**2 * wavenumber**2 * cos(dy * j * wavenumber)**2) + (1 / 2) * (v_up2[i+1,j,k] + shear * wavenumber * v_up1[i+1,j,k] * cos(dy * j * wavenumber) + v_up2[i+1,j,k] * shear**2 * wavenumber**2 * cos(dy * j * wavenumber)**2)) / dx
