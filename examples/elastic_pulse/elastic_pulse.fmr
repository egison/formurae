  v_up1[i,j,k] = if (-2) * dx * i * x0 + (-2) * dy * j * y0 + (-2) * dz * k * z0 + (-2) * shear * x0 * sin(dy * j * wavenumber) + 2 * dx * i * shear * sin(dy * j * wavenumber) + shear**2 * sin(dy * j * wavenumber)**2 + x0**2 + y0**2 + z0**2 + (dx * i)**2 + (dy * j)**2 + (dz * k)**2 < (99 / 100) * radius**2 then exp(if (-2) * dx * i * x0 + (-2) * dy * j * y0 + (-2) * dz * k * z0 + (-2) * shear * x0 * sin(dy * j * wavenumber) + 2 * dx * i * shear * sin(dy * j * wavenumber) + shear**2 * sin(dy * j * wavenumber)**2 + x0**2 + y0**2 + z0**2 + (dx * i)**2 + (dy * j)**2 + (dz * k)**2 < (99 / 100) * radius**2 then ((-4) * dx * i * shear * sin(dy * j * wavenumber) + (-2) * shear**2 * sin(dy * j * wavenumber)**2 + (-2) * x0**2 + (-2) * y0**2 + (-2) * z0**2 + (-2) * (dx * i)**2 + (-2) * (dy * j)**2 + (-2) * (dz * k)**2 + 4 * dx * i * x0 + 4 * dy * j * y0 + 4 * dz * k * z0 + 4 * shear * x0 * sin(dy * j * wavenumber)) / ((-2) * dx * i * shear * sin(dy * j * wavenumber) + (-1) * shear**2 * sin(dy * j * wavenumber)**2 + (-1) * x0**2 + (-1) * y0**2 + (-1) * z0**2 + (-1) * (dx * i)**2 + (-1) * (dy * j)**2 + (-1) * (dz * k)**2 + 2 * dx * i * x0 + 2 * dy * j * y0 + 2 * dz * k * z0 + 2 * shear * x0 * sin(dy * j * wavenumber) + radius**2) else 0) else 0
