-- Continuous-time D2Q9 BGK on mapped finite-volume cells.
-- scenario 0: uniform equilibrium; 1: uniform stress relaxation; 2: shear eigenmode.
-- method 0: first-order upwind; 1: MC reconstruction. Both use SSPRK2.
dimension 2
axes x, y
index a : 9
index p : 2
param warpX = 0.2
param warpY = 0.15
param scenario = 2
param method = 1
param zeta = 0.008
param amplitude = 0.02
param timeScale = 1
param tau = sqrt(zeta*(1-zeta)*(1-zeta)/(1/3-zeta))
param decay = zeta/tau
param gauss = 0.5773502691896258
param hx = dx
param hy = dy
param dt = timeScale*0.1*hx*hy/(hx+hy)
param cell = hx*hy
param domainArea = 39.47841760435743
extern sin
extern cos
extern exp
extern sqrt
extern viscosityConfig

def mapX u v = u+warpX*sin(u)*sin(v)
def mapY u v = v+warpY*sin(u)*sin(v)
def weights = [| 4/9,1/9,1/9,1/9,1/9,1/36,1/36,1/36,1/36 |]
def ex = [| 0,1,-1,0,0,1,-1,1,-1 |]
def ey = [| 0,0,0,1,-1,1,-1,-1,1 |]
def ones = [| 1,1,1,1,1,1,1,1,1 |]
def smaller first second = if first < second then first else second
def bigger first second = if first > second then first else second
def maxPopulation T_a = bigger (bigger (bigger (T_1) (T_2)) (bigger (T_3) (T_4))) (bigger (bigger (T_5) (T_6)) (bigger (T_7) (bigger (T_8) (T_9))))
def minPopulation T_a = 0-maxPopulation (0-T_a)
def absval v = if v >= 0 then v else 0-v
def positive v = (v+absval(v))/2
-- Monotonized-central (MC) slope: no sign change, at most twice either difference.
def minmod first second = if first*second <= 0 then 0 else if first > 0 then smaller first second else 0-smaller (0-first) (0-second)
def mcSlope back forward = minmod ((back+forward)/2) (2*minmod back forward)
def reconstructSlope = method
-- Shoelace area of the mapped four-corner polygon divided by hx*hy.
-- This simplified expression is algebraically equal to that polygon area.
def areaDensity = 1+warpX*(2*sin(hx/2)/hx)*cos(hy/2)*cos(x)*sin(y)+warpY*(2*sin(hy/2)/hy)*cos(hx/2)*sin(x)*cos(y)
static field volumeCell := areaDensity
-- Oriented edge normals divided by computational edge length, from endpoints.
def faceX cx cy = ((mapY x (y+hy/2)-mapY x (y-hy/2))*cx-(mapX x (y+hy/2)-mapX x (y-hy/2))*cy)/hy
def faceY cx cy = ((mapX (x+hx/2) y-mapX (x-hx/2) y)*cy-(mapY (x+hx/2) y-mapY (x-hx/2) y)*cx)/hx
def speeds = generateTensor (\[k,q] -> if k = 1 then faceX ex_q ey_q else faceY ex_q ey_q) [2,9]
static field B~i_a @ primal := (speeds)~i_a
def mapMean = sin(x)*cos(hx/2)*sin(y)*cos(hy/2)
def mapXi = cos(x)*sin(hx/2)*sin(y)*cos(hy/2)
def mapEta = sin(x)*cos(hx/2)*cos(y)*sin(hy/2)
def mapXiEta = cos(x)*sin(hx/2)*cos(y)*sin(hy/2)
def quadPhase xi eta = x+hx*xi/2+warpX*(mapMean+mapXi*xi+mapEta*eta+mapXiEta*xi*eta)
def quadJacobian xi eta = cell/4+warpX*hy*(mapXi+mapXiEta*eta)/2+warpY*hx*(mapEta+mapXiEta*xi)/2
def cellAverage fn = (quadJacobian gauss gauss*fn(quadPhase gauss gauss)+quadJacobian (0-gauss) gauss*fn(quadPhase (0-gauss) gauss)+quadJacobian gauss (0-gauss)*fn(quadPhase gauss (0-gauss))+quadJacobian (0-gauss) (0-gauss)*fn(quadPhase (0-gauss) (0-gauss)))/(cell*areaDensity)
-- Four-point Gaussian quadrature; positive weights and fourth-order accuracy.
static field meanCos := cellAverage cos
static field meanSin := cellAverage sin

-- p labels a fixed physical orthonormal frame, not the grid coordinates i.
-- Changing the grid map changes B and cell geometry, not this collision model.
def frame = generateTensor (\[k,q] -> if k = 1 then ex_q else ey_q) [2,9]
macro equilibrium Q =
  local state_a = Q
  local rho = ones~a . state_a
  local u~p = (frame~p~a . state_a)/rho
  local cu_a = frame_p_a . u~p
  local uu = u~p . u_p
  in weights_a*rho*(1+3*cu_a+(9/2)*cu_a^2-(3/2)*uu)

def uniformEquilibrium w cx cy = w*(1+3*(cx*0.03+cy*0.02)+(9/2)*(cx*0.03+cy*0.02)^2-(3/2)*(0.03^2+0.02^2))
def relaxingComponent w cx t = w*(1+amplitude*(cx^2-1/3)*exp((0-t)/tau))
def shearComponent w cx cy = w*(1+3*cy*amplitude*((1-zeta)*meanSin-tau*cx*meanCos)/((1-zeta)^2+(tau*cx)^2))
def initialComponent w cx cy = if scenario < 0.5 then uniformEquilibrium w cx cy else if scenario < 1.5 then relaxingComponent w cx 0 else shearComponent w cx cy
def initial = generateTensor (\[q] -> initialComponent weights_q ex_q ey_q) [9]
def componentReference w cx cy t = if scenario < 0.5 then uniformEquilibrium w cx cy else relaxingComponent w cx t
def reference t = generateTensor (\[q] -> componentReference weights_q ex_q ey_q t) [9]
def initialUx = if scenario < 0.5 then 0.03 else 0
def initialUy = if scenario < 0.5 then 0.02 else if scenario < 1.5 then 0 else amplitude*meanSin
def referenceUy t = if scenario < 0.5 then 0.02 else if scenario < 1.5 then 0 else amplitude*meanSin*exp((0-decay)*t)

macro transport Q =
  local lower~i_a @ primal = [| sampleLower(Q,1,0), sampleLower(Q,0,1) |]~i_a
  local upper~i_a @ primal = [| sampleUpper(Q,1,0), sampleUpper(Q,0,1) |]~i_a
  local jump~i_a @ primal = upper~i_a-lower~i_a
  local backwardX_a = sampleLower(jump~1_a,0,0)
  local forwardX_a = sampleUpper(jump~1_a,0,0)
  local backwardY_a = sampleLower(jump~2_a,0,0)
  local forwardY_a = sampleUpper(jump~2_a,0,0)
  local slopeX_a = reconstructSlope*mcSlope backwardX_a forwardX_a
  local slopeY_a = reconstructSlope*mcSlope backwardY_a forwardY_a
  local left~i_a @ primal = lower~i_a+[| sampleLower(slopeX,1,0), sampleLower(slopeY,0,1) |]~i_a/2
  local right~i_a @ primal = upper~i_a-[| sampleUpper(slopeX,1,0), sampleUpper(slopeY,0,1) |]~i_a/2
  local flux~i_a @ primal = (B~i_a*(left~i_a+right~i_a)-absval(B~i_a)*(right~i_a-left~i_a))/2
  in (0-∂_i flux~i_a)/volumeCell

field f_a
field original_a
field stage
field elapsed
field mass
field momentumX
field momentumY
field mode
field referenceMode
field modeError
field velocityError
field velocityErrorL1
field populationError
field densityError
field lowest
field equilibriumLowest
field cfl
field positivityBound
field collisionResidual
field minArea
field relaxationTime
field decayRate
field hydrodynamicViscosity
init:
  f_a := (initial)_a
  original_a := (initial)_a
  stage := 0
  elapsed := 0
  mass := cell*volumeCell/domainArea
  momentumX := cell*volumeCell*initialUx/domainArea
  momentumY := cell*volumeCell*initialUy/domainArea
  mode := 2*cell*volumeCell*initialUy*meanSin/domainArea
  referenceMode := 2*cell*volumeCell*initialUy*meanSin/domainArea
  modeError := 0
  velocityError := 0
  velocityErrorL1 := 0
  populationError := 0
  densityError := 0
  lowest := minPopulation ((initial)_a/weights_a)
  equilibriumLowest := 1
  cfl := 0
  positivityBound := 0
  collisionResidual := 0
  minArea := cell*volumeCell
  relaxationTime := tau
  decayRate := decay
  hydrodynamicViscosity := tau/3
step:
  local advection_a = transport f
  local feq_a = equilibrium f
  local collision_a = (feq_a-f_a)/tau
  local euler_a = f_a+dt*(advection_a+collision_a)
  original'_a = if stage < 0.5 then f_a else original_a
  f'_a = if stage < 0.5 then euler_a else (original_a+euler_a)/2
  elapsed' = if stage < 0.5 then elapsed else elapsed+dt
  stage' = if stage < 0.5 then 1 else 0
  local rho = ones~a . f'_a
  local ux = (ex~a . f'_a)/rho
  local uy = (ey~a . f'_a)/rho
  local measure = cell*volumeCell/domainArea
  local referenceU = referenceUy elapsed'
  mass' = measure*rho
  momentumX' = measure*rho*ux
  momentumY' = measure*rho*uy
  mode' = if stage < 0.5 then mode else 2*measure*uy*meanSin
  referenceMode' = if stage < 0.5 then referenceMode else 2*measure*referenceU*meanSin
  modeError' = if stage < 0.5 then modeError else 2*measure*(uy-referenceU)*meanSin/amplitude
  velocityError' = if stage < 0.5 then velocityError else bigger (absval(ux-initialUx)) (absval(uy-referenceU))
  velocityErrorL1' = if stage < 0.5 then velocityErrorL1 else measure*(absval(ux-initialUx)+absval(uy-referenceU))
  local errors_a = absval((f'_a-(reference elapsed')_a)/weights_a)
  populationError' = if scenario > 1.5 then 0 else if stage < 0.5 then populationError else maxPopulation errors
  densityError' = bigger densityError (absval(rho-1))
  local low = smaller (minPopulation (f'_a/weights_a)) (minPopulation (euler_a/weights_a))
  lowest' = smaller lowest low
  equilibriumLowest' = smaller equilibriumLowest (minPopulation (feq_a/weights_a))
  local outgoingX_a = positive(sampleUpper(B~1_a,0,0))+positive(0-sampleLower(B~1_a,0,0))
  local outgoingY_a = positive(sampleUpper(B~2_a,0,0))+positive(0-sampleLower(B~2_a,0,0))
  cfl' = maxPopulation (dt*(outgoingX_a/hx+outgoingY_a/hy)/volumeCell)
  positivityBound' = (1+method)*cfl'+dt/tau
  local residual = bigger (absval(ones~a . collision_a)) (bigger (absval(ex~a . collision_a)) (absval(ey~a . collision_a)))
  collisionResidual' = bigger collisionResidual residual
  minArea' = cell*volumeCell
  relaxationTime' = tau
  decayRate' = decay
  hydrodynamicViscosity' = tau/3
