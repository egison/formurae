dimension :: 2
axes :: r,z

double :: sbpLoR = 2.0e-3+0.5*dr
double :: sbpHiR = 2.0e-3+(total_grid_r - 1.5)*dr
double :: sbpHinvR = 2.0/dr
double :: sbpLoZ = 0.5*dz
double :: sbpHiZ = (total_grid_z - 1.5)*dz
double :: sbpHinvZ = 2.0/dz
double :: capacity = 2000000.0
double :: radial = 0.5
double :: axial = 10.0
double :: side = 50.0
double :: ends = 0.0
double :: heating = 100000.0
double :: dt = 0.01
double :: cell = 6.283185307179586 * dr * dz
double :: initial = 0.0
double :: hotspot = 4.0

extern function :: exp

begin function (T,clock,heat,supplied,removed,balance,uniformError) = init()
  double [] :: T, clock, heat, supplied, removed, balance, uniformError
  T[i,j] = initial
  clock[i,j] = 0
  heat[i,j] = capacity * cell * initial * ((1 / 500) + dr * i) * (if ((1 / 500) + dr * i < sbpLoR) + ((1 / 500) + dr * i > sbpHiR) > 0 then (1 / 2) else 1) * (if (dz * j < sbpLoZ) + (dz * j > sbpHiZ) > 0 then (1 / 2) else 1)
  supplied[i,j] = 0
  removed[i,j] = 0
  balance[i,j] = 0
  uniformError[i,j] = 0
end function

begin function (T',clock',heat',supplied',removed',balance',uniformError') = step(T,clock,heat,supplied,removed,balance,uniformError)
  double [] :: T', clock', heat', supplied', removed', balance', uniformError'
  q_up1[i,j] = radial * (T[i+1,j] + (-1) * T[i,j]) / dr
  q_up2[i,j] = axial * (T[i,j+1] + (-1) * T[i,j]) / dz
  flux_up1[i,j] = q_up1[i,j] * ((1 / 500) + dr * ((1 / 2) + i))
  flux_up2[i,j] = q_up2[i,j]
  T'[i,j] = T[i,j] + dt * heating * hotspot * capacity**(-1) * exp((-169 / 16) + (-10000) * (dz * j)**2 + 650 * dz * j) + dt * heating * capacity**(-1) + dt * capacity**(-1) * ((1 / 500) + dr * i)**(-1) * (if i == 0 then (flux_up1[i+1,j] + (-1) * flux_up1[i,j]) / dr else if i == (-1) + total_grid_r then (flux_up1[i-1,j] + (-1) * flux_up1[i-2,j]) / dr else (flux_up1[i,j] + (-1) * flux_up1[i-1,j]) / dr) + dt * capacity**(-1) * ((1 / 500) + dr * i)**(-1) * (if (1 / 500) + dr * i < sbpLoR then sbpHinvR * (if i == 0 then (-1 / 2) * flux_up1[i+1,j] + (3 / 2) * flux_up1[i,j] else if i == (-1) + total_grid_r then (-1 / 2) * flux_up1[i-2,j] + (3 / 2) * flux_up1[i-1,j] else 0) else 0) + dt * capacity**(-1) * ((1 / 500) + dr * i)**(-1) * (if (1 / 500) + dr * i > sbpHiR then (-1) * sbpHinvR * side * T[i,j] * ((1 / 500) + dr * i) + (-1) * sbpHinvR * (if i == 0 then (-1 / 2) * flux_up1[i+1,j] + (3 / 2) * flux_up1[i,j] else if i == (-1) + total_grid_r then (-1 / 2) * flux_up1[i-2,j] + (3 / 2) * flux_up1[i-1,j] else 0) else 0) + dt * capacity**(-1) * (if j == 0 then (flux_up2[i,j+1] + (-1) * flux_up2[i,j]) / dz else if j == (-1) + total_grid_z then (flux_up2[i,j-1] + (-1) * flux_up2[i,j-2]) / dz else (flux_up2[i,j] + (-1) * flux_up2[i,j-1]) / dz) + dt * capacity**(-1) * (if dz * j < sbpLoZ then (-1) * ends * sbpHinvZ * T[i,j] + sbpHinvZ * (if j == 0 then (-1 / 2) * flux_up2[i,j+1] + (3 / 2) * flux_up2[i,j] else if j == (-1) + total_grid_z then (-1 / 2) * flux_up2[i,j-2] + (3 / 2) * flux_up2[i,j-1] else 0) else 0) + dt * capacity**(-1) * (if dz * j > sbpHiZ then (-1) * ends * sbpHinvZ * T[i,j] + (-1) * sbpHinvZ * (if j == 0 then (-1 / 2) * flux_up2[i,j+1] + (3 / 2) * flux_up2[i,j] else if j == (-1) + total_grid_z then (-1 / 2) * flux_up2[i,j-2] + (3 / 2) * flux_up2[i,j-1] else 0) else 0)
  clock'[i,j] = dt + clock[i,j]
  heat'[i,j] = capacity * cell * T'[i,j] * ((1 / 500) + dr * i) * (if ((1 / 500) + dr * i < sbpLoR) + ((1 / 500) + dr * i > sbpHiR) > 0 then (1 / 2) else 1) * (if (dz * j < sbpLoZ) + (dz * j > sbpHiZ) > 0 then (1 / 2) else 1)
  supplied'[i,j] = supplied[i,j] + cell * dt * heating * hotspot * ((1 / 500) + dr * i) * exp((-169 / 16) + (-10000) * (dz * j)**2 + 650 * dz * j) * (if ((1 / 500) + dr * i < sbpLoR) + ((1 / 500) + dr * i > sbpHiR) > 0 then (1 / 2) else 1) * (if (dz * j < sbpLoZ) + (dz * j > sbpHiZ) > 0 then (1 / 2) else 1) + cell * dt * heating * ((1 / 500) + dr * i) * (if ((1 / 500) + dr * i < sbpLoR) + ((1 / 500) + dr * i > sbpHiR) > 0 then (1 / 2) else 1) * (if (dz * j < sbpLoZ) + (dz * j > sbpHiZ) > 0 then (1 / 2) else 1)
  removed'[i,j] = removed[i,j] + cell * dt * ((1 / 500) + dr * i) * (if (1 / 500) + dr * i > sbpHiR then sbpHinvR * side * T[i,j] else 0) * (if ((1 / 500) + dr * i < sbpLoR) + ((1 / 500) + dr * i > sbpHiR) > 0 then (1 / 2) else 1) * (if (dz * j < sbpLoZ) + (dz * j > sbpHiZ) > 0 then (1 / 2) else 1) + cell * dt * ((1 / 500) + dr * i) * (if ((1 / 500) + dr * i < sbpLoR) + ((1 / 500) + dr * i > sbpHiR) > 0 then (1 / 2) else 1) * (if (dz * j < sbpLoZ) + (dz * j > sbpHiZ) > 0 then (1 / 2) else 1) * (if (dz * j < sbpLoZ) + (dz * j > sbpHiZ) > 0 then ends * sbpHinvZ * T[i,j] else 0)
  balance'[i,j] = heat'[i,j] + removed'[i,j] + (-1) * capacity * cell * initial * ((1 / 500) + dr * i) * (if ((1 / 500) + dr * i < sbpLoR) + ((1 / 500) + dr * i > sbpHiR) > 0 then (1 / 2) else 1) * (if (dz * j < sbpLoZ) + (dz * j > sbpHiZ) > 0 then (1 / 2) else 1) + (-1) * supplied'[i,j]
  uniformError'[i,j] = T'[i,j] + (-1) * heating * clock'[i,j] * capacity**(-1) + (-1) * initial
end function
