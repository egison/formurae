dimension 3
axes r, θ, φ
metric g
metric scale [1, 1 + r, `(1 + r) * sin (1 + θ)]

boundary r : sbp
boundary θ : sbp

-- Coordinate-independent diagnostics of the velocity field.
-- epsilon is the alternating symbol; volume is sqrt(det g).
def waveDiv V~a = withSymbols [i] ((∂_i (volume * V~i)) / volume)
def waveCurl V~a = withSymbols [i, j, k, l] ((epsilon~i~j~k . ∂_j (g_k_l . V~l)) / volume)

field v~i @ collocated
field compression @ collocated
field rotation~i @ collocated

init:
  v~i = [| 0.0, 0.0, 0.0 |]~i
  compression = 0.0
  rotation~i = [| 0.0, 0.0, 0.0 |]~i

step:
  v'~i = v~i
  compression' = waveDiv v
  rotation'~i = waveCurl v
