dimension :: 3
axes :: r,theta,phi

double :: sbpLoR = 0.5*dr
double :: sbpHiR = (total_grid_r - 1.5)*dr
double :: sbpHinvR = 2.0/dr
double :: sbpLoTheta = 0.5*dtheta
double :: sbpHiTheta = (total_grid_theta - 1.5)*dtheta
double :: sbpHinvTheta = 2.0/dtheta

extern function :: sin

begin function (v_up1,v_up2,v_up3,compression,rotation_up1,rotation_up2,rotation_up3) = init()
  double [] :: v_up1, v_up2, v_up3, compression, rotation_up1, rotation_up2, rotation_up3
  v_up1[i,j,k] = 0.0
  v_up2[i,j,k] = 0.0
  v_up3[i,j,k] = 0.0
  compression[i,j,k] = 0.0
  rotation_up1[i,j,k] = 0.0
  rotation_up2[i,j,k] = 0.0
  rotation_up3[i,j,k] = 0.0
end function

begin function (v_up1',v_up2',v_up3',compression',rotation_up1',rotation_up2',rotation_up3') = step(v_up1,v_up2,v_up3,compression,rotation_up1,rotation_up2,rotation_up3)
  double [] :: v_up1', v_up2', v_up3', compression', rotation_up1', rotation_up2', rotation_up3'
  v_up1'[i,j,k] = v_up1[i,j,k]
  v_up2'[i,j,k] = v_up2[i,j,k]
  v_up3'[i,j,k] = v_up3[i,j,k]
  compression'[i,j,k] = (((-1 / 2) * (2 * dr * i * v_up3[i,j,k-1] * sin(1 + dtheta * j) + v_up3[i,j,k-1] * (dr * i)**2 * sin(1 + dtheta * j) + v_up3[i,j,k-1] * sin(1 + dtheta * j)) + (1 / 2) * (2 * dr * i * v_up3[i,j,k+1] * sin(1 + dtheta * j) + v_up3[i,j,k+1] * (dr * i)**2 * sin(1 + dtheta * j) + v_up3[i,j,k+1] * sin(1 + dtheta * j))) / dphi + (if i == 0 then ((-1) * (2 * dr * i * v_up1[i,j,k] * sin(1 + dtheta * j) + v_up1[i,j,k] * (dr * i)**2 * sin(1 + dtheta * j) + v_up1[i,j,k] * sin(1 + dtheta * j)) + 2 * dr * v_up1[i+1,j,k] * (1 + i) * sin(1 + dtheta * j) + v_up1[i+1,j,k] * (dr * (1 + i))**2 * sin(1 + dtheta * j) + v_up1[i+1,j,k] * sin(1 + dtheta * j)) / dr else if i == (-1) + total_grid_r then ((-1) * (2 * dr * v_up1[i-1,j,k] * ((-1) + i) * sin(1 + dtheta * j) + v_up1[i-1,j,k] * (dr * ((-1) + i))**2 * sin(1 + dtheta * j) + v_up1[i-1,j,k] * sin(1 + dtheta * j)) + 2 * dr * i * v_up1[i,j,k] * sin(1 + dtheta * j) + v_up1[i,j,k] * (dr * i)**2 * sin(1 + dtheta * j) + v_up1[i,j,k] * sin(1 + dtheta * j)) / dr else ((-1 / 2) * (2 * dr * v_up1[i-1,j,k] * ((-1) + i) * sin(1 + dtheta * j) + v_up1[i-1,j,k] * (dr * ((-1) + i))**2 * sin(1 + dtheta * j) + v_up1[i-1,j,k] * sin(1 + dtheta * j)) + (1 / 2) * (2 * dr * v_up1[i+1,j,k] * (1 + i) * sin(1 + dtheta * j) + v_up1[i+1,j,k] * (dr * (1 + i))**2 * sin(1 + dtheta * j) + v_up1[i+1,j,k] * sin(1 + dtheta * j))) / dr) + (if j == 0 then ((-1) * (2 * dr * i * v_up2[i,j,k] * sin(1 + dtheta * j) + v_up2[i,j,k] * (dr * i)**2 * sin(1 + dtheta * j) + v_up2[i,j,k] * sin(1 + dtheta * j)) + 2 * dr * i * v_up2[i,j+1,k] * sin(1 + dtheta * (1 + j)) + v_up2[i,j+1,k] * (dr * i)**2 * sin(1 + dtheta * (1 + j)) + v_up2[i,j+1,k] * sin(1 + dtheta * (1 + j))) / dtheta else if j == (-1) + total_grid_theta then ((-1) * (2 * dr * i * v_up2[i,j-1,k] * sin(1 + dtheta * ((-1) + j)) + v_up2[i,j-1,k] * (dr * i)**2 * sin(1 + dtheta * ((-1) + j)) + v_up2[i,j-1,k] * sin(1 + dtheta * ((-1) + j))) + 2 * dr * i * v_up2[i,j,k] * sin(1 + dtheta * j) + v_up2[i,j,k] * (dr * i)**2 * sin(1 + dtheta * j) + v_up2[i,j,k] * sin(1 + dtheta * j)) / dtheta else ((-1 / 2) * (2 * dr * i * v_up2[i,j-1,k] * sin(1 + dtheta * ((-1) + j)) + v_up2[i,j-1,k] * (dr * i)**2 * sin(1 + dtheta * ((-1) + j)) + v_up2[i,j-1,k] * sin(1 + dtheta * ((-1) + j))) + (1 / 2) * (2 * dr * i * v_up2[i,j+1,k] * sin(1 + dtheta * (1 + j)) + v_up2[i,j+1,k] * (dr * i)**2 * sin(1 + dtheta * (1 + j)) + v_up2[i,j+1,k] * sin(1 + dtheta * (1 + j)))) / dtheta)) / (2 * dr * i * sin(1 + dtheta * j) + (dr * i)**2 * sin(1 + dtheta * j) + sin(1 + dtheta * j))
  rotation_up1'[i,j,k] = ((-1) * ((-1 / 2) * (v_up2[i,j,k-1] + 2 * dr * i * v_up2[i,j,k-1] + v_up2[i,j,k-1] * (dr * i)**2) + (1 / 2) * (v_up2[i,j,k+1] + 2 * dr * i * v_up2[i,j,k+1] + v_up2[i,j,k+1] * (dr * i)**2)) / dphi + (if j == 0 then ((-1) * (2 * dr * i * v_up3[i,j,k] * sin(1 + dtheta * j)**2 + v_up3[i,j,k] * (dr * i)**2 * sin(1 + dtheta * j)**2 + v_up3[i,j,k] * sin(1 + dtheta * j)**2) + 2 * dr * i * v_up3[i,j+1,k] * sin(1 + dtheta * (1 + j))**2 + v_up3[i,j+1,k] * (dr * i)**2 * sin(1 + dtheta * (1 + j))**2 + v_up3[i,j+1,k] * sin(1 + dtheta * (1 + j))**2) / dtheta else if j == (-1) + total_grid_theta then ((-1) * (2 * dr * i * v_up3[i,j-1,k] * sin(1 + dtheta * ((-1) + j))**2 + v_up3[i,j-1,k] * (dr * i)**2 * sin(1 + dtheta * ((-1) + j))**2 + v_up3[i,j-1,k] * sin(1 + dtheta * ((-1) + j))**2) + 2 * dr * i * v_up3[i,j,k] * sin(1 + dtheta * j)**2 + v_up3[i,j,k] * (dr * i)**2 * sin(1 + dtheta * j)**2 + v_up3[i,j,k] * sin(1 + dtheta * j)**2) / dtheta else ((-1 / 2) * (2 * dr * i * v_up3[i,j-1,k] * sin(1 + dtheta * ((-1) + j))**2 + v_up3[i,j-1,k] * (dr * i)**2 * sin(1 + dtheta * ((-1) + j))**2 + v_up3[i,j-1,k] * sin(1 + dtheta * ((-1) + j))**2) + (1 / 2) * (2 * dr * i * v_up3[i,j+1,k] * sin(1 + dtheta * (1 + j))**2 + v_up3[i,j+1,k] * (dr * i)**2 * sin(1 + dtheta * (1 + j))**2 + v_up3[i,j+1,k] * sin(1 + dtheta * (1 + j))**2)) / dtheta)) / (2 * dr * i * sin(1 + dtheta * j) + (dr * i)**2 * sin(1 + dtheta * j) + sin(1 + dtheta * j))
  rotation_up2'[i,j,k] = ((-1) * (if i == 0 then ((-1) * (2 * dr * i * v_up3[i,j,k] * sin(1 + dtheta * j)**2 + v_up3[i,j,k] * (dr * i)**2 * sin(1 + dtheta * j)**2 + v_up3[i,j,k] * sin(1 + dtheta * j)**2) + 2 * dr * v_up3[i+1,j,k] * (1 + i) * sin(1 + dtheta * j)**2 + v_up3[i+1,j,k] * (dr * (1 + i))**2 * sin(1 + dtheta * j)**2 + v_up3[i+1,j,k] * sin(1 + dtheta * j)**2) / dr else if i == (-1) + total_grid_r then ((-1) * (2 * dr * v_up3[i-1,j,k] * ((-1) + i) * sin(1 + dtheta * j)**2 + v_up3[i-1,j,k] * (dr * ((-1) + i))**2 * sin(1 + dtheta * j)**2 + v_up3[i-1,j,k] * sin(1 + dtheta * j)**2) + 2 * dr * i * v_up3[i,j,k] * sin(1 + dtheta * j)**2 + v_up3[i,j,k] * (dr * i)**2 * sin(1 + dtheta * j)**2 + v_up3[i,j,k] * sin(1 + dtheta * j)**2) / dr else ((-1 / 2) * (2 * dr * v_up3[i-1,j,k] * ((-1) + i) * sin(1 + dtheta * j)**2 + v_up3[i-1,j,k] * (dr * ((-1) + i))**2 * sin(1 + dtheta * j)**2 + v_up3[i-1,j,k] * sin(1 + dtheta * j)**2) + (1 / 2) * (2 * dr * v_up3[i+1,j,k] * (1 + i) * sin(1 + dtheta * j)**2 + v_up3[i+1,j,k] * (dr * (1 + i))**2 * sin(1 + dtheta * j)**2 + v_up3[i+1,j,k] * sin(1 + dtheta * j)**2)) / dr) + ((-1 / 2) * v_up1[i,j,k-1] + (1 / 2) * v_up1[i,j,k+1]) / dphi) / (2 * dr * i * sin(1 + dtheta * j) + (dr * i)**2 * sin(1 + dtheta * j) + sin(1 + dtheta * j))
  rotation_up3'[i,j,k] = ((-1) * (if j == 0 then (v_up1[i,j+1,k] + (-1) * v_up1[i,j,k]) / dtheta else if j == (-1) + total_grid_theta then (v_up1[i,j,k] + (-1) * v_up1[i,j-1,k]) / dtheta else ((-1 / 2) * v_up1[i,j-1,k] + (1 / 2) * v_up1[i,j+1,k]) / dtheta) + (if i == 0 then (v_up2[i+1,j,k] + (-1) * (v_up2[i,j,k] + 2 * dr * i * v_up2[i,j,k] + v_up2[i,j,k] * (dr * i)**2) + 2 * dr * v_up2[i+1,j,k] * (1 + i) + v_up2[i+1,j,k] * (dr * (1 + i))**2) / dr else if i == (-1) + total_grid_r then (v_up2[i,j,k] + (-1) * (v_up2[i-1,j,k] + 2 * dr * v_up2[i-1,j,k] * ((-1) + i) + v_up2[i-1,j,k] * (dr * ((-1) + i))**2) + 2 * dr * i * v_up2[i,j,k] + v_up2[i,j,k] * (dr * i)**2) / dr else ((-1 / 2) * (v_up2[i-1,j,k] + 2 * dr * v_up2[i-1,j,k] * ((-1) + i) + v_up2[i-1,j,k] * (dr * ((-1) + i))**2) + (1 / 2) * (v_up2[i+1,j,k] + 2 * dr * v_up2[i+1,j,k] * (1 + i) + v_up2[i+1,j,k] * (dr * (1 + i))**2)) / dr)) / (2 * dr * i * sin(1 + dtheta * j) + (dr * i)**2 * sin(1 + dtheta * j) + sin(1 + dtheta * j))
end function
