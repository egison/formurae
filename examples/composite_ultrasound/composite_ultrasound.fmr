dimension :: 2
axes :: x,y

double :: lambda = 2.0
double :: mu = 1.0
double :: alpha = 5.0
double :: angle = 0.0
double :: damage = 0.0
double :: dt = 0.0025
double :: cell = dx * dy
double :: mode = 0.0
double :: wave = 0.39269908169872414

extern function :: sin
extern function :: cos
extern function :: exp
extern function :: sqrt

begin function (v_up1,v_up2,E_down1_down1,E_down2_down2,E_down1_down2,clock,speed,energy,modified,signal,modeError) = init()
  double [] :: v_up1, v_up2, E_down1_down1, E_down2_down2, E_down1_down2, clock, speed, energy, modified, signal, modeError
  v_up1[i,j] = mode * sin(dx * i * wave)
  v_up2[i,j] = 0
  E_down1_down1[i,j] = (-1) * mode * exp((-5200 / 9) + (-100 / 9) * (dx * i)**2 + (-100 / 9) * (dy * j)**2 + (400 / 3) * dy * j + (800 / 9) * dx * i) + exp((-5200 / 9) + (-100 / 9) * (dx * i)**2 + (-100 / 9) * (dy * j)**2 + (400 / 3) * dy * j + (800 / 9) * dx * i)
  E_down2_down2[i,j] = (-1) * mode * exp((-5200 / 9) + (-100 / 9) * (dx * i)**2 + (-100 / 9) * (dy * j)**2 + (400 / 3) * dy * j + (800 / 9) * dx * i) + exp((-5200 / 9) + (-100 / 9) * (dx * i)**2 + (-100 / 9) * (dy * j)**2 + (400 / 3) * dy * j + (800 / 9) * dx * i)
  E_down1_down2[i,j] = 0
  clock[i,j] = 0
  speed[i,j] = sqrt(v_up1[i,j]**2 + v_up2[i,j]**2)
  energy[i,j] = (-2) * alpha * cell * damage * E_down1_down1[i,j] * E_down1_down2[i,j] * cos(angle)**3 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) * sin(angle) + (-2) * alpha * cell * damage * E_down1_down2[i,j] * E_down2_down2[i,j] * sin(angle)**3 * cos(angle) * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-2) * alpha * cell * damage * E_down1_down2[i,j]**2 * cos(angle)**2 * sin(angle)**2 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-2) * cell * damage * mu * E_down1_down2[i,j]**2 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * alpha * cell * damage * E_down1_down1[i,j] * E_down2_down2[i,j] * cos(angle)**2 * sin(angle)**2 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * cell * damage * lambda * E_down1_down1[i,j] * E_down2_down2[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * cell * damage * mu * E_down1_down1[i,j]**2 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * cell * damage * mu * E_down2_down2[i,j]**2 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1 / 2) * alpha * cell * damage * E_down1_down1[i,j]**2 * cos(angle)**4 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1 / 2) * alpha * cell * damage * E_down2_down2[i,j]**2 * sin(angle)**4 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1 / 2) * cell * damage * lambda * E_down1_down1[i,j]**2 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1 / 2) * cell * damage * lambda * E_down2_down2[i,j]**2 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (1 / 2) * alpha * cell * E_down1_down1[i,j]**2 * cos(angle)**4 + (1 / 2) * alpha * cell * E_down2_down2[i,j]**2 * sin(angle)**4 + (1 / 2) * cell * lambda * E_down1_down1[i,j]**2 + (1 / 2) * cell * lambda * E_down2_down2[i,j]**2 + (1 / 2) * cell * v_up1[i,j]**2 + (1 / 2) * cell * v_up2[i,j]**2 + 2 * alpha * cell * E_down1_down1[i,j] * E_down1_down2[i,j] * cos(angle)**3 * sin(angle) + 2 * alpha * cell * E_down1_down2[i,j] * E_down2_down2[i,j] * sin(angle)**3 * cos(angle) + 2 * alpha * cell * E_down1_down2[i,j]**2 * cos(angle)**2 * sin(angle)**2 + 2 * cell * mu * E_down1_down2[i,j]**2 + alpha * cell * E_down1_down1[i,j] * E_down2_down2[i,j] * cos(angle)**2 * sin(angle)**2 + cell * lambda * E_down1_down1[i,j] * E_down2_down2[i,j] + cell * mu * E_down1_down1[i,j]**2 + cell * mu * E_down2_down2[i,j]**2
  modified[i,j] = energy[i,j]
  signal[i,j] = (400000000000000000 / 28274333882308137) * cell * v_up1[i,j] * exp((-5200) + (-400 / 9) * (dx * i)**2 + (-400 / 9) * (dy * j)**2 + 800 * dx * i + (1600 / 3) * dy * j)
  modeError[i,j] = 0
end function

begin function (v_up1',v_up2',E_down1_down1',E_down2_down2',E_down1_down2',clock',speed',energy',modified',signal',modeError') = step(v_up1,v_up2,E_down1_down1,E_down2_down2,E_down1_down2,clock,speed,energy,modified,signal,modeError)
  double [] :: v_up1', v_up2', E_down1_down1', E_down2_down2', E_down1_down2', clock', speed', energy', modified', signal', modeError'
  S_up1_up1[i,j] = (-2) * alpha * damage * E_down1_down2[i,j] * cos(angle)**3 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) * sin(angle) + (-2) * damage * mu * E_down1_down1[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * alpha * damage * E_down1_down1[i,j] * cos(angle)**4 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * alpha * damage * E_down2_down2[i,j] * cos(angle)**2 * sin(angle)**2 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * damage * lambda * E_down1_down1[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * damage * lambda * E_down2_down2[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + 2 * alpha * E_down1_down2[i,j] * cos(angle)**3 * sin(angle) + 2 * mu * E_down1_down1[i,j] + alpha * E_down1_down1[i,j] * cos(angle)**4 + alpha * E_down2_down2[i,j] * cos(angle)**2 * sin(angle)**2 + lambda * E_down1_down1[i,j] + lambda * E_down2_down2[i,j]
  S_up2_up2[i,j] = (-2) * alpha * damage * E_down1_down2[i,j] * sin(angle)**3 * cos(angle) * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-2) * damage * mu * E_down2_down2[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * alpha * damage * E_down1_down1[i,j] * cos(angle)**2 * sin(angle)**2 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * alpha * damage * E_down2_down2[i,j] * sin(angle)**4 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * damage * lambda * E_down1_down1[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * damage * lambda * E_down2_down2[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + 2 * alpha * E_down1_down2[i,j] * sin(angle)**3 * cos(angle) + 2 * mu * E_down2_down2[i,j] + alpha * E_down1_down1[i,j] * cos(angle)**2 * sin(angle)**2 + alpha * E_down2_down2[i,j] * sin(angle)**4 + lambda * E_down1_down1[i,j] + lambda * E_down2_down2[i,j]
  S_up1_up2[i,j] = (-2) * alpha * damage * E_down1_down2[i,j] * cos(angle)**2 * sin(angle)**2 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-2) * damage * mu * E_down1_down2[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * alpha * damage * E_down1_down1[i,j] * cos(angle)**3 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) * sin(angle) + (-1) * alpha * damage * E_down2_down2[i,j] * sin(angle)**3 * cos(angle) * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + 2 * alpha * E_down1_down2[i,j] * cos(angle)**2 * sin(angle)**2 + 2 * mu * E_down1_down2[i,j] + alpha * E_down1_down1[i,j] * cos(angle)**3 * sin(angle) + alpha * E_down2_down2[i,j] * sin(angle)**3 * cos(angle)
  force_up1[i,j] = ((-1 / 2) * S_up1_up1[i-1,j] + (1 / 2) * S_up1_up1[i+1,j]) / dx + ((-1 / 2) * S_up1_up2[i,j-1] + (1 / 2) * S_up1_up2[i,j+1]) / dy
  force_up2[i,j] = ((-1 / 2) * S_up1_up2[i-1,j] + (1 / 2) * S_up1_up2[i+1,j]) / dx + ((-1 / 2) * S_up2_up2[i,j-1] + (1 / 2) * S_up2_up2[i,j+1]) / dy
  half_up1[i,j] = v_up1[i,j] + (1 / 2) * dt * force_up1[i,j]
  half_up2[i,j] = v_up2[i,j] + (1 / 2) * dt * force_up2[i,j]
  E_down1_down1'[i,j] = E_down1_down1[i,j] + dt * ((-1 / 2) * half_up1[i-1,j] + (1 / 2) * half_up1[i+1,j]) / dx
  E_down2_down2'[i,j] = E_down2_down2[i,j] + dt * ((-1 / 2) * half_up2[i,j-1] + (1 / 2) * half_up2[i,j+1]) / dy
  E_down1_down2'[i,j] = E_down1_down2[i,j] + (1 / 2) * dt * ((-1 / 2) * half_up1[i,j-1] + (1 / 2) * half_up1[i,j+1]) / dy + (1 / 2) * dt * ((-1 / 2) * half_up2[i-1,j] + (1 / 2) * half_up2[i+1,j]) / dx
  nextS_up1_up1[i,j] = (-2) * alpha * damage * E_down1_down2'[i,j] * cos(angle)**3 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) * sin(angle) + (-2) * damage * mu * E_down1_down1'[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * alpha * damage * E_down1_down1'[i,j] * cos(angle)**4 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * alpha * damage * E_down2_down2'[i,j] * cos(angle)**2 * sin(angle)**2 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * damage * lambda * E_down1_down1'[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * damage * lambda * E_down2_down2'[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + 2 * alpha * E_down1_down2'[i,j] * cos(angle)**3 * sin(angle) + 2 * mu * E_down1_down1'[i,j] + alpha * E_down1_down1'[i,j] * cos(angle)**4 + alpha * E_down2_down2'[i,j] * cos(angle)**2 * sin(angle)**2 + lambda * E_down1_down1'[i,j] + lambda * E_down2_down2'[i,j]
  nextS_up2_up2[i,j] = (-2) * alpha * damage * E_down1_down2'[i,j] * sin(angle)**3 * cos(angle) * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-2) * damage * mu * E_down2_down2'[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * alpha * damage * E_down1_down1'[i,j] * cos(angle)**2 * sin(angle)**2 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * alpha * damage * E_down2_down2'[i,j] * sin(angle)**4 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * damage * lambda * E_down1_down1'[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * damage * lambda * E_down2_down2'[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + 2 * alpha * E_down1_down2'[i,j] * sin(angle)**3 * cos(angle) + 2 * mu * E_down2_down2'[i,j] + alpha * E_down1_down1'[i,j] * cos(angle)**2 * sin(angle)**2 + alpha * E_down2_down2'[i,j] * sin(angle)**4 + lambda * E_down1_down1'[i,j] + lambda * E_down2_down2'[i,j]
  nextS_up1_up2[i,j] = (-2) * alpha * damage * E_down1_down2'[i,j] * cos(angle)**2 * sin(angle)**2 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-2) * damage * mu * E_down1_down2'[i,j] * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + (-1) * alpha * damage * E_down1_down1'[i,j] * cos(angle)**3 * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) * sin(angle) + (-1) * alpha * damage * E_down2_down2'[i,j] * sin(angle)**3 * cos(angle) * exp((-2125 / 4) + (-25 / 4) * (dx * i)**2 + (-25 / 4) * (dy * j)**2 + 75 * dy * j + (175 / 2) * dx * i) + 2 * alpha * E_down1_down2'[i,j] * cos(angle)**2 * sin(angle)**2 + 2 * mu * E_down1_down2'[i,j] + alpha * E_down1_down1'[i,j] * cos(angle)**3 * sin(angle) + alpha * E_down2_down2'[i,j] * sin(angle)**3 * cos(angle)
  nextForce_up1[i,j] = ((-1 / 2) * nextS_up1_up1[i-1,j] + (1 / 2) * nextS_up1_up1[i+1,j]) / dx + ((-1 / 2) * nextS_up1_up2[i,j-1] + (1 / 2) * nextS_up1_up2[i,j+1]) / dy
  nextForce_up2[i,j] = ((-1 / 2) * nextS_up1_up2[i-1,j] + (1 / 2) * nextS_up1_up2[i+1,j]) / dx + ((-1 / 2) * nextS_up2_up2[i,j-1] + (1 / 2) * nextS_up2_up2[i,j+1]) / dy
  v_up1'[i,j] = half_up1[i,j] + (1 / 2) * dt * nextForce_up1[i,j]
  v_up2'[i,j] = half_up2[i,j] + (1 / 2) * dt * nextForce_up2[i,j]
  clock'[i,j] = dt + clock[i,j]
  speed'[i,j] = sqrt(v_up1'[i,j]**2 + v_up2'[i,j]**2)
  energy'[i,j] = (1 / 2) * cell * E_down1_down1'[i,j] * nextS_up1_up1[i,j] + (1 / 2) * cell * E_down2_down2'[i,j] * nextS_up2_up2[i,j] + (1 / 2) * cell * v_up1'[i,j]**2 + (1 / 2) * cell * v_up2'[i,j]**2 + cell * E_down1_down2'[i,j] * nextS_up1_up2[i,j]
  modified'[i,j] = energy'[i,j] + (-1 / 8) * cell * dt**2 * nextForce_up1[i,j]**2 + (-1 / 8) * cell * dt**2 * nextForce_up2[i,j]**2
  signal'[i,j] = (400000000000000000 / 28274333882308137) * cell * v_up1'[i,j] * exp((-5200) + (-400 / 9) * (dx * i)**2 + (-400 / 9) * (dy * j)**2 + 800 * dx * i + (1600 / 3) * dy * j)
  modeError'[i,j] = v_up1'[i,j] + (-1) * cos(wave * clock'[i,j] * sqrt(alpha + lambda + 2 * mu)) * sin(dx * i * wave)
end function
