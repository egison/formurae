  uw[i,j,k] = u[i,j,k] + (-1 / 2) * hz * ((-1 / 2) * (u[i,j,k-1] + (1 / 2) * hr * ((-1 / 2) * u[i-1,j,k-1] + (1 / 2) * u[i+1,j,k-1]) / dr + (1 / 4) * (u[i-1,j,k-1] + u[i+1,j,k-1] + (-2) * u[i,j,k-1]) / dr**2 * hr**2) + (1 / 2) * (u[i,j,k+1] + (1 / 2) * hr * ((-1 / 2) * u[i-1,j,k+1] + (1 / 2) * u[i+1,j,k+1]) / dr + (1 / 4) * (u[i-1,j,k+1] + u[i+1,j,k+1] + (-2) * u[i,j,k+1]) / dr**2 * hr**2)) / dz + (1 / 2) * hr * ((-1 / 2) * u[i-1,j,k] + (1 / 2) * u[i+1,j,k]) / dr + (1 / 4) * (u[i-1,j,k] + u[i+1,j,k] + (-2) * u[i,j,k]) / dr**2 * hr**2 + (1 / 4) * (u[i,j,k-1] + u[i,j,k+1] + (-2) * (u[i,j,k] + (1 / 2) * hr * ((-1 / 2) * u[i-1,j,k] + (1 / 2) * u[i+1,j,k]) / dr + (1 / 4) * (u[i-1,j,k] + u[i+1,j,k] + (-2) * u[i,j,k]) / dr**2 * hr**2) + (1 / 2) * hr * ((-1 / 2) * u[i-1,j,k-1] + (1 / 2) * u[i+1,j,k-1]) / dr + (1 / 2) * hr * ((-1 / 2) * u[i-1,j,k+1] + (1 / 2) * u[i+1,j,k+1]) / dr + (1 / 4) * (u[i-1,j,k-1] + u[i+1,j,k-1] + (-2) * u[i,j,k-1]) / dr**2 * hr**2 + (1 / 4) * (u[i-1,j,k+1] + u[i+1,j,k+1] + (-2) * u[i,j,k+1]) / dr**2 * hr**2) / dz**2 * hz**2
