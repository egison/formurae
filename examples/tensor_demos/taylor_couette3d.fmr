dimension :: 3
axes :: r,theta,z

double :: hr = dr
double :: ht = dtheta
double :: hz = dz
double :: inner = 3.0
double :: halo = 2.0

begin function (u,v,w,viscosity,au,av,aw,R) = init()
  double [] :: u, v, w, viscosity, au, av, aw, R
  u[i,j,k] = 0.0
  v[i,j,k] = 0.0
  w[i,j,k] = 0.0
  viscosity[i,j,k] = 0.01
  au[i,j,k] = 0.0
  av[i,j,k] = 0.0
  aw[i,j,k] = 0.0
  R[i,j,k] = inner + (-1) * halo * hr + (1 / 2) * hr + dr * i
end function

begin function (u',v',w',viscosity',au',av',aw',R') = step(u,v,w,viscosity,au,av,aw,R)
  double [] :: u', v', w', viscosity', au', av', aw', R'
  R'[i,j,k] = R[i,j,k]
  F[i,j,k] = R[i,j,k] + (-1 / 2) * hr
  vu[i,j,k] = v[i,j,k] + (-1 / 2) * hr * ((-1 / 2) * (v[i-1,j,k] + (1 / 2) * ht * ((-1 / 2) * v[i-1,j-1,k] + (1 / 2) * v[i-1,j+1,k]) / dtheta + (1 / 4) * (v[i-1,j-1,k] + v[i-1,j+1,k] + (-2) * v[i-1,j,k]) / dtheta**2 * ht**2) + (1 / 2) * (v[i+1,j,k] + (1 / 2) * ht * ((-1 / 2) * v[i+1,j-1,k] + (1 / 2) * v[i+1,j+1,k]) / dtheta + (1 / 4) * (v[i+1,j-1,k] + v[i+1,j+1,k] + (-2) * v[i+1,j,k]) / dtheta**2 * ht**2)) / dr + (1 / 2) * ht * ((-1 / 2) * v[i,j-1,k] + (1 / 2) * v[i,j+1,k]) / dtheta + (1 / 4) * (v[i-1,j,k] + v[i+1,j,k] + (-2) * (v[i,j,k] + (1 / 2) * ht * ((-1 / 2) * v[i,j-1,k] + (1 / 2) * v[i,j+1,k]) / dtheta + (1 / 4) * (v[i,j-1,k] + v[i,j+1,k] + (-2) * v[i,j,k]) / dtheta**2 * ht**2) + (1 / 2) * ht * ((-1 / 2) * v[i-1,j-1,k] + (1 / 2) * v[i-1,j+1,k]) / dtheta + (1 / 2) * ht * ((-1 / 2) * v[i+1,j-1,k] + (1 / 2) * v[i+1,j+1,k]) / dtheta + (1 / 4) * (v[i-1,j-1,k] + v[i-1,j+1,k] + (-2) * v[i-1,j,k]) / dtheta**2 * ht**2 + (1 / 4) * (v[i+1,j-1,k] + v[i+1,j+1,k] + (-2) * v[i+1,j,k]) / dtheta**2 * ht**2) / dr**2 * hr**2 + (1 / 4) * (v[i,j-1,k] + v[i,j+1,k] + (-2) * v[i,j,k]) / dtheta**2 * ht**2
  wu[i,j,k] = w[i,j,k] + (-1 / 2) * hr * ((-1 / 2) * (w[i-1,j,k] + (1 / 2) * hz * ((-1 / 2) * w[i-1,j,k-1] + (1 / 2) * w[i-1,j,k+1]) / dz + (1 / 4) * (w[i-1,j,k-1] + w[i-1,j,k+1] + (-2) * w[i-1,j,k]) / dz**2 * hz**2) + (1 / 2) * (w[i+1,j,k] + (1 / 2) * hz * ((-1 / 2) * w[i+1,j,k-1] + (1 / 2) * w[i+1,j,k+1]) / dz + (1 / 4) * (w[i+1,j,k-1] + w[i+1,j,k+1] + (-2) * w[i+1,j,k]) / dz**2 * hz**2)) / dr + (1 / 2) * hz * ((-1 / 2) * w[i,j,k-1] + (1 / 2) * w[i,j,k+1]) / dz + (1 / 4) * (w[i-1,j,k] + w[i+1,j,k] + (-2) * (w[i,j,k] + (1 / 2) * hz * ((-1 / 2) * w[i,j,k-1] + (1 / 2) * w[i,j,k+1]) / dz + (1 / 4) * (w[i,j,k-1] + w[i,j,k+1] + (-2) * w[i,j,k]) / dz**2 * hz**2) + (1 / 2) * hz * ((-1 / 2) * w[i-1,j,k-1] + (1 / 2) * w[i-1,j,k+1]) / dz + (1 / 2) * hz * ((-1 / 2) * w[i+1,j,k-1] + (1 / 2) * w[i+1,j,k+1]) / dz + (1 / 4) * (w[i-1,j,k-1] + w[i-1,j,k+1] + (-2) * w[i-1,j,k]) / dz**2 * hz**2 + (1 / 4) * (w[i+1,j,k-1] + w[i+1,j,k+1] + (-2) * w[i+1,j,k]) / dz**2 * hz**2) / dr**2 * hr**2 + (1 / 4) * (w[i,j,k-1] + w[i,j,k+1] + (-2) * w[i,j,k]) / dz**2 * hz**2
  uv[i,j,k] = u[i,j,k] + (-1 / 2) * ht * ((-1 / 2) * (u[i,j-1,k] + (1 / 2) * hr * ((-1 / 2) * u[i-1,j-1,k] + (1 / 2) * u[i+1,j-1,k]) / dr + (1 / 4) * (u[i-1,j-1,k] + u[i+1,j-1,k] + (-2) * u[i,j-1,k]) / dr**2 * hr**2) + (1 / 2) * (u[i,j+1,k] + (1 / 2) * hr * ((-1 / 2) * u[i-1,j+1,k] + (1 / 2) * u[i+1,j+1,k]) / dr + (1 / 4) * (u[i-1,j+1,k] + u[i+1,j+1,k] + (-2) * u[i,j+1,k]) / dr**2 * hr**2)) / dtheta + (1 / 2) * hr * ((-1 / 2) * u[i-1,j,k] + (1 / 2) * u[i+1,j,k]) / dr + (1 / 4) * (u[i-1,j,k] + u[i+1,j,k] + (-2) * u[i,j,k]) / dr**2 * hr**2 + (1 / 4) * (u[i,j-1,k] + u[i,j+1,k] + (-2) * (u[i,j,k] + (1 / 2) * hr * ((-1 / 2) * u[i-1,j,k] + (1 / 2) * u[i+1,j,k]) / dr + (1 / 4) * (u[i-1,j,k] + u[i+1,j,k] + (-2) * u[i,j,k]) / dr**2 * hr**2) + (1 / 2) * hr * ((-1 / 2) * u[i-1,j-1,k] + (1 / 2) * u[i+1,j-1,k]) / dr + (1 / 2) * hr * ((-1 / 2) * u[i-1,j+1,k] + (1 / 2) * u[i+1,j+1,k]) / dr + (1 / 4) * (u[i-1,j-1,k] + u[i+1,j-1,k] + (-2) * u[i,j-1,k]) / dr**2 * hr**2 + (1 / 4) * (u[i-1,j+1,k] + u[i+1,j+1,k] + (-2) * u[i,j+1,k]) / dr**2 * hr**2) / dtheta**2 * ht**2
