-- Intrinsic surface Landau-de Gennes relaxation on one Yin-Yang panel.
-- Q is a symmetric contravariant tangent tensor, with g_ij Q^ij = 0.
-- The driver rotates both tensor indices when exchanging panel boundaries.
dimension 2
axes θ, φ
metric g
metric scale [1, sin (π / 6 + θ)]
-- No physical boundary on this sphere: the driver supplies overlapping rims.

param L = 0.02
param A = 1.0
param B = 2.0

-- The connection describes how the coordinate basis changes.
def connection G_a_b = withSymbols [i,j,k,l] ((g~i~l . ((∂/∂ G_l_k coordinates~j) + (∂/∂ G_l_j coordinates~k) - (∂/∂ G_j_k coordinates~l))) / 2)
def tensorGradient Q~a~b C~c_d_e = withSymbols [i,j,k,l] (∂_k Q~i~j + C~i_k_l . Q~l~j + C~j_k_l . Q~i~l)
def gradientDivergence H~a~b_c C~d_e_f = withSymbols [i,j,k,l,m] (g~k~l . (∂_k H~i~j_l + C~i_k_m . H~m~j_l + C~j_k_m . H~i~m_l - C~m_k_l . H~i~j_m))
def traceFree T~a~b = withSymbols [i,j,k,l] (T~i~j - g~i~j * (g_k_l . T~k~l) / 2)
def normSquared Q~a~b = withSymbols [i,j,k,l] (g_i_k . g_j_l . Q~i~j . Q~k~l)

field Q{~i~j} @ collocated
field rhs{~i~j} @ collocated

init:
  Q~i~j = [| [| 0.0, 0.0 |], [| 0.0 |] |]~i~j
  rhs~i~j = [| [| 0.0, 0.0 |], [| 0.0 |] |]~i~j

step:
  let gamma~i_j_k = connection g_i_j
  let covgrad~i~j_k = tensorGradient Q gamma~i_j_k
  local diffusion{~i~j} @ collocated = gradientDivergence covgrad~i~j_k gamma~i_j_k
  local molecular{~i~j} @ collocated = L * diffusion~i~j + (A - B * normSquared Q) * Q~i~j
  rhs'~i~j = traceFree molecular
  Q'~i~j = Q~i~j
