-- Three-dimensional incompressible Newtonian flow in a cylindrical annulus.
-- Physical velocity components occupy the negative faces of pressure cells.
-- The common array index is explicit: u at (r-dr/2,theta,z),
-- v at (r,theta-dtheta/2,z), w at (r,theta,z-dz/2).
-- One-cell averages move each transporting component to the target face.
-- tools/taylor_couette.py supplies no-slip ghosts, integrates these generated
-- accelerations, and solves the compatible finite-volume pressure projection.
dimension 3
axes r, θ, z
param hr = dr
param ht = dθ
param hz = dz
param inner = 3.0
param halo = 2.0

def arp q = q + hr*(∂_r q)/2 + hr^2*(∂^2_r q)/4
def arm q = q - hr*(∂_r q)/2 + hr^2*(∂^2_r q)/4
def atp q = q + ht*(∂_θ q)/2 + ht^2*(∂^2_θ q)/4
def atm q = q - ht*(∂_θ q)/2 + ht^2*(∂^2_θ q)/4
def azp q = q + hz*(∂_z q)/2 + hz^2*(∂^2_z q)/4
def azm q = q - hz*(∂_z q)/2 + hz^2*(∂^2_z q)/4
def lap R q = ∂^2_r q + (∂_r q)/R + (∂^2_θ q)/R^2 + ∂^2_z q

field u
field v
field w
field viscosity
field au
field av
field aw

init:
  u = 0.0
  v = 0.0
  w = 0.0
  viscosity = 0.01
  au = 0.0
  av = 0.0
  aw = 0.0

step:
  local R = inner + r - halo*hr + hr/2
  local F = R - hr/2
  local vu = arm (atp v)
  local wu = arm (azp w)
  local uv = atm (arp u)
  local wv = atm (azp w)
  local uw = azm (arp u)
  local vw = azm (atp v)
  au' = 0 - u*(∂_r u) - vu*(∂_θ u)/F - wu*(∂_z u) + vu^2/F + viscosity*(lap F u - u/F^2 - 2*(∂_θ vu)/F^2)
  av' = 0 - uv*(∂_r v) - v*(∂_θ v)/R - wv*(∂_z v) - uv*v/R + viscosity*(lap R v - v/R^2 + 2*(∂_θ uv)/R^2)
  aw' = 0 - uw*(∂_r w) - vw*(∂_θ w)/R - w*(∂_z w) + viscosity*lap R w
  u' = u
  v' = v
  w' = w
  viscosity' = viscosity
