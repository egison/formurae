def FormuraeInternalDefinition1 x := withSymbols [i, j, k, l, m, n] (Formurae.select (Formurae.predicateLt x 0) (0 - x) x)
def magnitude := FormuraeInternalDefinition1

def FormuraeInternalDefinition2 t := withSymbols [i, j, k, l, m, n] (Formurae.select (Formurae.predicateLe t 12) 1 (Formurae.select (Formurae.predicateGe t 14) 0 ((1 + cos ((π * (t - 12)) / 2)) / 2)))
def drive := FormuraeInternalDefinition2

def FormuraeInternalDefinition3 R T := withSymbols [i, j, k, l, m, n] (perturbation * (8 / 100) * ((sin (π * (R - 1))) ^ 2) * (cos (3 * T) + ((4 / 10) * sin (5 * T))))
def perturbAngle := FormuraeInternalDefinition3

def FormuraeInternalDefinition4 R T := withSymbols [i, j, k, l, m, n] (perturbation * (4 / 1000) * ((R - 1) ^ 2) * ((2 - R) ^ 2) * (cos (3 * T) + ((5 / 10) * sin (5 * T))))
def initialPsi := FormuraeInternalDefinition4

def FormuraeInternalDefinition5 R T := withSymbols [i, j, k, l, m, n] (
  let perturbAngle := FormuraeInternalDefinition3
   in (
    let angle := perturbAngle R T in let co := cos angle in let si := sin angle in let xy := relaxation * (0 - 8) / (3 * R^2) in let yy := 1 + 2 * xy^2 in [| [| co^2 - 2*co*si*xy + si^2*yy, (co*si*(1-yy) + (co^2-si^2)*xy)/R |], [| (co*si*(1-yy) + (co^2-si^2)*xy)/R, (si^2 + 2*co*si*xy + co^2*yy)/R^2 |] |]~i~j
  )
)
def initialC := FormuraeInternalDefinition5

def FormuraeInternalDefinition6 V := withSymbols [i, j, k, l, m, n] (match assert "indexed parameter V~a metadata mismatch in strain" (tensorShape V = [2] && Formurae.logicalTensorVariances V = ["up"]) as bool with | #True -> withSymbols [i, j, k] (((g_i_k . contractWith (+) (FormuraeInternalDiff V~k)..._j) + (g_j_k . contractWith (+) (FormuraeInternalDiff V~k)..._i) + ((∂/∂ g_i_j coordinates~k) . V~k)) / 2))
def strain := FormuraeInternalDefinition6

def FormuraeInternalDefinition7 E := withSymbols [i, j, k, l, m, n] (match assert "indexed parameter E_i_j metadata mismatch in raiseBoth" (tensorShape E = [2,2] && Formurae.logicalTensorVariances E = ["down","down"]) as bool with | #True -> withSymbols [i, j, k, l] (g~i~k . g~j~l . E_k_l))
