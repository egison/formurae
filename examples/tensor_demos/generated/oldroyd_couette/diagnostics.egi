def FormuraeInternalDefinition13 vr vt ar at q := withSymbols [i, j, k, l, m, n] (((0 - (vr * (FormuraeInternalGridWholeDerivative 1 q))) - (vt * (FormuraeInternalGridWholeDerivative 2 q))) + ((ar * hr * (FormuraeInternalCoordinateWideDerivative 1 2 1 q)) / 2) + ((at * ht * (FormuraeInternalCoordinateWideDerivative 2 2 1 q)) / 2))
