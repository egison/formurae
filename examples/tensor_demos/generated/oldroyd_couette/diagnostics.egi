def FormuraeInternalDefinition12 F := withSymbols [i, j, k, l, m, n] (match assert "indexed parameter F~a metadata mismatch in curl" (tensorShape F = [2] && Formurae.logicalTensorVariances F = ["up"]) as bool with | #True -> withSymbols [i, j, k] ((epsilon~i~j . contractWith (+) (FormuraeInternalDiff (g_j_k . F~k))..._i) / volume))
