def FormuraeInternalDefinition14 F T := withSymbols [i, j, k, l, m, n] (match assert "indexed parameter F~a_b metadata mismatch in stretch" (tensorShape F = [2,2] && Formurae.logicalTensorVariances F = ["up","down"]) as bool with | #True -> match assert "indexed parameter T~c~d metadata mismatch in stretch" (tensorShape T = [2,2] && Formurae.logicalTensorVariances T = ["up","up"]) as bool with | #True -> withSymbols [i, j, k, l] (F~i_k . T~k~l . F~j_l))
