def FormuraeInternalDefinition8 S := withSymbols [i, j, k, l, m, n] (match assert "indexed parameter S~a~b metadata mismatch in stressDiv" (tensorShape S = [2,2] && Formurae.logicalTensorVariances S = ["up","up"]) as bool with | #True -> withSymbols [i, j, k, l] (((g~i~k . contractWith (+) (FormuraeInternalDiff (volume * (g_k_l . S~l~j)))..._j) / volume) - ((g~i~k . (∂/∂ g_j_l coordinates~k) . S~j~l) / 2)))
def stressDiv := FormuraeInternalDefinition8

def FormuraeInternalDefinition9 V T := withSymbols [i, j, k, l, m, n] (match assert "indexed parameter V~a metadata mismatch in upperConvectedRHS" (tensorShape V = [2] && Formurae.logicalTensorVariances V = ["up"]) as bool with | #True -> match assert "indexed parameter T~b~c metadata mismatch in upperConvectedRHS" (tensorShape T = [2,2] && Formurae.logicalTensorVariances T = ["up","up"]) as bool with | #True -> withSymbols [i, j, k] (((T~k~j . contractWith (+) (FormuraeInternalDiff V~i)..._k) + (T~i~k . contractWith (+) (FormuraeInternalDiff V~j)..._k)) - (V~k . contractWith (+) (FormuraeInternalDiff T~i~j)..._k)))
def upperConvectedRHS := FormuraeInternalDefinition9

def FormuraeInternalDefinition10 V := withSymbols [i, j, k, l, m, n] (match assert "indexed parameter V~a metadata mismatch in convection" (tensorShape V = [2] && Formurae.logicalTensorVariances V = ["up"]) as bool with | #True -> withSymbols [i, j, k, l] ((V~j . contractWith (+) (FormuraeInternalDiff (g_i_k . V~k))..._j) - (((∂/∂ g_j_k coordinates~i) . V~j . V~k) / 2)))
def convection := FormuraeInternalDefinition10

def FormuraeInternalDefinition11 F := withSymbols [i, j, k, l, m, n] (match assert "indexed parameter F_a metadata mismatch in raiseVector" (tensorShape F = [2] && Formurae.logicalTensorVariances F = ["down"]) as bool with | #True -> withSymbols [i, j] (g~i~j . F_j))
