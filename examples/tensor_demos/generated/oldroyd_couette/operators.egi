def FormuraeInternalValue6~i~j : Tensor MathValue := initialC ((1 + x) - roffset) y
def FormuraeInternalValue7 := initialPsi ((1 + x) - roffset) y
def FormuraeInternalValue8_i_j : Tensor MathValue := strain v
def e_i_j := FormuraeInternalValue8_i_j
def FormuraeInternalValue9~i~j : Tensor MathValue := raiseBoth e_i_j
def raised~i~j := FormuraeInternalValue9~i~j
def FormuraeInternalValue10~i~j : Tensor MathValue := 2 * etas * raised~i~j
def solvent~i~j := FormuraeInternalValue10~i~j
def FormuraeInternalValue11~i : Tensor MathValue := stressDiv solvent~i~j
def FormuraeInternalValue12~i~j : Tensor MathValue := (etap / relaxation) * (C~i~j - g~i~j)
def FormuraeInternalValue13~i : Tensor MathValue := stressDiv totalStress
def FormuraeInternalValue14_i : Tensor MathValue := convection v
def FormuraeInternalValue15~i : Tensor MathValue := raiseVector advected
def FormuraeInternalValue16~i : Tensor MathValue := (divergence~i / rho0) - inertial~i
