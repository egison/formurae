def FormuraeInternalDefinition6 V := withSymbols [i, j, k, l, m, n] (match assert "indexed parameter V~a metadata mismatch in strain" (tensorShape V = [2] && Formurae.logicalTensorVariances V = ["up"]) as bool with | #True -> withSymbols [i, j, k] (((g_i_k . contractWith (+) (FormuraeInternalDiff V~k)..._j) + (g_j_k . contractWith (+) (FormuraeInternalDiff V~k)..._i) + ((∂/∂ g_i_j coordinates~k) . V~k)) / 2))
def strain := FormuraeInternalDefinition6

def FormuraeInternalDefinition7 E := withSymbols [i, j, k, l, m, n] (match assert "indexed parameter E_i_j metadata mismatch in raiseBoth" (tensorShape E = [2,2] && Formurae.logicalTensorVariances E = ["down","down"]) as bool with | #True -> withSymbols [i, j, k, l] (g~i~k . g~j~l . E_k_l))
