def FormuraeInternalValue18~i : Tensor MathValue := force~i + (viscous~i / rho0)
def FormuraeInternalValue19 := curl force
def FormuraeInternalValue20 := torque + ((etas / rho0) * (FormuraeInternalCoordinateWideDerivative 1 2 1 wallOmega + ((FormuraeInternalGridWholeDerivative 1 wallOmega) / ((1 + x) - roffset)) + ((FormuraeInternalCoordinateWideDerivative 2 2 1 wallOmega) / (((1 + x) - roffset) ^ 2))))
def FormuraeInternalValue21~i~j : Tensor MathValue := stretching~i~j - ((C~i~j - g~i~j) / relaxation)
def FormuraeInternalValue22~i~j : Tensor MathValue := tensorMap (upwindScalar v~1 v~2 transportSpeed~1 transportSpeed~2) C
def FormuraeInternalValue23~i_j : Tensor MathValue := contractWith (+) (FormuraeInternalDiff v~i)..._j
def FormuraeInternalValue24~i~j : Tensor MathValue := C~i~j + (timestep * transport'~i~j)
def FormuraeInternalValue25~i_j : Tensor MathValue := FormuraeInternalKroneckerDelta~i_j + (timestep * velocityGradient'~i_j)
