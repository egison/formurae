def FormuraeInternalDefinition5 R T := withSymbols [i, j, k, l, m, n] (
  let perturbAngle := FormuraeInternalDefinition3
   in (
    let angle := perturbAngle R T in let co := cos angle in let si := sin angle in let xy := relaxation * (0 - 8) / (3 * R^2) in let yy := 1 + 2 * xy^2 in [| [| co^2 - 2*co*si*xy + si^2*yy, (co*si*(1-yy) + (co^2-si^2)*xy)/R |], [| (co*si*(1-yy) + (co^2-si^2)*xy)/R, (si^2 + 2*co*si*xy + co^2*yy)/R^2 |] |]~i~j
  )
)
