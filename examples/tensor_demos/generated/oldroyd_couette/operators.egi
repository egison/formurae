def FormuraeInternalDefinition3 R T := withSymbols [i, j, k, l, m, n] (perturbation * (8 / 100) * ((sin (π * (R - 1))) ^ 2) * (cos (3 * T) + ((4 / 10) * sin (5 * T))))
