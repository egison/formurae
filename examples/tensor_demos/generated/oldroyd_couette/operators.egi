def FormuraeInternalDefinition2 t := withSymbols [i, j, k, l, m, n] (Formurae.select (Formurae.predicateLe t 12) 1 (Formurae.select (Formurae.predicateGe t 14) 0 ((1 + cos ((π * (t - 12)) / 2)) / 2)))
