def FormuraeInternalDefinition4 R T := withSymbols [i, j, k, l, m, n] (perturbation * (4 / 1000) * ((R - 1) ^ 2) * ((2 - R) ^ 2) * (cos (3 * T) + ((5 / 10) * sin (5 * T))))
