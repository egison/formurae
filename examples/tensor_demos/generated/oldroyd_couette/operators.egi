def FormuraeInternalDefinition8 S := withSymbols [i, j, k, l, m, n] (match assert "indexed parameter S~a~b metadata mismatch in stressDiv" (tensorShape S = [2,2] && Formurae.logicalTensorVariances S = ["up","up"]) as bool with | #True -> withSymbols [i, j, k, l] (((g~i~k . contractWith (+) (FormuraeInternalDiff (volume * (g_k_l . S~l~j)))..._j) / volume) - ((g~i~k . (∂/∂ g_j_l coordinates~k) . S~j~l) / 2)))
