  molecular_up1_up1[i,j] = (-2) * B * Q_up1_up1[i,j] * Q_up1_up2[i,j]**2 * sin((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i)**2 + (-1) * B * Q_up1_up1[i,j] * Q_up2_up2[i,j]**2 * sin((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i)**4 + (-1) * B * Q_up1_up1[i,j]**3 + A * Q_up1_up1[i,j] + L * diffusion_up1_up1[i,j]
  molecular_up2_up2[i,j] = (-2) * B * Q_up2_up2[i,j] * Q_up1_up2[i,j]**2 * sin((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i)**2 + (-1) * B * Q_up2_up2[i,j] * Q_up1_up1[i,j]**2 + (-1) * B * Q_up2_up2[i,j]**3 * sin((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i)**4 + A * Q_up2_up2[i,j] + L * diffusion_up2_up2[i,j]
  molecular_up1_up2[i,j] = (-2) * B * Q_up1_up2[i,j]**3 * sin((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i)**2 + (-1) * B * Q_up1_up2[i,j] * Q_up1_up1[i,j]**2 + (-1) * B * Q_up1_up2[i,j] * Q_up2_up2[i,j]**2 * sin((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i)**4 + A * Q_up1_up2[i,j] + L * diffusion_up1_up2[i,j]
