  diffusion_up1_up1[i,j] = (-2) * Q_up1_up1[i,j] * cos((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i)**2 * sin((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i)**(-2) + (-2) * ((-1 / 2) * Q_up1_up2[i,j-1] + (1 / 2) * Q_up1_up2[i,j+1]) / dphi * sin((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i)**(-1) * cos((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i) + 2 * Q_up2_up2[i,j] * cos((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i)**2 + ((-1 / 2) * Q_up1_up1[i-1,j] + (1 / 2) * Q_up1_up1[i+1,j]) / dtheta * sin((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i)**(-1) * cos((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i) + ((-1 / 2) * ((-2) * Q_up1_up2[i,j-1] * cos((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i) * sin((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i) + ((-1 / 2) * Q_up1_up1[i,j-2] + (1 / 2) * Q_up1_up1[i,j]) / dphi) + (1 / 2) * ((-2) * Q_up1_up2[i,j+1] * cos((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i) * sin((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i) + ((-1 / 2) * Q_up1_up1[i,j] + (1 / 2) * Q_up1_up1[i,j+2]) / dphi)) / dphi * sin((1 / 6) * (884279719003555 / 281474976710656) + dtheta * i)**(-2) + ((-1 / 2) * ((-1 / 2) * Q_up1_up1[i-2,j] + (1 / 2) * Q_up1_up1[i,j]) / dtheta + (1 / 2) * ((-1 / 2) * Q_up1_up1[i,j] + (1 / 2) * Q_up1_up1[i+2,j]) / dtheta) / dtheta
