begin function (Q_up1_up1',Q_up2_up2',Q_up1_up2',rhs_up1_up1',rhs_up2_up2',rhs_up1_up2') = step(Q_up1_up1,Q_up2_up2,Q_up1_up2,rhs_up1_up1,rhs_up2_up2,rhs_up1_up2)
