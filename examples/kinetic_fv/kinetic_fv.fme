-- Collisionless D2Q9 finite-volume transport on mapped quadrilateral cells.
-- X=x+warpX*sin(x)*sin(y), Y=y+warpY*sin(x)*sin(y).
-- scenario 0: uniform, 1: smooth, 2: sharp/vacuum.
-- method 0: upwind/Euler, 1: centered/Euler, 2: MC/SSPRK2, 3: upwind/SSPRK2.
dimension 2
axes x, y
index a : 9
param warpX = 0.2
param warpY = 0.15
param scenario = 1
param method = 2
param gauss = 0.5773502691896258
param hx = dx
param hy = dy
param dt = 0.2*hx*hy/(hx+hy)
param cell = hx*hy
param domainArea = 39.47841760435743
extern sin
extern cos
extern fvConfig

def mapX u v = u+warpX*sin(u)*sin(v)
def mapY u v = v+warpY*sin(u)*sin(v)
def weights = [| 4/9,1/9,1/9,1/9,1/9,1/36,1/36,1/36,1/36 |]
def ex = [| 0,1,-1,0,0,1,-1,1,-1 |]
def ey = [| 0,0,0,1,-1,1,-1,-1,1 |]
def ones = [| 1,1,1,1,1,1,1,1,1 |]
def smaller p q = if p < q then p else q
def bigger p q = if p > q then p else q
def maxPopulation T_a = bigger (bigger (bigger (T_1) (T_2)) (bigger (T_3) (T_4))) (bigger (bigger (T_5) (T_6)) (bigger (T_7) (bigger (T_8) (T_9))))
def minPopulation T_a = 0-maxPopulation (0-T_a)
def absval v = if v >= 0 then v else 0-v
def positive v = (v+absval(v))/2
-- Monotonized-central (MC) slope: no sign change, at most twice either difference.
def minmod p q = if p*q <= 0 then 0 else if p > 0 then smaller p q else 0-smaller (0-p) (0-q)
def mcSlope back forward = minmod ((back+forward)/2) (2*minmod back forward)
def reconstructSlope = if method > 1.5 && method < 2.5 then 1 else 0
def dissipate = if method > 0.5 && method < 1.5 then 0 else 1
-- Shoelace area of the mapped four-corner polygon divided by hx*hy.
-- This simplified expression is algebraically equal to that polygon area.
def areaDensity = 1+warpX*(2*sin(hx/2)/hx)*cos(hy/2)*cos(x)*sin(y)+warpY*(2*sin(hy/2)/hy)*cos(hx/2)*sin(x)*cos(y)
static field volumeCell := areaDensity
-- Oriented edge normals divided by computational edge length, from endpoints.
def faceX cx cy = ((mapY x (y+hy/2)-mapY x (y-hy/2))*cx-(mapX x (y+hy/2)-mapX x (y-hy/2))*cy)/hy
def faceY cx cy = ((mapX (x+hx/2) y-mapX (x-hx/2) y)*cy-(mapY (x+hx/2) y-mapY (x-hx/2) y)*cx)/hx
def speeds = generateTensor (\[k,q] -> if k = 1 then faceX ex_q ey_q else faceY ex_q ey_q) [2,9]
static field B~i_a @ primal := (speeds)~i_a
-- Bilinear map of the four physical cell corners, in reference coordinates
-- xi,eta in [-1,1]. Its Jacobian integrates exactly to the polygon area.
def mapMean = sin(x)*cos(hx/2)*sin(y)*cos(hy/2)
def mapXi = cos(x)*sin(hx/2)*sin(y)*cos(hy/2)
def mapEta = sin(x)*cos(hx/2)*cos(y)*sin(hy/2)
def mapXiEta = cos(x)*sin(hx/2)*cos(y)*sin(hy/2)
def quadPhase xi eta = x+2*y+hx*xi/2+hy*eta+(warpX+2*warpY)*(mapMean+mapXi*xi+mapEta*eta+mapXiEta*xi*eta)
def quadJacobian xi eta = cell/4+warpX*hy*(mapXi+mapXiEta*eta)/2+warpY*hx*(mapEta+mapXiEta*xi)/2
def cellAverage fn = (quadJacobian gauss gauss*fn(quadPhase gauss gauss)+quadJacobian (0-gauss) gauss*fn(quadPhase (0-gauss) gauss)+quadJacobian gauss (0-gauss)*fn(quadPhase gauss (0-gauss))+quadJacobian (0-gauss) (0-gauss)*fn(quadPhase (0-gauss) (0-gauss)))/(cell*areaDensity)
-- Four-point Gaussian quadrature; positive weights and fourth-order accuracy.
static field meanCos := cellAverage cos
static field meanSin := cellAverage sin
-- Only the smooth case has an error against an advected reference solution.
def initialProfile = if scenario < 0.5 then 1 else if scenario < 1.5 then 1+0.2*meanCos else if cos(mapX x y+2*mapY x y) > 0 then 1 else 0
def referenceAt cx cy t = if scenario < 0.5 then 1 else 1+0.2*(meanCos*cos((cx+2*cy)*t)+meanSin*sin((cx+2*cy)*t))
def reference t = generateTensor (\[q] -> weights_q*referenceAt ex_q ey_q t) [9]

-- Numerical transport: source-cell selection is explicit; all charts use it.
macro transport Q =
  local lower~i_a @ primal = [| sampleLower(Q,1,0), sampleLower(Q,0,1) |]~i_a
  local upper~i_a @ primal = [| sampleUpper(Q,1,0), sampleUpper(Q,0,1) |]~i_a
  local jump~i_a @ primal = upper~i_a-lower~i_a
  local backwardX_a = sampleLower(jump~1_a,0,0)
  local forwardX_a = sampleUpper(jump~1_a,0,0)
  local backwardY_a = sampleLower(jump~2_a,0,0)
  local forwardY_a = sampleUpper(jump~2_a,0,0)
  local slopeX_a = reconstructSlope*mcSlope backwardX_a forwardX_a
  local slopeY_a = reconstructSlope*mcSlope backwardY_a forwardY_a
  local left~i_a @ primal = lower~i_a+[| sampleLower(slopeX,1,0), sampleLower(slopeY,0,1) |]~i_a/2
  local right~i_a @ primal = upper~i_a-[| sampleUpper(slopeX,1,0), sampleUpper(slopeY,0,1) |]~i_a/2
  local flux~i_a @ primal = (B~i_a*(left~i_a+right~i_a)-dissipate*absval(B~i_a)*(right~i_a-left~i_a))/2
  in (0-∂_i flux~i_a)/volumeCell

field f_a
field original_a
field stage
field elapsed
field mass_a
field error
field errorL1
field mixing
field lowest
field highest
field cfl
field closure
field minArea
init:
  f_a := weights_a*initialProfile
  original_a := weights_a*initialProfile
  stage := 0
  elapsed := 0
  mass_a := cell*volumeCell*weights_a*initialProfile/domainArea
  error := 0
  errorL1 := 0
  mixing := cell*volumeCell*initialProfile*(1-initialProfile)/domainArea
  lowest := initialProfile
  highest := initialProfile
  cfl := 0
  closure := 0
  minArea := cell*volumeCell
step:
  local rate_a = transport f
  local euler_a = f_a+dt*rate_a
  original'_a = if stage < 0.5 then f_a else original_a
  f'_a = if method > 1.5 && stage > 0.5 then (original_a+euler_a)/2 else euler_a
  elapsed' = if method > 1.5 && stage < 0.5 then elapsed else elapsed+dt
  stage' = if method > 1.5 && stage < 0.5 then 1 else 0
  mass'_a = cell*volumeCell*f'_a/domainArea
  local populationError_a = absval(f'_a/weights_a-(reference elapsed')_a/weights_a)
  error' = if scenario > 1.5 then 0 else if method > 1.5 && stage < 0.5 then error else maxPopulation populationError
  errorL1' = if scenario > 1.5 then 0 else if method > 1.5 && stage < 0.5 then errorL1 else cell*volumeCell*(ones~a . populationError_a)/(9*domainArea)
  local relative_a = f'_a/weights_a
  -- Inspect both Euler candidates as well as the stored RK stages.
  local relativeEuler_a = euler_a/weights_a
  local low = smaller (minPopulation relative) (minPopulation relativeEuler)
  local high = bigger (maxPopulation relative) (maxPopulation relativeEuler)
  local mixed_a = relative_a*(1-relative_a)
  mixing' = cell*volumeCell*(ones~a . mixed_a)/(9*domainArea)
  lowest' = if low < lowest then low else lowest
  highest' = if high > highest then high else highest
  local outgoingX_a = positive(sampleUpper(B~1_a,0,0))+positive(0-sampleLower(B~1_a,0,0))
  local outgoingY_a = positive(sampleUpper(B~2_a,0,0))+positive(0-sampleLower(B~2_a,0,0))
  cfl' = maxPopulation (dt*(outgoingX_a/hx+outgoingY_a/hy)/volumeCell)
  local divergence_a = ∂_i B~i_a
  closure' = maxPopulation (absval divergence)
  minArea' = cell*volumeCell
