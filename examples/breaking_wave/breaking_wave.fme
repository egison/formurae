-- Two-dimensional free-surface lattice Boltzmann water tank (D2Q9).
-- All initial conditions, collision, streaming, surface conversion, mass
-- redistribution, wall handling and diagnostic fields are evaluated here.
-- type: 0 = air, 1 = interface, 2 = liquid, 3 = solid.
-- Air pressure is fixed; air inertia and surface tension are omitted.
-- The bed is a staircase on this fixed lattice; no moving geometry is used.
-- See README.md for the algorithm, units and validation limits.
dimension 2
axes x, y
index a : 9
param nx = 384
param ny = 96
param depth = 36
param amplitude = 26.25
param center = 53
param width = 18
param beachStart = 90
param beachSlope = 0.2
param gravity = 0.00013333333333333334
param tau = 0.59
param launch = 2.5
param threshold = 0.001
param lonelyThreshold = 0.1
param gaugeX = 225
param hx = dx
param hy = dy

-- The population index has nine components; spatial indices have two.
def weights = [| 4/9,1/9,1/9,1/9,1/9,1/36,1/36,1/36,1/36 |]
def cx = [| 0,1,-1,0,0,1,-1,1,-1 |]
def cy = [| 0,0,0,1,-1,1,-1,-1,1 |]
def ones =
  generateTensor (\[q] -> 1) [9]
def directions =
  generateTensor (\[q,component] -> if component = 1 then cx_q else cy_q) [9,2]

-- Exact one-cell shifts from the existing centered differences, as in lbm_d3q19.
def sx c q = q + c*hx*∂_x q + hx^2*∂^2_x q/2
def sy c q = q + c*hy*∂_y q + hy^2*∂^2_y q/2
macro diagonal cx cy q =
  local intermediate = sx cx q
  in sy cy intermediate

def equilibrium w cx cy r u v = w*r*(1 + 3*(cx*u + cy*v) + (9/2)*(cx*u + cy*v)^2 - (3/2)*(u^2 + v^2))
def forcing w cx cy r u v = (1 - 1/(2*tau))*w*r*(0 - gravity)*(3*(cy-v) + 9*(cx*u+cy*v)*cy)
-- Generate all nine components at normalization time, using the same tables.
def equilibriumPopulations r u v =
  generateTensor (\[q] -> equilibrium weights_q cx_q cy_q r u v) [9]
def forcePopulations r u v =
  generateTensor (\[q] -> forcing weights_q cx_q cy_q r u v) [9]
def reconstruct neighbor incoming opposite forwardEq backwardEq = if neighbor > 2.5 then opposite else if neighbor < 0.5 then forwardEq + backwardEq - opposite else incoming
def streamPopulations neighbors_a incoming_a opposite_a u v =
  generateTensor
    (\[q] -> if q = 1 then incoming_q else
      reconstruct neighbors_q incoming_q opposite_q
        (equilibrium weights_q cx_q cy_q 1 u v)
        (equilibrium weights_q (0-cx_q) (0-cy_q) 1 u v))
    [9]

-- Antisymmetric interface exchange; unequal classes transfer in one direction.
def surfaceExchange here there incoming outgoing = if here < there then 0-outgoing else if here > there then incoming else incoming-outgoing

def bounded q = if q < 0 then 0 else if q > 1 then 1 else q
-- Keep a field-valued branch: Formura infers a scalar for two constant branches,
-- so shifting that local would not shift its predicate. Kinds are exactly 0/1/2/3.
def liquid q = if q > 1.5 && q < 2.5 then q/2 else 0
def interface q = if q > 0.5 && q < 1.5 then q else 0
def gas q = if q < 0.5 then 1-q else 0
def active q = if q > 0.5 && q < 2.5 then (if q < 1.5 then q else q/2) else 0

def bed = if x > beachStart then 2 + beachSlope*(x - beachStart) else 2
def elevation = amplitude / cosh((x-center)/width)^2
def height = depth + elevation
def fill = bounded (height - y + 0.5)
def initialType = if x < 2 || x > nx-3 || y < bed || y > ny-3 then 3 else if y < height-1.5 then 2 else if y < height+1.5 then 1 else 0
def initialDensity = if y < height then 1 + 3*gravity*(height-y) else 1
def initialU = if active initialType > 0.5 then launch*sqrt(gravity*(depth+amplitude))*elevation/height else 0

static field wall : scalar := if initialType > 2.5 then 1 else 0
field kind : scalar
field mass : scalar
field bank : scalar
field water : scalar
field fraction : scalar
field speed : scalar
field density : scalar
field overhang : scalar
field bad : scalar
field velocityX : scalar
field velocityY : scalar
field shoreFlux : scalar
field wetFront : scalar
field bankMagnitude : scalar
field rawFraction : scalar
field bulkFront : scalar

field f_a

field savedG_a
field savedS_a
field savedNr : scalar
field savedTransported : scalar
field savedProposal : scalar
field savedNextKind : scalar
field savedBaseMass : scalar
field savedExcess : scalar
field savedAverageRho : scalar
field savedAverage_i
field stage : scalar

init:
  kind := initialType
  mass := if active initialType > 0.5 then fill*initialDensity else 0
  bank := 0
  water := if active initialType > 0.5 then fill*initialDensity else 0
  fraction := if active initialType > 0.5 then fill else 0
  density := if active initialType > 0.5 then initialDensity else 1
  speed := initialU
  overhang := 0
  bad := 0
  velocityX := initialU
  velocityY := 0
  shoreFlux := if x > gaugeX-0.5 && x < gaugeX+0.5 && active initialType > 0.5 then fill*initialDensity*initialU else 0
  wetFront := if active initialType > 0.5 && fill > 0.5 && y-1 < bed then x else 0
  bankMagnitude := 0
  rawFraction := if active initialType > 0.5 then fill else 0
  bulkFront := if active initialType > 0.5 && y+1 < height && y-1 < bed then x else 0
  f_a := (equilibriumPopulations initialDensity initialU 0)_a

  savedG_a := 0*ones_a
  savedS_a := 0*ones_a
  savedNr := 1
  savedTransported := 0
  savedProposal := 0
  savedNextKind := 0
  savedBaseMass := 0
  savedExcess := 0
  savedAverageRho := 1
  savedAverage_i := [| 0,0 |]_i
  stage := 0

step:

  -- Stage 0: collision and body force.
  local rho = ones~a . f_a
  local u_i = (directions~a_i . f_a)/rho - [| 0,gravity/2 |]_i
  local eps = bounded (mass/rho)
  -- f, mass and kind stay unchanged until stage 3: recompute rho, u and eps.
  local g_a = f_a + ((equilibriumPopulations rho u_1 u_2)_a - f_a)/tau + (forcePopulations rho u_1 u_2)_a
  savedG'_a = if stage < 0.5 && stage > -0.5 then g_a else savedG_a

  -- Stage 1: streaming, mass flux and proposed cell types.
  local k1 = sx (-1) kind
  local e1 = sx (-1) eps
  local incoming1 = sx (-1) savedG_2
  local k2 = sx (1) kind
  local e2 = sx (1) eps
  local incoming2 = sx (1) savedG_3
  local k3 = sy (-1) kind
  local e3 = sy (-1) eps
  local incoming3 = sy (-1) savedG_4
  local k4 = sy (1) kind
  local e4 = sy (1) eps
  local incoming4 = sy (1) savedG_5
  local k5 = diagonal (-1) (-1) kind
  local e5 = diagonal (-1) (-1) eps
  local incoming5 = diagonal (-1) (-1) savedG_6
  local k6 = diagonal (1) (1) kind
  local e6 = diagonal (1) (1) eps
  local incoming6 = diagonal (1) (1) savedG_7
  local k7 = diagonal (-1) (1) kind
  local e7 = diagonal (-1) (1) eps
  local incoming7 = diagonal (-1) (1) savedG_8
  local k8 = diagonal (1) (-1) kind
  local e8 = diagonal (1) (-1) eps
  local incoming8 = diagonal (1) (-1) savedG_9
  local s_a = (streamPopulations
    [| kind,k1,k2,k3,k4,k5,k6,k7,k8 |]
    [| savedG_1,incoming1,incoming2,incoming3,incoming4,incoming5,incoming6,incoming7,incoming8 |]
    [| savedG_1,savedG_3,savedG_2,savedG_5,savedG_4,savedG_7,savedG_6,savedG_9,savedG_8 |]
    u_1 u_2)_a
  -- Thuerey (2007), section 4.4: drain interfaces without liquid
  -- neighbours and fill those without gas neighbours using pairwise fluxes.
  local fluidNeighbors = liquid k1 + liquid k2 + liquid k3 + liquid k4 + liquid k5 + liquid k6 + liquid k7 + liquid k8
  local airNeighbors = gas k1 + gas k2 + gas k3 + gas k4 + gas k5 + gas k6 + gas k7 + gas k8
  local surfaceClass = if fluidNeighbors < 0.5 && airNeighbors > 0.5 then 0-kind else if airNeighbors < 0.5 && fluidNeighbors > 0.5 then kind else 0
  local class1 = sx (-1) surfaceClass
  local class2 = sx (1) surfaceClass
  local class3 = sy (-1) surfaceClass
  local class4 = sy (1) surfaceClass
  local class5 = diagonal (-1) (-1) surfaceClass
  local class6 = diagonal (1) (1) surfaceClass
  local class7 = diagonal (-1) (1) surfaceClass
  local class8 = diagonal (1) (-1) surfaceClass
  local dm1 = if active kind < 0.5 || active k1 < 0.5 then 0 else if liquid kind > 0.5 || liquid k1 > 0.5 then incoming1 - savedG_3 else (eps + e1)*(surfaceExchange surfaceClass class1 incoming1 savedG_3)/2
  local dm2 = if active kind < 0.5 || active k2 < 0.5 then 0 else if liquid kind > 0.5 || liquid k2 > 0.5 then incoming2 - savedG_2 else (eps + e2)*(surfaceExchange surfaceClass class2 incoming2 savedG_2)/2
  local dm3 = if active kind < 0.5 || active k3 < 0.5 then 0 else if liquid kind > 0.5 || liquid k3 > 0.5 then incoming3 - savedG_5 else (eps + e3)*(surfaceExchange surfaceClass class3 incoming3 savedG_5)/2
  local dm4 = if active kind < 0.5 || active k4 < 0.5 then 0 else if liquid kind > 0.5 || liquid k4 > 0.5 then incoming4 - savedG_4 else (eps + e4)*(surfaceExchange surfaceClass class4 incoming4 savedG_4)/2
  local dm5 = if active kind < 0.5 || active k5 < 0.5 then 0 else if liquid kind > 0.5 || liquid k5 > 0.5 then incoming5 - savedG_7 else (eps + e5)*(surfaceExchange surfaceClass class5 incoming5 savedG_7)/2
  local dm6 = if active kind < 0.5 || active k6 < 0.5 then 0 else if liquid kind > 0.5 || liquid k6 > 0.5 then incoming6 - savedG_6 else (eps + e6)*(surfaceExchange surfaceClass class6 incoming6 savedG_6)/2
  local dm7 = if active kind < 0.5 || active k7 < 0.5 then 0 else if liquid kind > 0.5 || liquid k7 > 0.5 then incoming7 - savedG_9 else (eps + e7)*(surfaceExchange surfaceClass class7 incoming7 savedG_9)/2
  local dm8 = if active kind < 0.5 || active k8 < 0.5 then 0 else if liquid kind > 0.5 || liquid k8 > 0.5 then incoming8 - savedG_8 else (eps + e8)*(surfaceExchange surfaceClass class8 incoming8 savedG_8)/2
  local nr = ones~a . s_a
  local transported = mass + dm1 + dm2 + dm3 + dm4 + dm5 + dm6 + dm7 + dm8
  local proposal = if interface kind > 0.5 then (if transported > (1+threshold)*nr || (airNeighbors < 0.5 && transported > (1-lonelyThreshold)*nr) then 2 else if transported < (0-threshold)*nr || (fluidNeighbors < 0.5 && transported < lonelyThreshold*nr) then 0 else 1) else kind
  savedS'_a = if stage < 1.5 && stage > 0.5 then s_a else savedS_a
  savedNr' = if stage < 1.5 && stage > 0.5 then nr else savedNr
  savedTransported' = if stage < 1.5 && stage > 0.5 then transported else savedTransported
  savedProposal' = if stage < 1.5 && stage > 0.5 then proposal else savedProposal

  -- Stage 2: consistent surface types and new-cell initial states.
  local proposedLiquid = if interface kind > 0.5 then liquid savedProposal else 0
  local proposedGas = if interface kind > 0.5 then gas savedProposal else 0
  local pl1 = sx (-1) proposedLiquid
  local pl2 = sx (1) proposedLiquid
  local pl3 = sy (-1) proposedLiquid
  local pl4 = sy (1) proposedLiquid
  local pl5 = diagonal (-1) (-1) proposedLiquid
  local pl6 = diagonal (1) (1) proposedLiquid
  local pl7 = diagonal (-1) (1) proposedLiquid
  local pl8 = diagonal (1) (-1) proposedLiquid
  local nearLiquid = pl1 + pl2 + pl3 + pl4 + pl5 + pl6 + pl7 + pl8
  -- Filling has priority: cancel adjacent empty flags before changing old liquid.
  local permittedGas = if nearLiquid > 0.5 then 0 else proposedGas
  local pg1 = sx (-1) permittedGas
  local pg2 = sx (1) permittedGas
  local pg3 = sy (-1) permittedGas
  local pg4 = sy (1) permittedGas
  local pg5 = diagonal (-1) (-1) permittedGas
  local pg6 = diagonal (1) (1) permittedGas
  local pg7 = diagonal (-1) (1) permittedGas
  local pg8 = diagonal (1) (-1) permittedGas
  local nearGas = pg1 + pg2 + pg3 + pg4 + pg5 + pg6 + pg7 + pg8
  -- A newly filled interface remains liquid and creates an outer interface.
  -- Only old liquid next to a newly emptied interface becomes interface.
  local nextKind = if wall > 0.5 then 3 else if kind < 0.5 then (if nearLiquid > 0.5 then 1 else 0) else if kind > 1.5 then (if nearGas > 0.5 then 1 else 2) else if savedProposal < 0.5 && nearLiquid > 0.5 then 1 else savedProposal
  local baseMass = if liquid nextKind > 0.5 then savedNr else if interface nextKind > 0.5 then savedTransported else 0
  local excess = savedTransported - baseMass + bank
  local act = active kind
  local arho = act*rho
  local ax = act*u_1
  local ay = act*u_2
  local act1 = sx (-1) act
  local ar1 = sx (-1) arho
  local ax1 = sx (-1) ax
  local ay1 = sx (-1) ay
  local act2 = sx (1) act
  local ar2 = sx (1) arho
  local ax2 = sx (1) ax
  local ay2 = sx (1) ay
  local act3 = sy (-1) act
  local ar3 = sy (-1) arho
  local ax3 = sy (-1) ax
  local ay3 = sy (-1) ay
  local act4 = sy (1) act
  local ar4 = sy (1) arho
  local ax4 = sy (1) ax
  local ay4 = sy (1) ay
  local act5 = diagonal (-1) (-1) act
  local ar5 = diagonal (-1) (-1) arho
  local ax5 = diagonal (-1) (-1) ax
  local ay5 = diagonal (-1) (-1) ay
  local act6 = diagonal (1) (1) act
  local ar6 = diagonal (1) (1) arho
  local ax6 = diagonal (1) (1) ax
  local ay6 = diagonal (1) (1) ay
  local act7 = diagonal (-1) (1) act
  local ar7 = diagonal (-1) (1) arho
  local ax7 = diagonal (-1) (1) ax
  local ay7 = diagonal (-1) (1) ay
  local act8 = diagonal (1) (-1) act
  local ar8 = diagonal (1) (-1) arho
  local ax8 = diagonal (1) (-1) ax
  local ay8 = diagonal (1) (-1) ay
  local neighbors = act1 + act2 + act3 + act4 + act5 + act6 + act7 + act8
  local neighborCount = if neighbors > 0.5 then neighbors else 1
  local averageRho = if neighbors > 0.5 then (ar1 + ar2 + ar3 + ar4 + ar5 + ar6 + ar7 + ar8)/neighborCount else 1
  local average_i = [|
    (ax1 + ax2 + ax3 + ax4 + ax5 + ax6 + ax7 + ax8)/neighborCount,
    (ay1 + ay2 + ay3 + ay4 + ay5 + ay6 + ay7 + ay8)/neighborCount |]_i
  savedNextKind' = if stage < 2.5 && stage > 1.5 then nextKind else savedNextKind
  savedBaseMass' = if stage < 2.5 && stage > 1.5 then baseMass else savedBaseMass
  savedExcess' = if stage < 2.5 && stage > 1.5 then excess else savedExcess
  savedAverageRho' = if stage < 2.5 && stage > 1.5 then averageRho else savedAverageRho
  savedAverage'_i = if stage < 2.5 && stage > 1.5 then average_i else savedAverage_i

  -- Stage 3: conservative redistribution and the physical state update.
  local receiver = interface savedNextKind
  local rec1 = sx (-1) receiver
  local rec2 = sx (1) receiver
  local rec3 = sy (-1) receiver
  local rec4 = sy (1) receiver
  local rec5 = diagonal (-1) (-1) receiver
  local rec6 = diagonal (1) (1) receiver
  local rec7 = diagonal (-1) (1) receiver
  local rec8 = diagonal (1) (-1) receiver
  local receiverCount = receiver + rec1 + rec2 + rec3 + rec4 + rec5 + rec6 + rec7 + rec8
  local share = if receiverCount > 0.5 then savedExcess/receiverCount else 0
  local share1 = sx (-1) share
  local share2 = sx (1) share
  local share3 = sy (-1) share
  local share4 = sy (1) share
  local share5 = diagonal (-1) (-1) share
  local share6 = diagonal (1) (1) share
  local share7 = diagonal (-1) (1) share
  local share8 = diagonal (1) (-1) share
  local nextMass = savedBaseMass + receiver*(share + share1 + share2 + share3 + share4 + share5 + share6 + share7 + share8)
  local nextBank = if receiverCount > 0.5 then 0 else savedExcess
  kind' = if stage > 2.5 && stage < 3.5 then savedNextKind else kind
  mass' = if stage > 2.5 && stage < 3.5 then nextMass else mass
  bank' = if stage > 2.5 && stage < 3.5 then nextBank else bank
  water' = if stage > 2.5 && stage < 3.5 then nextMass + nextBank else water
  f'_a = if stage > 2.5 && stage < 3.5 then (
    if active savedNextKind < 0.5 then weights_a
    else if kind < 0.5 then (equilibriumPopulations savedAverageRho savedAverage_1 savedAverage_2)_a
    else savedS_a) else f_a

  -- Stage 4: diagnostics read only the completed state.
  local newRho = ones~a . f_a
  local newU_i = (directions~a_i . f_a)/newRho - [| 0,gravity/2 |]_i
  local newFraction = if active kind > 0.5 then bounded (mass/newRho) else 0
  local above = sy (1) newFraction
  local below = sy (-1) newFraction
  local belowWall = sy (-1) wall
  fraction' = if stage > 3.5 then newFraction else fraction
  density' = if stage > 3.5 then (if active kind > 0.5 then newRho else 1) else density
  speed' = if stage > 3.5 then (if active kind > 0.5 then sqrt(newU_1^2 + newU_2^2) else 0) else speed
  overhang' = if stage > 3.5 then (if newFraction > 0.5 && below < 0.5 && belowWall < 0.5 then 1 else 0) else overhang
  bad' = if stage > 3.5 then (if newRho > 0.5 && newRho < 1.5 && newU_1^2 + newU_2^2 < 0.09 then (if active kind > 0.5 && (mass < (0-0.5)*newRho || mass > 1.5*newRho) then 1 else 0) else 1) else bad
  -- Signed discharge through one vertical column: negative means offshore.
  velocityX' = if stage > 3.5 then (if active kind > 0.5 then newU_1 else 0) else velocityX
  velocityY' = if stage > 3.5 then (if active kind > 0.5 then newU_2 else 0) else velocityY
  shoreFlux' = if stage > 3.5 then (if x > gaugeX-0.5 && x < gaugeX+0.5 && active kind > 0.5 then mass*newU_1 else 0) else shoreFlux
  -- Furthest wet point directly above the solid seabed (not an airborne drop).
  wetFront' = if stage > 3.5 then (if newFraction > 0.5 && belowWall > 0.5 then x else 0) else wetFront
  rawFraction' = if stage > 3.5 then (if active kind > 0.5 then mass/newRho else 0) else rawFraction
  bulkFront' = if stage > 3.5 then (if newFraction > 0.5 && above > 0.5 && belowWall > 0.5 then x else 0) else bulkFront
  bankMagnitude' = if stage > 3.5 then (if bank < 0 then 0-bank else bank) else bankMagnitude
  stage' = if stage > 3.5 then 0 else stage + 1
