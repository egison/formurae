-- Two-dimensional free-surface lattice Boltzmann water tank (D2Q9).
-- All initial conditions, collision, streaming, surface conversion, mass
-- redistribution, wall handling and diagnostic fields are evaluated here.
-- type: 0 = air, 1 = interface, 2 = liquid, 3 = solid.
-- Air pressure is fixed; air inertia and surface tension are omitted.
-- The bed is a staircase on this fixed lattice; no moving geometry is used.
-- See README.md for the algorithm, units and validation limits.
dimension 2
axes x, y
param nx = 512
param ny = 192
param depth = 72
param amplitude = 52.5
param center = 105
param width = 36
param beachStart = 180
param beachSlope = 0.2
param gravity = 0.00006666666666666667
param tau = 0.68
param launch = 2.5
param threshold = 0.001
param hx = dx
param hy = dy

-- Exact one-cell shifts from the existing centered differences, as in lbm_d3q19.
def sx c q = q + c*hx*∂_x q + hx^2*∂^2_x q/2
def sy c q = q + c*hy*∂_y q + hy^2*∂^2_y q/2
macro diagonal cx cy q =
  local intermediate = sx cx q
  in sy cy intermediate

def equilibrium w cx cy r u v = w*r*(1 + 3*(cx*u + cy*v) + (9/2)*(cx*u + cy*v)^2 - (3/2)*(u^2 + v^2))
def forcing w cx cy r u v = (1 - 1/(2*tau))*w*r*(0 - gravity)*(3*(cy-v) + 9*(cx*u+cy*v)*cy)
def bounded q = if q < 0 then 0 else if q > 1 then 1 else q
-- Keep a field-valued branch: Formura infers a scalar for two constant branches,
-- so shifting that local would not shift its predicate. Kinds are exactly 0/1/2/3.
def liquid q = if q > 1.5 && q < 2.5 then q/2 else 0
def interface q = if q > 0.5 && q < 1.5 then q else 0
def gas q = if q < 0.5 then 1-q else 0
def active q = if q > 0.5 && q < 2.5 then (if q < 1.5 then q else q/2) else 0

def bed = if x > beachStart then 2 + beachSlope*(x - beachStart) else 2
def elevation = amplitude / cosh((x-center)/width)^2
def height = depth + elevation
def fill = bounded (height - y + 0.5)
def initialType = if x < 2 || x > nx-3 || y < bed || y > ny-3 then 3 else if y < height-1.5 then 2 else if y < height+1.5 then 1 else 0
def initialDensity = if y < height then 1 + 3*gravity*(height-y) else 1
def initialU = if active initialType > 0.5 then launch*sqrt(gravity*(depth+amplitude))*elevation/height else 0

static field wall : scalar := if initialType > 2.5 then 1 else 0
field kind : scalar
field mass : scalar
field bank : scalar
field water : scalar
field fraction : scalar
field speed : scalar
field density : scalar
field overhang : scalar
field bad : scalar

field f0 : scalar
field f1 : scalar
field f2 : scalar
field f3 : scalar
field f4 : scalar
field f5 : scalar
field f6 : scalar
field f7 : scalar
field f8 : scalar

field savedRho : scalar
field savedUx : scalar
field savedUy : scalar
field savedEps : scalar
field savedG0 : scalar
field savedG1 : scalar
field savedG2 : scalar
field savedG3 : scalar
field savedG4 : scalar
field savedG5 : scalar
field savedG6 : scalar
field savedG7 : scalar
field savedG8 : scalar
field savedS0 : scalar
field savedS1 : scalar
field savedS2 : scalar
field savedS3 : scalar
field savedS4 : scalar
field savedS5 : scalar
field savedS6 : scalar
field savedS7 : scalar
field savedS8 : scalar
field savedNr : scalar
field savedTransported : scalar
field savedProposal : scalar
field savedNextKind : scalar
field savedBaseMass : scalar
field savedExcess : scalar
field savedAverageRho : scalar
field savedAverageX : scalar
field savedAverageY : scalar
field stage : scalar

init:
  kind := initialType
  mass := if active initialType > 0.5 then fill*initialDensity else 0
  bank := 0
  water := if active initialType > 0.5 then fill*initialDensity else 0
  fraction := if active initialType > 0.5 then fill else 0
  density := if active initialType > 0.5 then initialDensity else 1
  speed := initialU
  overhang := 0
  bad := 0
  f0 := equilibrium (4/9) (0) (0) initialDensity initialU 0
  f1 := equilibrium (1/9) (1) (0) initialDensity initialU 0
  f2 := equilibrium (1/9) (-1) (0) initialDensity initialU 0
  f3 := equilibrium (1/9) (0) (1) initialDensity initialU 0
  f4 := equilibrium (1/9) (0) (-1) initialDensity initialU 0
  f5 := equilibrium (1/36) (1) (1) initialDensity initialU 0
  f6 := equilibrium (1/36) (-1) (-1) initialDensity initialU 0
  f7 := equilibrium (1/36) (1) (-1) initialDensity initialU 0
  f8 := equilibrium (1/36) (-1) (1) initialDensity initialU 0

  savedRho := 1
  savedUx := 0
  savedUy := 0
  savedEps := 0
  savedG0 := 0
  savedG1 := 0
  savedG2 := 0
  savedG3 := 0
  savedG4 := 0
  savedG5 := 0
  savedG6 := 0
  savedG7 := 0
  savedG8 := 0
  savedS0 := 0
  savedS1 := 0
  savedS2 := 0
  savedS3 := 0
  savedS4 := 0
  savedS5 := 0
  savedS6 := 0
  savedS7 := 0
  savedS8 := 0
  savedNr := 1
  savedTransported := 0
  savedProposal := 0
  savedNextKind := 0
  savedBaseMass := 0
  savedExcess := 0
  savedAverageRho := 1
  savedAverageX := 0
  savedAverageY := 0
  stage := 0

step:

  -- Stage 0: collision and body force.
  local rho = f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8
  local ux = (f1 - f2 + f5 - f6 + f7 - f8)/rho
  local uy = (f3 - f4 + f5 - f6 - f7 + f8)/rho - gravity/2
  local eps = bounded (mass/rho)
  local g0 = f0 + (equilibrium (4/9) (0) (0) rho ux uy - f0)/tau + forcing (4/9) (0) (0) rho ux uy
  local g1 = f1 + (equilibrium (1/9) (1) (0) rho ux uy - f1)/tau + forcing (1/9) (1) (0) rho ux uy
  local g2 = f2 + (equilibrium (1/9) (-1) (0) rho ux uy - f2)/tau + forcing (1/9) (-1) (0) rho ux uy
  local g3 = f3 + (equilibrium (1/9) (0) (1) rho ux uy - f3)/tau + forcing (1/9) (0) (1) rho ux uy
  local g4 = f4 + (equilibrium (1/9) (0) (-1) rho ux uy - f4)/tau + forcing (1/9) (0) (-1) rho ux uy
  local g5 = f5 + (equilibrium (1/36) (1) (1) rho ux uy - f5)/tau + forcing (1/36) (1) (1) rho ux uy
  local g6 = f6 + (equilibrium (1/36) (-1) (-1) rho ux uy - f6)/tau + forcing (1/36) (-1) (-1) rho ux uy
  local g7 = f7 + (equilibrium (1/36) (1) (-1) rho ux uy - f7)/tau + forcing (1/36) (1) (-1) rho ux uy
  local g8 = f8 + (equilibrium (1/36) (-1) (1) rho ux uy - f8)/tau + forcing (1/36) (-1) (1) rho ux uy
  savedRho' = if stage < 0.5 && stage > -0.5 then rho else savedRho
  savedUx' = if stage < 0.5 && stage > -0.5 then ux else savedUx
  savedUy' = if stage < 0.5 && stage > -0.5 then uy else savedUy
  savedEps' = if stage < 0.5 && stage > -0.5 then eps else savedEps
  savedG0' = if stage < 0.5 && stage > -0.5 then g0 else savedG0
  savedG1' = if stage < 0.5 && stage > -0.5 then g1 else savedG1
  savedG2' = if stage < 0.5 && stage > -0.5 then g2 else savedG2
  savedG3' = if stage < 0.5 && stage > -0.5 then g3 else savedG3
  savedG4' = if stage < 0.5 && stage > -0.5 then g4 else savedG4
  savedG5' = if stage < 0.5 && stage > -0.5 then g5 else savedG5
  savedG6' = if stage < 0.5 && stage > -0.5 then g6 else savedG6
  savedG7' = if stage < 0.5 && stage > -0.5 then g7 else savedG7
  savedG8' = if stage < 0.5 && stage > -0.5 then g8 else savedG8

  -- Stage 1: streaming, mass flux and proposed cell types.
  local k1 = sx (-1) kind
  local e1 = sx (-1) savedEps
  local incoming1 = sx (-1) savedG1
  local k2 = sx (1) kind
  local e2 = sx (1) savedEps
  local incoming2 = sx (1) savedG2
  local k3 = sy (-1) kind
  local e3 = sy (-1) savedEps
  local incoming3 = sy (-1) savedG3
  local k4 = sy (1) kind
  local e4 = sy (1) savedEps
  local incoming4 = sy (1) savedG4
  local k5 = diagonal (-1) (-1) kind
  local e5 = diagonal (-1) (-1) savedEps
  local incoming5 = diagonal (-1) (-1) savedG5
  local k6 = diagonal (1) (1) kind
  local e6 = diagonal (1) (1) savedEps
  local incoming6 = diagonal (1) (1) savedG6
  local k7 = diagonal (-1) (1) kind
  local e7 = diagonal (-1) (1) savedEps
  local incoming7 = diagonal (-1) (1) savedG7
  local k8 = diagonal (1) (-1) kind
  local e8 = diagonal (1) (-1) savedEps
  local incoming8 = diagonal (1) (-1) savedG8
  local s0 = savedG0
  local s1 = if k1 > 2.5 then savedG2 else if k1 < 0.5 then equilibrium (1/9) (1) (0) 1 savedUx savedUy + equilibrium (1/9) (-1) (0) 1 savedUx savedUy - savedG2 else incoming1
  local dm1 = if active kind < 0.5 || active k1 < 0.5 then 0 else if liquid kind > 0.5 || liquid k1 > 0.5 then incoming1 - savedG2 else (savedEps + e1)*(incoming1 - savedG2)/2
  local s2 = if k2 > 2.5 then savedG1 else if k2 < 0.5 then equilibrium (1/9) (-1) (0) 1 savedUx savedUy + equilibrium (1/9) (1) (0) 1 savedUx savedUy - savedG1 else incoming2
  local dm2 = if active kind < 0.5 || active k2 < 0.5 then 0 else if liquid kind > 0.5 || liquid k2 > 0.5 then incoming2 - savedG1 else (savedEps + e2)*(incoming2 - savedG1)/2
  local s3 = if k3 > 2.5 then savedG4 else if k3 < 0.5 then equilibrium (1/9) (0) (1) 1 savedUx savedUy + equilibrium (1/9) (0) (-1) 1 savedUx savedUy - savedG4 else incoming3
  local dm3 = if active kind < 0.5 || active k3 < 0.5 then 0 else if liquid kind > 0.5 || liquid k3 > 0.5 then incoming3 - savedG4 else (savedEps + e3)*(incoming3 - savedG4)/2
  local s4 = if k4 > 2.5 then savedG3 else if k4 < 0.5 then equilibrium (1/9) (0) (-1) 1 savedUx savedUy + equilibrium (1/9) (0) (1) 1 savedUx savedUy - savedG3 else incoming4
  local dm4 = if active kind < 0.5 || active k4 < 0.5 then 0 else if liquid kind > 0.5 || liquid k4 > 0.5 then incoming4 - savedG3 else (savedEps + e4)*(incoming4 - savedG3)/2
  local s5 = if k5 > 2.5 then savedG6 else if k5 < 0.5 then equilibrium (1/36) (1) (1) 1 savedUx savedUy + equilibrium (1/36) (-1) (-1) 1 savedUx savedUy - savedG6 else incoming5
  local dm5 = if active kind < 0.5 || active k5 < 0.5 then 0 else if liquid kind > 0.5 || liquid k5 > 0.5 then incoming5 - savedG6 else (savedEps + e5)*(incoming5 - savedG6)/2
  local s6 = if k6 > 2.5 then savedG5 else if k6 < 0.5 then equilibrium (1/36) (-1) (-1) 1 savedUx savedUy + equilibrium (1/36) (1) (1) 1 savedUx savedUy - savedG5 else incoming6
  local dm6 = if active kind < 0.5 || active k6 < 0.5 then 0 else if liquid kind > 0.5 || liquid k6 > 0.5 then incoming6 - savedG5 else (savedEps + e6)*(incoming6 - savedG5)/2
  local s7 = if k7 > 2.5 then savedG8 else if k7 < 0.5 then equilibrium (1/36) (1) (-1) 1 savedUx savedUy + equilibrium (1/36) (-1) (1) 1 savedUx savedUy - savedG8 else incoming7
  local dm7 = if active kind < 0.5 || active k7 < 0.5 then 0 else if liquid kind > 0.5 || liquid k7 > 0.5 then incoming7 - savedG8 else (savedEps + e7)*(incoming7 - savedG8)/2
  local s8 = if k8 > 2.5 then savedG7 else if k8 < 0.5 then equilibrium (1/36) (-1) (1) 1 savedUx savedUy + equilibrium (1/36) (1) (-1) 1 savedUx savedUy - savedG7 else incoming8
  local dm8 = if active kind < 0.5 || active k8 < 0.5 then 0 else if liquid kind > 0.5 || liquid k8 > 0.5 then incoming8 - savedG7 else (savedEps + e8)*(incoming8 - savedG7)/2
  local nr = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8
  local transported = mass + dm1 + dm2 + dm3 + dm4 + dm5 + dm6 + dm7 + dm8
  local fluidNeighbors = liquid k1 + liquid k2 + liquid k3 + liquid k4 + liquid k5 + liquid k6 + liquid k7 + liquid k8
  local airNeighbors = gas k1 + gas k2 + gas k3 + gas k4 + gas k5 + gas k6 + gas k7 + gas k8
  local proposal = if interface kind > 0.5 then (if transported > (1+threshold)*nr || (airNeighbors < 0.5 && transported > (1-threshold)*nr) then 2 else if transported < (0-threshold)*nr || (fluidNeighbors < 0.5 && transported < threshold*nr) then 0 else 1) else kind
  savedS0' = if stage < 1.5 && stage > 0.5 then s0 else savedS0
  savedS1' = if stage < 1.5 && stage > 0.5 then s1 else savedS1
  savedS2' = if stage < 1.5 && stage > 0.5 then s2 else savedS2
  savedS3' = if stage < 1.5 && stage > 0.5 then s3 else savedS3
  savedS4' = if stage < 1.5 && stage > 0.5 then s4 else savedS4
  savedS5' = if stage < 1.5 && stage > 0.5 then s5 else savedS5
  savedS6' = if stage < 1.5 && stage > 0.5 then s6 else savedS6
  savedS7' = if stage < 1.5 && stage > 0.5 then s7 else savedS7
  savedS8' = if stage < 1.5 && stage > 0.5 then s8 else savedS8
  savedNr' = if stage < 1.5 && stage > 0.5 then nr else savedNr
  savedTransported' = if stage < 1.5 && stage > 0.5 then transported else savedTransported
  savedProposal' = if stage < 1.5 && stage > 0.5 then proposal else savedProposal

  -- Stage 2: consistent surface types and new-cell initial states.
  local proposedLiquid = liquid savedProposal
  local proposedGas = gas savedProposal
  local pl1 = sx (-1) proposedLiquid
  local pg1 = sx (-1) proposedGas
  local pl2 = sx (1) proposedLiquid
  local pg2 = sx (1) proposedGas
  local pl3 = sy (-1) proposedLiquid
  local pg3 = sy (-1) proposedGas
  local pl4 = sy (1) proposedLiquid
  local pg4 = sy (1) proposedGas
  local pl5 = diagonal (-1) (-1) proposedLiquid
  local pg5 = diagonal (-1) (-1) proposedGas
  local pl6 = diagonal (1) (1) proposedLiquid
  local pg6 = diagonal (1) (1) proposedGas
  local pl7 = diagonal (-1) (1) proposedLiquid
  local pg7 = diagonal (-1) (1) proposedGas
  local pl8 = diagonal (1) (-1) proposedLiquid
  local pg8 = diagonal (1) (-1) proposedGas
  local nearLiquid = pl1 + pl2 + pl3 + pl4 + pl5 + pl6 + pl7 + pl8
  local nearGas = pg1 + pg2 + pg3 + pg4 + pg5 + pg6 + pg7 + pg8
  local nextKind = if wall > 0.5 then 3 else if savedProposal < 0.5 && nearLiquid > 0.5 then 1 else if savedProposal > 1.5 && nearGas > 0.5 then 1 else savedProposal
  local baseMass = if liquid nextKind > 0.5 then savedNr else if interface nextKind > 0.5 then savedTransported else 0
  local excess = savedTransported - baseMass + bank
  local act = active kind
  local arho = act*savedRho
  local ax = act*savedUx
  local ay = act*savedUy
  local act1 = sx (-1) act
  local ar1 = sx (-1) arho
  local ax1 = sx (-1) ax
  local ay1 = sx (-1) ay
  local act2 = sx (1) act
  local ar2 = sx (1) arho
  local ax2 = sx (1) ax
  local ay2 = sx (1) ay
  local act3 = sy (-1) act
  local ar3 = sy (-1) arho
  local ax3 = sy (-1) ax
  local ay3 = sy (-1) ay
  local act4 = sy (1) act
  local ar4 = sy (1) arho
  local ax4 = sy (1) ax
  local ay4 = sy (1) ay
  local act5 = diagonal (-1) (-1) act
  local ar5 = diagonal (-1) (-1) arho
  local ax5 = diagonal (-1) (-1) ax
  local ay5 = diagonal (-1) (-1) ay
  local act6 = diagonal (1) (1) act
  local ar6 = diagonal (1) (1) arho
  local ax6 = diagonal (1) (1) ax
  local ay6 = diagonal (1) (1) ay
  local act7 = diagonal (-1) (1) act
  local ar7 = diagonal (-1) (1) arho
  local ax7 = diagonal (-1) (1) ax
  local ay7 = diagonal (-1) (1) ay
  local act8 = diagonal (1) (-1) act
  local ar8 = diagonal (1) (-1) arho
  local ax8 = diagonal (1) (-1) ax
  local ay8 = diagonal (1) (-1) ay
  local neighbors = act1 + act2 + act3 + act4 + act5 + act6 + act7 + act8
  local neighborCount = if neighbors > 0.5 then neighbors else 1
  local averageRho = if neighbors > 0.5 then (ar1 + ar2 + ar3 + ar4 + ar5 + ar6 + ar7 + ar8)/neighborCount else 1
  local averageX = (ax1 + ax2 + ax3 + ax4 + ax5 + ax6 + ax7 + ax8)/neighborCount
  local averageY = (ay1 + ay2 + ay3 + ay4 + ay5 + ay6 + ay7 + ay8)/neighborCount
  savedNextKind' = if stage < 2.5 && stage > 1.5 then nextKind else savedNextKind
  savedBaseMass' = if stage < 2.5 && stage > 1.5 then baseMass else savedBaseMass
  savedExcess' = if stage < 2.5 && stage > 1.5 then excess else savedExcess
  savedAverageRho' = if stage < 2.5 && stage > 1.5 then averageRho else savedAverageRho
  savedAverageX' = if stage < 2.5 && stage > 1.5 then averageX else savedAverageX
  savedAverageY' = if stage < 2.5 && stage > 1.5 then averageY else savedAverageY

  -- Stage 3: conservative redistribution and the physical state update.
  local receiver = interface savedNextKind
  local rec1 = sx (-1) receiver
  local rec2 = sx (1) receiver
  local rec3 = sy (-1) receiver
  local rec4 = sy (1) receiver
  local rec5 = diagonal (-1) (-1) receiver
  local rec6 = diagonal (1) (1) receiver
  local rec7 = diagonal (-1) (1) receiver
  local rec8 = diagonal (1) (-1) receiver
  local receiverCount = receiver + rec1 + rec2 + rec3 + rec4 + rec5 + rec6 + rec7 + rec8
  local share = if receiverCount > 0.5 then savedExcess/receiverCount else 0
  local share1 = sx (-1) share
  local share2 = sx (1) share
  local share3 = sy (-1) share
  local share4 = sy (1) share
  local share5 = diagonal (-1) (-1) share
  local share6 = diagonal (1) (1) share
  local share7 = diagonal (-1) (1) share
  local share8 = diagonal (1) (-1) share
  local nextMass = savedBaseMass + receiver*(share + share1 + share2 + share3 + share4 + share5 + share6 + share7 + share8)
  local nextBank = if receiverCount > 0.5 then 0 else savedExcess
  kind' = if stage > 2.5 && stage < 3.5 then savedNextKind else kind
  mass' = if stage > 2.5 && stage < 3.5 then nextMass else mass
  bank' = if stage > 2.5 && stage < 3.5 then nextBank else bank
  water' = if stage > 2.5 && stage < 3.5 then nextMass + nextBank else water
  f0' = if stage > 2.5 && stage < 3.5 then (if active savedNextKind < 0.5 then (4/9) else if kind < 0.5 then equilibrium (4/9) (0) (0) savedAverageRho savedAverageX savedAverageY else savedS0) else f0
  f1' = if stage > 2.5 && stage < 3.5 then (if active savedNextKind < 0.5 then (1/9) else if kind < 0.5 then equilibrium (1/9) (1) (0) savedAverageRho savedAverageX savedAverageY else savedS1) else f1
  f2' = if stage > 2.5 && stage < 3.5 then (if active savedNextKind < 0.5 then (1/9) else if kind < 0.5 then equilibrium (1/9) (-1) (0) savedAverageRho savedAverageX savedAverageY else savedS2) else f2
  f3' = if stage > 2.5 && stage < 3.5 then (if active savedNextKind < 0.5 then (1/9) else if kind < 0.5 then equilibrium (1/9) (0) (1) savedAverageRho savedAverageX savedAverageY else savedS3) else f3
  f4' = if stage > 2.5 && stage < 3.5 then (if active savedNextKind < 0.5 then (1/9) else if kind < 0.5 then equilibrium (1/9) (0) (-1) savedAverageRho savedAverageX savedAverageY else savedS4) else f4
  f5' = if stage > 2.5 && stage < 3.5 then (if active savedNextKind < 0.5 then (1/36) else if kind < 0.5 then equilibrium (1/36) (1) (1) savedAverageRho savedAverageX savedAverageY else savedS5) else f5
  f6' = if stage > 2.5 && stage < 3.5 then (if active savedNextKind < 0.5 then (1/36) else if kind < 0.5 then equilibrium (1/36) (-1) (-1) savedAverageRho savedAverageX savedAverageY else savedS6) else f6
  f7' = if stage > 2.5 && stage < 3.5 then (if active savedNextKind < 0.5 then (1/36) else if kind < 0.5 then equilibrium (1/36) (1) (-1) savedAverageRho savedAverageX savedAverageY else savedS7) else f7
  f8' = if stage > 2.5 && stage < 3.5 then (if active savedNextKind < 0.5 then (1/36) else if kind < 0.5 then equilibrium (1/36) (-1) (1) savedAverageRho savedAverageX savedAverageY else savedS8) else f8

  -- Stage 4: diagnostics read only the completed state.
  local newRho = f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8
  local newUx = (f1 - f2 + f5 - f6 + f7 - f8)/newRho
  local newUy = (f3 - f4 + f5 - f6 - f7 + f8)/newRho - gravity/2
  local newFraction = if active kind > 0.5 then bounded (mass/newRho) else 0
  local below = sy (-1) newFraction
  local belowWall = sy (-1) wall
  fraction' = if stage > 3.5 then newFraction else fraction
  density' = if stage > 3.5 then (if active kind > 0.5 then newRho else 1) else density
  speed' = if stage > 3.5 then (if active kind > 0.5 then sqrt(newUx^2 + newUy^2) else 0) else speed
  overhang' = if stage > 3.5 then (if newFraction > 0.5 && below < 0.5 && belowWall < 0.5 then 1 else 0) else overhang
  bad' = if stage > 3.5 then (if newRho > 0.5 && newRho < 1.5 && newUx^2 + newUy^2 < 0.09 then 0 else 1) else bad
  stage' = if stage > 3.5 then 0 else stage + 1
