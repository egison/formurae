-- Linearized free-surface gravity waves with continuous-time D2Q9.
-- Fixed reference domain, a dynamic surface displacement at its top, and
-- the SAME boundary mass flux in the bulk and surface updates.
-- All equations, initialization, geometry, RK stages and diagnostics are FME.
-- This small-amplitude model does not include overturning or wetting/drying.
dimension 2
axes x, y
index a : 9
index p : 2
param warpX = 0.2
param warpY = 0.15
param scenario = 1
param gravity = 0.02
param timeScale = 1
param boundarySlope = 1
param amplitude = 0.01
param tau = 0.04
param extent = 6.283185307179586
param depth = 3.141592653589793
param gauss = 0.5773502691896258
param hx = dx
param hy = dy
param dt = timeScale*0.05*hx*hy/(hx+hy)
param cell = hx*hy
extern sin
extern cos
extern exp
extern sqrt
extern cosh
extern tanh
extern surfaceConfig

def mapX u v = u+warpX*sin(u)*sin(v)
def mapY u v = v+warpY*sin(u)*sin(v)
def xi = x+hx/2
def eta = y-hy/2
def inside = if eta > 0 && eta < depth then 1 else 0
def surfaceRow = if eta > depth-hy && eta < depth then 1 else 0
def bottomFace = if eta < hy/4 then 1 else 0
def topFace = if eta > depth-hy/4 then 1 else 0
def boundaryCell = if eta < hy || eta > depth-hy then 1 else 0
def weights = [| 4/9,1/9,1/9,1/9,1/9,1/36,1/36,1/36,1/36 |]
def ex = [| 0,1,-1,0,0,1,-1,1,-1 |]
def ey = [| 0,0,0,1,-1,1,-1,-1,1 |]
def ones = [| 1,1,1,1,1,1,1,1,1 |]
def frame = generateTensor (\[k,q] -> if k = 1 then ex_q else ey_q) [2,9]
def smaller first second = if first < second then first else second
def bigger first second = if first > second then first else second
def maxPopulation T_a = bigger (bigger (bigger (T_1) (T_2)) (bigger (T_3) (T_4))) (bigger (bigger (T_5) (T_6)) (bigger (T_7) (bigger (T_8) (T_9))))
def minPopulation T_a = 0-maxPopulation (0-T_a)
def absval v = if v >= 0 then v else 0-v
def minmod first second = if first*second <= 0 then 0 else if first > 0 then smaller first second else 0-smaller (0-first) (0-second)
def mcSlope back forward = minmod ((back+forward)/2) (2*minmod back forward)
def reflectY T_a = [| T_1,T_2,T_3,T_5,T_4,T_8,T_9,T_6,T_7 |]
def opposite T_a = [| T_1,T_3,T_2,T_5,T_4,T_7,T_6,T_9,T_8 |]

def areaDensity = 1+warpX*(2*sin(hx/2)/hx)*cos(hy/2)*cos(xi)*sin(eta)+warpY*(2*sin(hy/2)/hy)*cos(hx/2)*sin(xi)*cos(eta)
static field volumeCell := areaDensity
def faceX cx cy = ((mapY xi (eta+hy/2)-mapY xi (eta-hy/2))*cx-(mapX xi (eta+hy/2)-mapX xi (eta-hy/2))*cy)/hy
def faceY cx cy = if bottomFace+topFace > 0.5 then cy else ((mapX (xi+hx/2) eta-mapX (xi-hx/2) eta)*cy-(mapY (xi+hx/2) eta-mapY (xi-hx/2) eta)*cx)/hx
def speeds = generateTensor (\[k,q] -> if k = 1 then faceX ex_q ey_q else faceY ex_q ey_q) [2,9]
static field B~i_a @ primal := (speeds)~i_a
-- Bilinear polygon coordinates and four-point Gaussian cell quadrature.
def mapMean = sin(xi)*cos(hx/2)*sin(eta)*cos(hy/2)
def mapXi = cos(xi)*sin(hx/2)*sin(eta)*cos(hy/2)
def mapEta = sin(xi)*cos(hx/2)*cos(eta)*sin(hy/2)
def mapXiEta = cos(xi)*sin(hx/2)*cos(eta)*sin(hy/2)
def quadMap first second = mapMean+mapXi*first+mapEta*second+mapXiEta*first*second
def quadX first second = xi+hx*first/2+warpX*quadMap first second
def quadY first second = eta+hy*second/2+warpY*quadMap first second
def quadJacobian first second = cell/4+warpX*hy*(mapXi+mapXiEta*second)/2+warpY*hx*(mapEta+mapXiEta*first)/2
def cellAverage fn = (quadJacobian gauss gauss*fn(quadX gauss gauss)(quadY gauss gauss)+quadJacobian (0-gauss) gauss*fn(quadX (0-gauss) gauss)(quadY (0-gauss) gauss)+quadJacobian gauss (0-gauss)*fn(quadX gauss (0-gauss))(quadY gauss (0-gauss))+quadJacobian (0-gauss) (0-gauss)*fn(quadX (0-gauss) (0-gauss))(quadY (0-gauss) (0-gauss)))/(cell*areaDensity)
def hydrostaticDensity xx yy = exp(3*gravity*(depth-yy))
def pressureWave xx yy = hydrostaticDensity xx yy*3*gravity*amplitude*cos(xx)*cosh(yy)/cosh(depth)
static field rhoH := cellAverage hydrostaticDensity
static field initialPressure := if scenario > 0.5 then cellAverage pressureWave else 0
static field surfaceCos := cos(xi)*2*sin(hx/2)/hx
def initialSurface = if scenario > 0.5 then amplitude*surfaceCos else 0
def initial = weights_a*initialPressure
def waveFrequency = sqrt(gravity*tanh(depth))

macro numericalFlux Q Z =
  local lower~i_a @ primal = [| sampleLower(Q,1,0), sampleLower(Q,0,1) |]~i_a
  local upper~i_a @ primal = [| sampleUpper(Q,1,0), sampleUpper(Q,0,1) |]~i_a
  local jump~i_a @ primal = upper~i_a-lower~i_a
  local backwardX_a = sampleLower(jump~1_a,0,0)
  local forwardX_a = sampleUpper(jump~1_a,0,0)
  local backwardY_a = sampleLower(jump~2_a,0,0)
  local forwardY_a = sampleUpper(jump~2_a,0,0)
  local slopeX_a = mcSlope backwardX_a forwardX_a
  local slopeY_a = if eta < hy then boundarySlope*forwardY_a else if eta > depth-hy then boundarySlope*backwardY_a else mcSlope backwardY_a forwardY_a
  local left~i_a @ primal = lower~i_a+[| sampleLower(slopeX,1,0), sampleLower(slopeY,0,1) |]~i_a/2
  local right~i_a @ primal = upper~i_a-[| sampleUpper(slopeX,1,0), sampleUpper(slopeY,0,1) |]~i_a/2
  local height~i @ primal = [| sampleLower(Z,1,0), sampleLower(Z,0,1) |]~i
  -- At Y=depth, pressure perturbation = gravity*surface, since rhoH=1.
  -- Incoming/outgoing opposite pairs enforce normal stress and zero shear.
  local wallLeft~i_a @ primal = [| left~1_a, if bottomFace > 0.5 then (reflectY (right~2_a))_a else left~2_a |]~i_a
  local boundaryRight~i_a @ primal = [| right~1_a, if topFace > 0.5 then 6*gravity*weights_a*height~2-(opposite (left~2_a))_a else right~2_a |]~i_a
  in (B~i_a*(wallLeft~i_a+boundaryRight~i_a)-absval(B~i_a)*(boundaryRight~i_a-wallLeft~i_a))/2

field f_a
field original_a
field surface
field originalSurface
field stage
field elapsed
field waterMass
field surfaceMode
field surfaceMean
field surfaceMaximum
field velocityX
field velocityY
field speed
field densityDeviation
field lowest
field collisionResidual
field forceResidual
field wallMassFlux
field surfaceStressError
field surfaceShearError
field couplingError
field firstCrossing
field crossingTime
field secondCrossing
field period
field periodError
field referencePeriod
field minArea
init:
  f_a := if inside > 0.5 then (initial)_a else 0
  original_a := if inside > 0.5 then (initial)_a else 0
  surface := surfaceRow*initialSurface
  originalSurface := surfaceRow*initialSurface
  stage := 0
  elapsed := 0
  waterMass := inside*cell*volumeCell*(rhoH+initialPressure)+surfaceRow*hx*initialSurface
  surfaceMode := 2*surfaceRow*hx*initialSurface*surfaceCos/extent
  surfaceMean := surfaceRow*hx*initialSurface/extent
  surfaceMaximum := surfaceRow*absval(initialSurface)
  velocityX := 0
  velocityY := 0
  speed := 0
  densityDeviation := inside*initialPressure
  lowest := if inside > 0.5 then rhoH+initialPressure else 10
  collisionResidual := 0
  forceResidual := 0
  wallMassFlux := 0
  surfaceStressError := 0
  surfaceShearError := 0
  couplingError := 0
  firstCrossing := 0
  crossingTime := 0
  secondCrossing := 0
  period := 0
  periodError := 0
  referencePeriod := if gravity > 0 then extent/waveFrequency else 0
  minArea := if inside > 0.5 then cell*volumeCell else 10
step:
  local flux~i_a @ primal = numericalFlux f surface
  local advection_a = (0-∂_i flux~i_a)/volumeCell
  local deltaRho = ones~a . f_a
  local momentum~p = frame~p~a . f_a
  local cj_a = frame_p_a . momentum~p
  local equilibrium_a = weights_a*(deltaRho+3*cj_a)
  local collision_a = (equilibrium_a-f_a)/tau
  -- The force is linearized about the hydrostatic reference together with BGK.
  local source_a = weights_a*gravity*((0-3)*deltaRho*ey_a-9*cj_a*ey_a+3*momentum~2)
  local euler_a = f_a+dt*(advection_a+collision_a+source_a)
  local topFlux_a = sampleUpper(flux~2_a,0,0)
  local surfaceRate = surfaceRow*(ones~a . topFlux_a)
  local surfaceEuler = surface+dt*surfaceRate
  original'_a = if stage < 0.5 then f_a else original_a
  originalSurface' = if stage < 0.5 then surface else originalSurface
  f'_a = if inside < 0.5 then 0 else if stage < 0.5 then euler_a else (original_a+euler_a)/2
  surface' = if stage < 0.5 then surfaceEuler else (originalSurface+surfaceEuler)/2
  stage' = if stage < 0.5 then 1 else 0
  elapsed' = if stage < 0.5 then elapsed else elapsed+dt
  local newRho = ones~a . f'_a
  local newMx = ex~a . f'_a
  local newMy = ey~a . f'_a
  waterMass' = inside*cell*volumeCell*(rhoH+newRho)+surfaceRow*hx*surface'
  surfaceMode' = 2*surfaceRow*hx*surface'*surfaceCos/extent
  surfaceMean' = surfaceRow*hx*surface'/extent
  surfaceMaximum' = surfaceRow*absval(surface')
  velocityX' = inside*newMx/rhoH
  velocityY' = inside*newMy/rhoH
  speed' = inside*sqrt(newMx^2+newMy^2)/rhoH
  densityDeviation' = inside*newRho
  lowest' = if inside < 0.5 then 10 else smaller lowest (smaller (minPopulation (f'_a/weights_a+rhoH)) (minPopulation (euler_a/weights_a+rhoH)))
  local collisionCheck = bigger (absval(ones~a . collision_a)) (bigger (absval(ex~a . collision_a)) (absval(ey~a . collision_a)))
  collisionResidual' = bigger collisionResidual (inside*collisionCheck)
  local forceCheck = bigger (absval(ones~a . source_a)) (bigger (absval(ex~a . source_a)) (absval((ey~a . source_a)+gravity*deltaRho)))
  forceResidual' = bigger forceResidual (inside*forceCheck)
  local lowerWall_a = sampleLower(flux~2_a,0,0)
  wallMassFlux' = bigger wallMassFlux (inside*(if eta < hy then absval(ones~a . lowerWall_a) else 0))
  surfaceStressError' = bigger surfaceStressError (surfaceRow*absval((ey~a . topFlux_a)-gravity*surface))
  surfaceShearError' = bigger surfaceShearError (surfaceRow*absval(ex~a . topFlux_a))
  local actualRate = if stage < 0.5 then (surface'-surface)/dt else (2*surface'-originalSurface-surface)/dt
  couplingError' = bigger couplingError (absval(actualRate-surfaceRate))
  local crossed = if stage > 0.5 && surfaceRow > 0.5 && absval(surfaceCos) > 0.5 && originalSurface*surfaceCos > 0 && surface'*surfaceCos <= 0 && firstCrossing < 0.5 then 1 else 0
  firstCrossing' = if crossed > 0.5 then elapsed+dt*originalSurface/(originalSurface-surface') else firstCrossing
  crossingTime' = if surfaceRow > 0.5 && absval(surfaceCos) > 0.5 then firstCrossing' else 0
  local returned = if stage > 0.5 && surfaceRow > 0.5 && absval(surfaceCos) > 0.5 && originalSurface*surfaceCos < 0 && surface'*surfaceCos >= 0 && firstCrossing > 0.5 && secondCrossing < 0.5 then 1 else 0
  secondCrossing' = if returned > 0.5 then elapsed+dt*originalSurface/(originalSurface-surface') else secondCrossing
  period' = if secondCrossing' > 0.5 then 2*(secondCrossing'-firstCrossing') else 0
  periodError' = if secondCrossing' > 0.5 then absval(period'*waveFrequency/extent-1) else 0
  referencePeriod' = referencePeriod
  minArea' = if inside > 0.5 then cell*volumeCell else 10
