  D1_up2_up2[i,j] = 2 * G2_down1_down2[i,j] * Q_up2_up2[i,j] + G2_down1_down1[i,j] * Q_up1_up2[i,j] + G2_down1_down1[i,j] * Q_up2_up1[i,j] + ((-1 / 2) * Q_up2_up2[i-1,j] + (1 / 2) * Q_up2_up2[i+1,j]) / dtheta
  D2_up1_up1[i,j] = 2 * G1_down1_down2[i,j] * Q_up1_up1[i,j] + G1_down2_down2[i,j] * Q_up1_up2[i,j] + G1_down2_down2[i,j] * Q_up2_up1[i,j] + ((-1 / 2) * Q_up1_up1[i,j-1] + (1 / 2) * Q_up1_up1[i,j+1]) / dphi
