-- Continuous-time discrete-velocity free surface, finite-volume transport.
-- All geometry, boundary states, wetting, time integration and diagnostics
-- are expressed here, through the normal Formurae compilation pipeline.
dimension 2
axes x, y
index a : 9
index p : 2
index s : 4
param lengthX = 1
param lengthY = 1
param warpX = 0
param warpY = 0
param scenario = 0
param gravity = 0.02
param level = 0.5
param amplitude = 0.03
param waveCenter = 0.3
param waveWidth = 0.12
param bedStart = 0.6
param bedSlope = 0
param speed = 0.1
param tau = 0.02
param timeScale = 1
param periodic = 0
param method = 1
param surfacePosition = 1
param fittedBed = 1
param wetFraction = 0.01
param heightMethod = 1
param wallSlip = 1
param boundarySlope = 1
param collisionImplicit = 1
param compression = 5
param launch = 1
param alignmentFloor = 0.000000000001
param piValue = 3.141592653589793
param hx = dx
param hy = dy
param dt = timeScale*0.1*hx*hy/(hx+hy)
param cell = hx*hy
param originX = hx*(1-periodic)
param originY = hy*(1-periodic)
param spanX = lengthX-2*originX
param spanY = lengthY-2*originY
param scaleX = lengthX/spanX
param scaleY = lengthY/spanY
param physicalDx = hx*scaleX
param physicalDy = hy*scaleY
param stillDepth = level
extern sin
extern cos
extern cosh
extern exp
extern log
extern sqrt
extern surfaceConfig

def smaller first second = if first < second then first else second
def bigger first second = if first > second then first else second
def absval v = if v >= 0 then v else 0-v
def positive v = bigger v 0
def ramp v = if v < 0 then 0 else if v > 1 then 1 else v
def xi = x+hx/2
def eta = y+hy/2
def mapX u v = (u-originX)*scaleX+warpX*sin(2*piValue*(u-originX)/spanX)*sin(2*piValue*(v-originY)/spanY)
def bedAt xx = bedSlope*positive(xx-bedStart)
def mapY u v = (if fittedBed > 0.5 then bedAt(mapX u v)+(lengthY-bedAt(mapX u v))*(v-originY)/spanY else (v-originY)*scaleY)+warpY*sin(2*piValue*(u-originX)/spanX)*sin(2*piValue*(v-originY)/spanY)
static field physicalX := mapX xi eta
static field physicalY := mapY xi eta
static field tangentXX := scaleX+warpX*(2*piValue/spanX)*cos(2*piValue*(xi-originX)/spanX)*sin(2*piValue*(eta-originY)/spanY)
static field tangentXY := warpX*(2*piValue/spanY)*sin(2*piValue*(xi-originX)/spanX)*cos(2*piValue*(eta-originY)/spanY)
static field xSW := mapX (xi-hx/2) (eta-hy/2)
static field xSE := mapX (xi+hx/2) (eta-hy/2)
static field xNE := mapX (xi+hx/2) (eta+hy/2)
static field xNW := mapX (xi-hx/2) (eta+hy/2)
static field ySW := mapY (xi-hx/2) (eta-hy/2)
static field ySE := mapY (xi+hx/2) (eta-hy/2)
static field yNE := mapY (xi+hx/2) (eta+hy/2)
static field yNW := mapY (xi-hx/2) (eta+hy/2)
static field volumeCell := ((xNE-xSW)*(yNW-ySE)-(yNE-ySW)*(xNW-xSE))/(2*cell)
static field cellHeight := bigger (absval(mapY xi (eta+hy/2)-mapY xi (eta-hy/2))) 0.000000000001
-- Physical extents of a cell along each computational axis, for scaling
-- fraction differences into physical gradients on anisotropic or curved grids.
static field spanAlongX := bigger (sqrt(((xSE+xNE-xSW-xNW)/2)^2+((ySE+yNE-ySW-yNW)/2)^2)) 0.000000000001
static field spanAlongY := bigger (sqrt(((xNW+xNE-xSW-xSE)/2)^2+((yNW+yNE-ySW-ySE)/2)^2)) 0.000000000001
-- Alignment of the fraction gradient with each axis (squared cosine).
-- Alignment weight of an axis: exactly one when the other gradient component
-- is below a hundredth of this one (so an axis-aligned interface is packed
-- exactly and rounding noise cannot leak water), otherwise the squared cosine.
-- The floor is a runtime parameter: a literal this small is folded away by the
-- code generator, and the quotient is generated as a product with a
-- reciprocal, which overflows when the denominator underflows in the tails.
def alignmentWeight own other = if 100*other^2 <= own^2 then (if own^2 > 0 then 1 else 0) else own^2/(own^2+other^2+alignmentFloor)
-- Vertical offset of the water centre inside an interface cell whose water
-- is held against a fuller vertical neighbour (solid counts as full). It is
-- a diagnostic reconstruction with the same geometric rule as method=4. The
-- alignment weight is passed in, computed from stored gradient values: a
-- squared difference written inline is expanded by the CAS into cancelling
-- terms, which left roundoff (even 0/0) in nearly full cells.
def packedOffset Q weight south north deltaSouth deltaNorth = if Q <= 0 || Q >= 1 then 0 else weight*(1-Q)/2*((if south < Q then ramp (2*north-1) else 0)*deltaNorth-(if north < Q then ramp (2*south-1) else 0)*deltaSouth)
def solidAt u v = if periodic > 0.5 then 0 else if u < hx then 1 else if u > lengthX-hx then 1 else if v < hy then 1 else if v > lengthY-hy then 1 else if fittedBed > 0.5 then 0 else if mapY u v < bedSlope*positive(mapX u v-bedStart) then 1 else 0
static field solid := if periodic > 0.5 then 0 else if xi < hx then 1 else if xi > lengthX-hx then 1 else if eta < hy then 1 else if eta > lengthY-hy then 1 else if fittedBed > 0.5 then 0 else if physicalY < bedSlope*positive(physicalX-bedStart) then 1 else 0
static field referenceDensity := exp(3*gravity*(level-physicalY))
def weights = [|4/9,1/9,1/9,1/9,1/9,1/36,1/36,1/36,1/36|]
def ex = [|0,1,-1,0,0,1,-1,1,-1|]
def ey = [|0,0,0,1,-1,1,-1,-1,1|]
def ones = [|1,1,1,1,1,1,1,1,1|]
def columnOnes = [|1,1,1,1|]
def frame = generateTensor (\[k,q] -> if k = 1 then ex_q else ey_q) [2,9]
def opposite T_a = [|T_1,T_3,T_2,T_5,T_4,T_7,T_6,T_9,T_8|]
def maxPopulation T_a = bigger (bigger (bigger T_1 T_2) (bigger T_3 T_4)) (bigger (bigger T_5 T_6) (bigger T_7 (bigger T_8 T_9)))
def minPopulation T_a = 0-maxPopulation (0-T_a)
macro equilibrium R U V =
  local cu_a = ex_a*U+ey_a*V
  in weights_a*R*(1+3*cu_a+4.5*cu_a^2-1.5*(U^2+V^2))

def faceX cx cy = ((mapY xi (eta+hy/2)-mapY xi (eta-hy/2))*cx-(mapX xi (eta+hy/2)-mapX xi (eta-hy/2))*cy)/hy
def faceY cx cy = ((mapX (xi+hx/2) eta-mapX (xi-hx/2) eta)*cy-(mapY (xi+hx/2) eta-mapY (xi-hx/2) eta)*cx)/hx
def speeds = generateTensor (\[k,q] -> if k = 1 then faceX ex_q ey_q else faceY ex_q ey_q) [2,9]
static field B~i_a @ primal := (speeds)~i_a
static field faceCoordinateY~i @ primal := [|mapY xi eta,mapY xi eta|]~i
static field faceReference~i @ primal := [|exp(3*gravity*(level-mapY xi eta)),exp(3*gravity*(level-mapY xi eta))|]~i

def bump xx = amplitude*exp(0-((xx-waveCenter)/waveWidth)^2)
def heightAt xx = if scenario < 1.5 then level else if scenario < 2.5 then level+amplitude*cos(2*piValue*xx/lengthX) else if scenario < 3.5 then (if xx < waveCenter then level+amplitude else level) else level+bump xx
def initialHeight = heightAt physicalX
def fractionAt xx yy = if scenario > 6.5 then ramp ((level+amplitude/2-yy)/cellHeight+0.5)-ramp ((level-amplitude/2-yy)/cellHeight+0.5) else if scenario > 4.5 then 1 else if scenario < 0.5 then (if yy < level then 1 else 0) else if scenario < 1.5 then ramp ((level-xx)/physicalDx+0.5) else ramp ((heightAt xx-yy)/cellHeight+0.5)
static field initialFraction := if solid > 0.5 then 0 else fractionAt physicalX physicalY
static field initialTopFraction := fractionAt (mapX xi (eta+hy)) (mapY xi (eta+hy))
def initialFilledAt u v = if solidAt u v > 0.5 then 1 else fractionAt (mapX u v) (mapY u v)
-- The neighbouring initial fractions are stored fields: inlining the four
-- coverage expressions into one formula multiplied the generated code.
static field initialFilledWest := initialFilledAt (xi-hx) eta
static field initialFilledEast := initialFilledAt (xi+hx) eta
static field initialFilledSouth := initialFilledAt xi (eta-hy)
static field initialFilledNorth := initialFilledAt xi (eta+hy)
static field initialGradX := (initialFilledEast-initialFilledWest)/spanAlongX
static field initialGradY := (initialFilledNorth-initialFilledSouth)/spanAlongY
static field initialShift := packedOffset initialFraction (alignmentWeight initialGradY initialGradX) initialFilledSouth initialFilledNorth (physicalY-mapY xi (eta-hy)) (mapY xi (eta+hy)-physicalY)
static field gaugeReference := mapY xi (eta+hy/2)-level
static field waveGaugeCell := if scenario < 1.5 || scenario > 2.5 then 0 else if absval(physicalX-lengthX/2) < physicalDx then (if physicalY < level && mapY xi (eta+hy) >= level then 1 else 0) else 0
static field initialShore := if bedSlope > 0 then bedStart+level/bedSlope else lengthX
static field initialGround := if periodic > 0.5 then 0 else if eta < 2*hy then 1 else if fittedBed > 0.5 then 0 else if mapY xi (eta-hy) < bedSlope*positive(mapX xi (eta-hy)-bedStart) then 1 else 0
-- launch scales the incoming wave's initial velocity (scenario 4 only). At
-- the default 1 the reference expressions below are used unchanged.
static field initialUx := if scenario > 3.5 && scenario < 4.5 && absval(launch-1) > 0.000000000001 then launch*sqrt(gravity*(stillDepth+amplitude))*bump physicalX/(stillDepth+bump physicalX) else if scenario > 5.5 then 0 else if scenario > 4.5 then speed*sin(2*piValue*physicalY/lengthY) else if scenario < 0.5 then 0 else if scenario < 1.5 then speed else if scenario > 3.5 then sqrt(gravity*(stillDepth+amplitude))*bump physicalX/(stillDepth+bump physicalX) else 0
static field initialUy := if scenario > 3.5 && scenario < 4.5 && absval(launch-1) > 0.000000000001 then launch*2*(smaller physicalY initialHeight)*sqrt(gravity*(stillDepth+amplitude))*stillDepth*(physicalX-waveCenter)*bump physicalX/(waveWidth^2*(stillDepth+bump physicalX)^2) else if scenario > 3.5 && scenario < 4.5 then 2*(smaller physicalY initialHeight)*sqrt(gravity*(stillDepth+amplitude))*stillDepth*(physicalX-waveCenter)*bump physicalX/(waveWidth^2*(stillDepth+bump physicalX)^2) else 0
-- A small standing gravity wave starts with its linear pressure profile,
-- rather than hydrostatic pressure beneath an undulating column. The latter
-- also excites an acoustic adjustment. Other scenarios retain their data.
def normalModeDensity = referenceDensity*(1+3*gravity*amplitude*cos(2*piValue*physicalX/lengthX)*cosh(2*piValue*physicalY/lengthX)/cosh(2*piValue*level/lengthX))
static field initialDensity := if scenario > 4.5 then 1 else if initialFraction < wetFraction then 1 else if scenario < 1.5 then referenceDensity else if scenario < 2.5 then normalModeDensity else exp(3*gravity*(initialHeight-physicalY))

def initialComponent w cx cy = w*initialDensity*(1+3*(cx*initialUx+cy*initialUy)+4.5*(cx*initialUx+cy*initialUy)^2-1.5*(initialUx^2+initialUy^2))+(if scenario > 5.5 && scenario < 6.5 then amplitude*w*cx*cy else 0)
def initial = generateTensor (\[q] -> initialComponent weights_q ex_q ey_q) [9]

def minmod first second = if first*second <= 0 then 0 else if first > 0 then smaller first second else 0-smaller (0-first) (0-second)
def mcSlope back forward = minmod ((back+forward)/2) (2*minmod back forward)
-- method=2 changes only fraction reconstruction. Populations keep MC.
-- method=3 additionally uses constant reconstruction if neither the cell nor
-- any face neighbour is full; an unresolved isolated layer has no resolved
-- interior from which to extrapolate a fraction slope.
-- Symmetric face values still sum to twice the cell value in each axis.
def superbeeSlope back forward = if back >= 0 then bigger (minmod (2*back) forward) (minmod back (2*forward)) else smaller (minmod (2*back) forward) (minmod back (2*forward))
def fractionSlope back forward = if method > 1.5 then superbeeSlope back forward else mcSlope back forward
macro reconstructLeft Q =
  local lower~i @ primal = [|sampleLower(Q,1,0),sampleLower(Q,0,1)|]~i
  local upper~i @ primal = [|sampleUpper(Q,1,0),sampleUpper(Q,0,1)|]~i
  local jump~i @ primal = upper~i-lower~i
  local fullSupport = bigger Q (bigger (bigger (sampleLower(lower~1,0,0)) (sampleUpper(upper~1,0,0))) (bigger (sampleLower(lower~2,0,0)) (sampleUpper(upper~2,0,0))))
  local sx = if method < 0.5 || (method > 2.5 && fullSupport < 0.999) then 0 else fractionSlope (sampleLower(jump~1,0,0)) (sampleUpper(jump~1,0,0))
  local sy = if method < 0.5 || (method > 2.5 && fullSupport < 0.999) then 0 else fractionSlope (sampleLower(jump~2,0,0)) (sampleUpper(jump~2,0,0))
  in lower~i+[|sampleLower(sx,1,0),sampleLower(sy,0,1)|]~i/2
macro reconstructRight Q =
  local lower~i @ primal = [|sampleLower(Q,1,0),sampleLower(Q,0,1)|]~i
  local upper~i @ primal = [|sampleUpper(Q,1,0),sampleUpper(Q,0,1)|]~i
  local jump~i @ primal = upper~i-lower~i
  local fullSupport = bigger Q (bigger (bigger (sampleLower(lower~1,0,0)) (sampleUpper(upper~1,0,0))) (bigger (sampleLower(lower~2,0,0)) (sampleUpper(upper~2,0,0))))
  local sx = if method < 0.5 || (method > 2.5 && fullSupport < 0.999) then 0 else fractionSlope (sampleLower(jump~1,0,0)) (sampleUpper(jump~1,0,0))
  local sy = if method < 0.5 || (method > 2.5 && fullSupport < 0.999) then 0 else fractionSlope (sampleLower(jump~2,0,0)) (sampleUpper(jump~2,0,0))
  in upper~i-[|sampleUpper(sx,1,0),sampleUpper(sy,0,1)|]~i/2
macro populationLeft Q Active =
  -- At a water/air or water/wall boundary, extrapolate the outgoing state
  -- from the liquid interior. The projected air is not a second liquid cell.
  local lower~i_a @ primal = [|sampleLower(Q,1,0),sampleLower(Q,0,1)|]~i_a
  local upper~i_a @ primal = [|sampleUpper(Q,1,0),sampleUpper(Q,0,1)|]~i_a
  local jump~i_a @ primal = upper~i_a-lower~i_a
  local activeLeft~i @ primal = [|sampleLower(Active,1,0),sampleLower(Active,0,1)|]~i
  local activeRight~i @ primal = [|sampleUpper(Active,1,0),sampleUpper(Active,0,1)|]~i
  local activeWest = sampleLower(activeLeft~1,0,0)
  local activeEast = sampleUpper(activeRight~1,0,0)
  local activeSouth = sampleLower(activeLeft~2,0,0)
  local activeNorth = sampleUpper(activeRight~2,0,0)
  local sx_a = if method < 0.5 then 0 else if boundarySlope > 0.5 && Active > 0.5 && activeWest > 0.5 && activeEast < 0.5 then sampleLower(jump~1_a,0,0) else if boundarySlope > 0.5 && Active > 0.5 && activeEast > 0.5 && activeWest < 0.5 then sampleUpper(jump~1_a,0,0) else mcSlope (sampleLower(jump~1_a,0,0)) (sampleUpper(jump~1_a,0,0))
  local sy_a = if method < 0.5 then 0 else if boundarySlope > 0.5 && Active > 0.5 && activeSouth > 0.5 && activeNorth < 0.5 then sampleLower(jump~2_a,0,0) else if boundarySlope > 0.5 && Active > 0.5 && activeNorth > 0.5 && activeSouth < 0.5 then sampleUpper(jump~2_a,0,0) else mcSlope (sampleLower(jump~2_a,0,0)) (sampleUpper(jump~2_a,0,0))
  in lower~i_a+[|sampleLower(sx,1,0),sampleLower(sy,0,1)|]~i_a/2
macro populationRight Q Active =
  local lower~i_a @ primal = [|sampleLower(Q,1,0),sampleLower(Q,0,1)|]~i_a
  local upper~i_a @ primal = [|sampleUpper(Q,1,0),sampleUpper(Q,0,1)|]~i_a
  local jump~i_a @ primal = upper~i_a-lower~i_a
  local activeLeft~i @ primal = [|sampleLower(Active,1,0),sampleLower(Active,0,1)|]~i
  local activeRight~i @ primal = [|sampleUpper(Active,1,0),sampleUpper(Active,0,1)|]~i
  local activeWest = sampleLower(activeLeft~1,0,0)
  local activeEast = sampleUpper(activeRight~1,0,0)
  local activeSouth = sampleLower(activeLeft~2,0,0)
  local activeNorth = sampleUpper(activeRight~2,0,0)
  local sx_a = if method < 0.5 then 0 else if boundarySlope > 0.5 && Active > 0.5 && activeWest > 0.5 && activeEast < 0.5 then sampleLower(jump~1_a,0,0) else if boundarySlope > 0.5 && Active > 0.5 && activeEast > 0.5 && activeWest < 0.5 then sampleUpper(jump~1_a,0,0) else mcSlope (sampleLower(jump~1_a,0,0)) (sampleUpper(jump~1_a,0,0))
  local sy_a = if method < 0.5 then 0 else if boundarySlope > 0.5 && Active > 0.5 && activeSouth > 0.5 && activeNorth < 0.5 then sampleLower(jump~2_a,0,0) else if boundarySlope > 0.5 && Active > 0.5 && activeNorth > 0.5 && activeSouth < 0.5 then sampleUpper(jump~2_a,0,0) else mcSlope (sampleLower(jump~2_a,0,0)) (sampleUpper(jump~2_a,0,0))
  in upper~i_a-[|sampleUpper(sx,1,0),sampleUpper(sy,0,1)|]~i_a/2
-- Neighbour averaging is explicitly a cell/face sampling operation.
macro nearby Q =
  local pair~i @ primal = [|sampleLower(Q,1,0)+sampleUpper(Q,1,0),sampleLower(Q,0,1)+sampleUpper(Q,0,1)|]~i
  in sampleLower(pair~1,0,0)+sampleUpper(pair~1,0,0)+sampleLower(pair~2,0,0)+sampleUpper(pair~2,0,0)

-- A height column ends at the first solid cell. Continuing that solid
-- prevents the four-cell query from wrapping through the outer wall into air.
def extendSolid profile_s wall_s = [|if wall_1 > 0.5 then 1 else profile_1,if wall_1+wall_2 > 0.5 then 1 else profile_2,if wall_1+wall_2+wall_3 > 0.5 then 1 else profile_3,if wall_1+wall_2+wall_3+wall_4 > 0.5 then 1 else profile_4|]

macro columnLeft Q =
  local first~i @ primal = [|sampleLower(Q,1,0),sampleLower(Q,0,1)|]~i
  local horizontal1 = sampleLower(first~1,0,0)
  local vertical1 = sampleLower(first~2,0,0)
  local second~i @ primal = [|sampleLower(horizontal1,1,0),sampleLower(vertical1,0,1)|]~i
  local horizontal2 = sampleLower(second~1,0,0)
  local vertical2 = sampleLower(second~2,0,0)
  local third~i @ primal = [|sampleLower(horizontal2,1,0),sampleLower(vertical2,0,1)|]~i
  local horizontal3 = sampleLower(third~1,0,0)
  local vertical3 = sampleLower(third~2,0,0)
  local fourth~i @ primal = [|sampleLower(horizontal3,1,0),sampleLower(vertical3,0,1)|]~i
  in [|[|first~1,second~1,third~1,fourth~1|],[|first~2,second~2,third~2,fourth~2|]|]~i_s
macro columnRight Q =
  local first~i @ primal = [|sampleUpper(Q,1,0),sampleUpper(Q,0,1)|]~i
  local horizontal1 = sampleUpper(first~1,0,0)
  local vertical1 = sampleUpper(first~2,0,0)
  local second~i @ primal = [|sampleUpper(horizontal1,1,0),sampleUpper(vertical1,0,1)|]~i
  local horizontal2 = sampleUpper(second~1,0,0)
  local vertical2 = sampleUpper(second~2,0,0)
  local third~i @ primal = [|sampleUpper(horizontal2,1,0),sampleUpper(vertical2,0,1)|]~i
  local horizontal3 = sampleUpper(third~1,0,0)
  local vertical3 = sampleUpper(third~2,0,0)
  local fourth~i @ primal = [|sampleUpper(horizontal3,1,0),sampleUpper(vertical3,0,1)|]~i
  in [|[|first~1,second~1,third~1,fourth~1|],[|first~2,second~2,third~2,fourth~2|]|]~i_s

field h_a
field candidate_a
field candidateWater
field original_a
field water
field waterOriginal
field originalFraction
field stage
field estimatedHeight
field estimatedHeightValid
field estimatedHeightSense
field estimatedPressureSlope
field faceFractionWest
field faceFractionEast
field faceFractionSouth
field faceFractionNorth
field elapsed
field fraction
field density
field velocityX
field velocityY
field waterMass
field waterVolume
field lowest
field highest
field densityLowest
field densityHighest
field populationLowest
field peakSpeed
field restingError
field wetting
field drying
field movedAmount
field waterMomentumX
field waterMomentumY
field kineticEnergy
field surfaceHeight
field wetFront
field shoreFlux
field minimumArea
field overhangCells
field bulkFront
field fractionCourant
field pressureResidual
field surfaceMassResidual
field expectedFallingMomentum
field expectedFallingCentroid
field waveMoment
field gravityEnergy
field waterCentroidX
field waterCentroidY
field resolvedCentroidY
field collisionResidual
field stateConsistencyError
field thinFront
field shoreWaterMass
field thinWaterMass
field surfaceGauge
field firstCrossing
field wavePeriod
field expectedPeriod
field heightReconstructions
field surfaceReconstructions
field wallMassResidual
field wallSlipResidual
field relaxationError
field shearError
field shearProjection
field shearExpected
init:
  h_a := (initial)_a-weights_a*referenceDensity
  candidate_a := (initial)_a-weights_a*referenceDensity
  candidateWater := initialFraction*initialDensity
  original_a := (initial)_a-weights_a*referenceDensity
  water := initialFraction*initialDensity
  waterOriginal := initialFraction*initialDensity
  originalFraction := initialFraction
  stage := 0
  estimatedHeight := 0
  estimatedHeightValid := 0
  estimatedHeightSense := 0
  estimatedPressureSlope := 0-3*gravity
  faceFractionWest := 0
  faceFractionEast := 0
  faceFractionSouth := 0
  faceFractionNorth := 0
  elapsed := 0
  fraction := initialFraction
  density := initialDensity
  velocityX := initialUx
  velocityY := initialUy
  waterMass := cell*volumeCell*water
  waterVolume := cell*volumeCell*initialFraction
  lowest := initialFraction
  highest := initialFraction
  densityLowest := initialDensity
  densityHighest := initialDensity
  populationLowest := minPopulation ((initial)_a/weights_a)
  peakSpeed := if initialFraction >= wetFraction then sqrt(initialUx^2+initialUy^2) else 0
  restingError := 0
  wetting := 0
  drying := 0
  movedAmount := 0
  waterMomentumX := cell*volumeCell*water*initialUx
  waterMomentumY := cell*volumeCell*water*initialUy
  kineticEnergy := cell*volumeCell*water*(initialUx^2+initialUy^2)/2
  surfaceHeight := if initialFraction > 0.5 then physicalY else 0
  wetFront := if initialFraction > 0.5 && initialGround > 0.5 then physicalX else 0
  shoreFlux := 0
  minimumArea := cell*volumeCell
  overhangCells := 0
  bulkFront := if initialFraction >= 0.5 && initialTopFraction >= 0.5 && initialGround > 0.5 then physicalX else 0
  fractionCourant := 0
  pressureResidual := 0
  surfaceMassResidual := 0
  expectedFallingMomentum := 0
  expectedFallingCentroid := if scenario > 6.5 then cell*volumeCell*initialFraction*physicalY else 0
  waveMoment := cell*volumeCell*initialFraction*cos(2*piValue*physicalX/lengthX)
  gravityEnergy := cell*volumeCell*water*gravity*physicalY
  waterCentroidX := cell*volumeCell*water*physicalX
  waterCentroidY := cell*volumeCell*water*physicalY
  resolvedCentroidY := cell*volumeCell*water*(physicalY+initialShift)
  collisionResidual := 0
  stateConsistencyError := 0
  thinFront := if initialFraction > 0.01 && initialGround > 0.5 then physicalX else 0
  shoreWaterMass := if physicalX > initialShore then cell*volumeCell*water else 0
  thinWaterMass := if initialFraction > 0 && initialFraction < 0.5 then cell*volumeCell*water else 0
  surfaceGauge := 0
  firstCrossing := 0
  wavePeriod := 0
  expectedPeriod := if gravity > 0 then 2*piValue/sqrt(gravity*(2*piValue/lengthX)*(exp(4*piValue*level/lengthX)-1)/(exp(4*piValue*level/lengthX)+1)) else 0
  heightReconstructions := 0
  surfaceReconstructions := 0
  wallMassResidual := 0
  wallSlipResidual := 0
  relaxationError := 0
  shearError := 0
  shearProjection := if scenario > 4.5 && scenario < 5.5 then 2*cell*volumeCell*initialUx*sin(2*piValue*physicalY/lengthY)/(lengthX*lengthY) else 0
  shearExpected := if scenario > 4.5 && scenario < 5.5 then speed else 0
step:
  -- Predictor and corrector each use four generated phases: estimate
  -- surface heights, form the right-hand side, solve collision/project air,
  -- and refresh moments. Height estimates are cached once per stage.
  -- collisionImplicit=0 retains explicit SSPRK2. The implicit option uses
  -- an Euler predictor and a trapezoidal corrector for BGK collision,
  -- with explicit Heun transport and force. Collision conserves moments,
  -- so its nonlinear equilibrium is known from the stored right-hand side.
