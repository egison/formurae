  density' = if refreshing > 0.5 then observedRho else density
  fraction' = if refreshing > 0.5 then observedFraction else fraction
  velocityX' = if refreshing > 0.5 then observedUx else velocityX
  velocityY' = if refreshing > 0.5 then observedUy else velocityY
  waterMass' = cell*volumeCell*water
  waterVolume' = cell*volumeCell*observedFraction
  lowest' = smaller lowest observedFraction
  highest' = bigger highest observedFraction
  densityLowest' = smaller densityLowest observedRho
  densityHighest' = bigger densityHighest observedRho
  populationLowest' = smaller populationLowest (minPopulation ((h_a+weights_a*referenceDensity)/weights_a))
  peakSpeed' = bigger peakSpeed (if observedFraction >= wetFraction then sqrt(observedUx^2+observedUy^2) else 0)
  restingError' = bigger restingError (if observedFraction >= wetFraction then bigger (absval(observedRho-referenceDensity)) (sqrt(observedUx^2+observedUy^2)) else 0)
  local alphaOriginal = originalFraction
  wetting' = wetting+(if stage > 6.5 then (if alphaOriginal < wetFraction then (if observedFraction >= wetFraction then 1 else 0) else 0) else 0)
  drying' = drying+(if stage > 6.5 then (if alphaOriginal >= wetFraction then (if observedFraction < wetFraction then 1 else 0) else 0) else 0)
  movedAmount' = cell*volumeCell*absval(observedFraction-initialFraction)
  waterMomentumX' = cell*volumeCell*water*observedUx
  waterMomentumY' = cell*volumeCell*water*observedUy
  kineticEnergy' = cell*volumeCell*water*(observedUx^2+observedUy^2)/2
  surfaceHeight' = if observedFraction >= 0.5 then physicalY else 0
  local groundFace~i @ primal = [|sampleLower(solid,1,0),sampleLower(solid,0,1)|]~i
  local ground = sampleLower(groundFace~2,0,0)
  wetFront' = if observedFraction >= 0.5 && ground > 0.5 then physicalX else 0
  thinFront' = if observedFraction > 0.01 && ground > 0.5 then physicalX else 0
  shoreWaterMass' = if physicalX > initialShore then cell*volumeCell*water else 0
  thinWaterMass' = if observedFraction > 0 && observedFraction < 0.5 then cell*volumeCell*water else 0
  shoreFlux' = if absval(physicalX-bedStart) < physicalDx/2 then cell*volumeCell*water*observedUx/physicalDx else 0
  minimumArea' = cell*volumeCell
  local alphaAboveFace~i @ primal = [|sampleUpper(observedFraction,1,0),sampleUpper(observedFraction,0,1)|]~i
  local alphaAbove = sampleUpper(alphaAboveFace~2,0,0)
  local verticalFractionGradient = (tangentXX*∂_y observedFraction-tangentXY*∂_x observedFraction)/volumeCell
  local wallNeighbours = nearby solid
  overhangCells' = if wallNeighbours < 0.5 && solid < 0.5 && observedFraction > 0.05 && observedFraction < 0.95 && verticalFractionGradient > 0.000001 then 1 else 0
  bulkFront' = if observedFraction >= 0.5 && alphaAbove >= 0.5 && ground > 0.5 then physicalX else 0
  -- Gauges sample complete physical states at the start of a timestep.
  local gaugeNow = sampleUpper((columnSum~2-4)*centerDeltaY~2,0,0)+gaugeReference
  surfaceGauge' = if stage < 0.5 then (if waveGaugeCell > 0.5 then gaugeNow else 0) else surfaceGauge
  local crossingTime = if absval(gaugeNow-surfaceGauge) > 0.00000000000001 then elapsed-dt*gaugeNow/(gaugeNow-surfaceGauge) else elapsed
  firstCrossing' = if stage < 0.5 && waveGaugeCell > 0.5 && firstCrossing < 0.000000000001 && surfaceGauge < 0 && gaugeNow >= 0 then crossingTime else firstCrossing
  wavePeriod' = if stage < 0.5 && waveGaugeCell > 0.5 && firstCrossing > 0 && wavePeriod < 0.000000000001 && surfaceGauge > 0 && gaugeNow <= 0 then 2*(crossingTime-firstCrossing) else wavePeriod
  expectedPeriod' = expectedPeriod
  local outRight = positive(sampleUpper(massFlux~1,0,0))/hx
  local outLeft = positive(0-sampleLower(massFlux~1,0,0))/hx
  local outTop = positive(sampleUpper(massFlux~2,0,0))/hy
  local outBottom = positive(0-sampleLower(massFlux~2,0,0))/hy
  fractionCourant' = if preparing > 0.5 then bigger fractionCourant (4*dt*bigger (bigger outRight outLeft) (bigger outTop outBottom)/(volumeCell*rho)) else fractionCourant
  local normalVelocity~i @ primal = uxBoundary~i*B~i_2+uyBoundary~i*B~i_4
  local freeMassError~i @ primal = freeFace~i*absval(massFlux~i-atmosphericDensity~i*normalVelocity~i)
  surfaceMassResidual' = if preparing > 0.5 then bigger surfaceMassResidual (bigger (sampleUpper(freeMassError~1,0,0)) (sampleUpper(freeMassError~2,0,0))) else surfaceMassResidual
  local momentumFluxX~i @ primal = kineticFlux~i_a . ex~a
  local momentumFluxY~i @ primal = kineticFlux~i_a . ey~a
  local stressX~i @ primal = momentumFluxX~i-(atmosphericDensity~i-faceReference~i)*B~i_2/3-atmosphericDensity~i*uxBoundary~i*normalVelocity~i
  local stressY~i @ primal = momentumFluxY~i-(atmosphericDensity~i-faceReference~i)*B~i_4/3-atmosphericDensity~i*uyBoundary~i*normalVelocity~i
  local stressError~i @ primal = [|if solidL~1+solidR~1 < 0.5 && wetL~1+wetR~1 > 0.5 && wetL~1+wetR~1 < 1.5 then bigger (absval(stressX~1)) (absval(stressY~1)) else 0,if solidL~2+solidR~2 < 0.5 && wetL~2+wetR~2 > 0.5 && wetL~2+wetR~2 < 1.5 then bigger (absval(stressX~2)) (absval(stressY~2)) else 0|]~i
  pressureResidual' = if preparing > 0.5 then bigger pressureResidual (bigger (sampleUpper(stressError~1,0,0)) (sampleUpper(stressError~2,0,0))) else pressureResidual
  waveMoment' = cell*volumeCell*observedFraction*cos(2*piValue*physicalX/lengthX)
  local fallingTime = elapsed+(if stage > 6.5 then dt else 0)
  expectedFallingMomentum' = if scenario > 6.5 then (0-gravity*fallingTime)*cell*volumeCell*initialFraction else 0
  expectedFallingCentroid' = if scenario > 6.5 then cell*volumeCell*initialFraction*(physicalY-gravity*fallingTime^2/2) else 0
  gravityEnergy' = cell*volumeCell*water*gravity*physicalY
  waterCentroidX' = cell*volumeCell*water*physicalX
  waterCentroidY' = cell*volumeCell*water*physicalY
  local packedShift = if solid > 0.5 then 0 else packedOffset alpha alongY filledSouth filledNorth (sampleLower(centerDeltaY~2,0,0)) (sampleUpper(centerDeltaY~2,0,0))
  resolvedCentroidY' = cell*volumeCell*water*(physicalY+packedShift)
  collisionResidual' = if preparing > 0.5 then bigger collisionResidual (absval(ones~a . (feq_a-weights_a*referenceDensity-h_a))) else collisionResidual
  local stateRhoError = absval(density-referenceDensity-(ones~a . h_a))
  local stateWaterError = absval(water-fraction*density)
  local stateVelocityError = bigger (absval(density*velocityX-(ex~a . h_a))) (absval(density*velocityY-(ey~a . h_a)))
  stateConsistencyError' = if preparing > 0.5 then bigger stateConsistencyError (bigger stateRhoError (bigger stateWaterError stateVelocityError)) else stateConsistencyError

  local surfaceFace~i @ primal = [|if solidL~1+solidR~1 < 0.5 && wetL~1+wetR~1 > 0.5 && wetL~1+wetR~1 < 1.5 then 1-solidL~1 else 0,if solidL~2+solidR~2 < 0.5 && wetL~2+wetR~2 > 0.5 && wetL~2+wetR~2 < 1.5 then 1-solidL~2 else 0|]~i
  surfaceReconstructions' = surfaceReconstructions+(if preparing > 0.5 then sampleUpper(surfaceFace~1,0,0)+sampleUpper(surfaceFace~2,0,0) else 0)
  heightReconstructions' = heightReconstructions+(if preparing > 0.5 && heightMethod > 0.5 then sampleUpper(surfaceFace~1*usableColumn~1,0,0)+sampleUpper(surfaceFace~2*usableColumn~2,0,0) else 0)
  local wallShear~i @ primal = (kineticFlux~i_a*wallTangent~i_a) . ones~a
  local wallMassError~i @ primal = [|if solidL~1+solidR~1 > 0.5 && solidL~1+solidR~1 < 1.5 then absval(rawMassFlux~1) else 0,if solidL~2+solidR~2 > 0.5 && solidL~2+solidR~2 < 1.5 then absval(rawMassFlux~2) else 0|]~i
  local wallShearError~i @ primal = [|if solidL~1+solidR~1 > 0.5 && solidL~1+solidR~1 < 1.5 then absval(wallShear~1)/(B~1_2^2+B~1_4^2) else 0,if solidL~2+solidR~2 > 0.5 && solidL~2+solidR~2 < 1.5 then absval(wallShear~2)/(B~2_2^2+B~2_4^2) else 0|]~i
  wallMassResidual' = if preparing > 0.5 then bigger wallMassResidual (bigger (sampleUpper(wallMassError~1,0,0)) (sampleUpper(wallMassError~2,0,0))) else wallMassResidual
  wallSlipResidual' = if preparing > 0.5 && wallSlip > 0.5 then bigger wallSlipResidual (bigger (sampleUpper(wallShearError~1,0,0)) (sampleUpper(wallShearError~2,0,0))) else wallSlipResidual

  -- Independent continuous-time references for collision and a weak shear wave.
  -- Compare only complete physical states; the final refresh advances time by dt.
  local shearAmplitude = speed*exp(0-tau*(2*piValue/lengthY)^2*(elapsed+dt)/3)
  relaxationError' = if stage > 6.5 && scenario > 5.5 && scenario < 6.5 then absval(((ex~a*ey~a) . h_a)-amplitude*exp(0-(elapsed+dt)/tau)/9) else relaxationError
  shearError' = if stage > 6.5 && scenario > 4.5 && scenario < 5.5 then absval(observedUx-shearAmplitude*sin(2*piValue*physicalY/lengthY)) else shearError
  shearProjection' = if stage > 6.5 && scenario > 4.5 && scenario < 5.5 then 2*cell*volumeCell*observedUx*sin(2*piValue*physicalY/lengthY)/(lengthX*lengthY) else shearProjection
  shearExpected' = if stage > 6.5 && scenario > 4.5 && scenario < 5.5 then shearAmplitude else shearExpected
