-- Continuous-time D2Q9 with gravity and reflecting horizontal walls.
-- balanced=1 stores f-fH; balanced=0 is the ordinary full-f control.
-- scenario=0: rest; 1: density perturbation; 2: horizontal acceleration.
-- Two guard rows put BOTH wall faces in stored slots (see README).
dimension 2
axes x, y
index a : 9
index p : 2
param warpX = 0.2
param warpY = 0.15
param balanced = 1
param scenario = 0
param timeScale = 1
param gravity = 0.01
param amplitude = 0.001
param tau = 0.16
param extent = 6.283185307179586
param gauss = 0.5773502691896258
param hx = dx
param hy = dy
param dt = timeScale*0.1*hx*hy/(hx+hy)
param cell = hx*hy
param domainArea = extent*extent
extern sin
extern cos
extern exp
extern hydrostaticConfig

def mapX u v = u+warpX*sin(u)*sin(v)
def mapY u v = v+warpY*sin(u)*sin(v)
-- Physical computational coordinates: fluid centers occupy (0,extent)^2.
def xi = x+hx/2
def eta = y-hy/2
def inside = if eta > 0 && eta < extent then 1 else 0
def bottomFace = if eta < hy/4 then 1 else 0
def topFace = if eta > extent-hy/4 then 1 else 0
def boundaryCell = if eta < hy || eta > extent-hy then 1 else 0
def weights = [| 4/9,1/9,1/9,1/9,1/9,1/36,1/36,1/36,1/36 |]
def ex = [| 0,1,-1,0,0,1,-1,1,-1 |]
def ey = [| 0,0,0,1,-1,1,-1,-1,1 |]
def ones = [| 1,1,1,1,1,1,1,1,1 |]
def frame = generateTensor (\[k,q] -> if k = 1 then ex_q else ey_q) [2,9]
def forceX = if scenario > 1.5 then 0.001 else 0
def acceleration = [| forceX, 0-gravity |]
def smaller first second = if first < second then first else second
def bigger first second = if first > second then first else second
def maxPopulation T_a = bigger (bigger (bigger (T_1) (T_2)) (bigger (T_3) (T_4))) (bigger (bigger (T_5) (T_6)) (bigger (T_7) (bigger (T_8) (T_9))))
def minPopulation T_a = 0-maxPopulation (0-T_a)
def absval v = if v >= 0 then v else 0-v
def minmod first second = if first*second <= 0 then 0 else if first > 0 then smaller first second else 0-smaller (0-first) (0-second)
def mcSlope back forward = minmod ((back+forward)/2) (2*minmod back forward)
-- Specular reflection: reverse the physical vertical velocity only.
def reflectY T_a = [| T_1,T_2,T_3,T_5,T_4,T_8,T_9,T_6,T_7 |]

def areaDensity = 1+warpX*(2*sin(hx/2)/hx)*cos(hy/2)*cos(xi)*sin(eta)+warpY*(2*sin(hy/2)/hy)*cos(hx/2)*sin(xi)*cos(eta)
static field volumeCell := areaDensity
def faceX cx cy = ((mapY xi (eta+hy/2)-mapY xi (eta-hy/2))*cx-(mapX xi (eta+hy/2)-mapX xi (eta-hy/2))*cy)/hy
def faceY cx cy = if bottomFace+topFace > 0.5 then cy else ((mapX (xi+hx/2) eta-mapX (xi-hx/2) eta)*cy-(mapY (xi+hx/2) eta-mapY (xi-hx/2) eta)*cx)/hx
def speeds = generateTensor (\[k,q] -> if k = 1 then faceX ex_q ey_q else faceY ex_q ey_q) [2,9]
static field B~i_a @ primal := (speeds)~i_a
-- Bilinear polygon coordinates and four-point Gaussian cell quadrature.
def mapMean = sin(xi)*cos(hx/2)*sin(eta)*cos(hy/2)
def mapXi = cos(xi)*sin(hx/2)*sin(eta)*cos(hy/2)
def mapEta = sin(xi)*cos(hx/2)*cos(eta)*sin(hy/2)
def mapXiEta = cos(xi)*sin(hx/2)*cos(eta)*sin(hy/2)
def quadMap first second = mapMean+mapXi*first+mapEta*second+mapXiEta*first*second
def quadX first second = xi+hx*first/2+warpX*quadMap first second
def quadY first second = eta+hy*second/2+warpY*quadMap first second
def quadJacobian first second = cell/4+warpX*hy*(mapXi+mapXiEta*second)/2+warpY*hx*(mapEta+mapXiEta*first)/2
def cellAverage fn = (quadJacobian gauss gauss*fn(quadX gauss gauss)(quadY gauss gauss)+quadJacobian (0-gauss) gauss*fn(quadX (0-gauss) gauss)(quadY (0-gauss) gauss)+quadJacobian gauss (0-gauss)*fn(quadX gauss (0-gauss))(quadY gauss (0-gauss))+quadJacobian (0-gauss) (0-gauss)*fn(quadX (0-gauss) (0-gauss))(quadY (0-gauss) (0-gauss)))/(cell*areaDensity)
def hydrostaticDensity xx yy = exp((0-3*gravity)*yy)
def wave xx yy = cos(xx)*cos(yy)
def densityWave xx yy = hydrostaticDensity xx yy*wave xx yy
static field rhoH := cellAverage hydrostaticDensity
static field waveMean := cellAverage wave
static field waveDensity := cellAverage densityWave
def background = balanced*rhoH
def initialDeviation = if scenario > 0.5 && scenario < 1.5 then amplitude*waveDensity else 0
def initialDensity = rhoH+initialDeviation
def initial = weights_a*((1-balanced)*rhoH+initialDeviation)

macro numericalFlux Q =
  local lower~i_a @ primal = [| sampleLower(Q,1,0), sampleLower(Q,0,1) |]~i_a
  local upper~i_a @ primal = [| sampleUpper(Q,1,0), sampleUpper(Q,0,1) |]~i_a
  local jump~i_a @ primal = upper~i_a-lower~i_a
  local backwardX_a = sampleLower(jump~1_a,0,0)
  local forwardX_a = sampleUpper(jump~1_a,0,0)
  local backwardY_a = sampleLower(jump~2_a,0,0)
  local forwardY_a = sampleUpper(jump~2_a,0,0)
  local slopeX_a = mcSlope backwardX_a forwardX_a
  -- Constant reconstruction next to walls; interior uses limited slopes.
  local slopeY_a = if boundaryCell > 0.5 then 0 else mcSlope backwardY_a forwardY_a
  local left~i_a @ primal = lower~i_a+[| sampleLower(slopeX,1,0), sampleLower(slopeY,0,1) |]~i_a/2
  local right~i_a @ primal = upper~i_a-[| sampleUpper(slopeX,1,0), sampleUpper(slopeY,0,1) |]~i_a/2
  local wallLeft~i_a @ primal = [| left~1_a, if bottomFace > 0.5 then (reflectY (right~2_a))_a else left~2_a |]~i_a
  local wallRight~i_a @ primal = [| right~1_a, if topFace > 0.5 then (reflectY (left~2_a))_a else right~2_a |]~i_a
  in (B~i_a*(wallLeft~i_a+wallRight~i_a)-absval(B~i_a)*(wallRight~i_a-wallLeft~i_a))/2

field f_a
field original_a
field stage
field elapsed
field mass
field momentumX
field momentumY
field speed
field densityError
field densityMode
field accelerationError
field lowest
field equilibriumLowest
field collisionResidual
field forceResidual
field wallMassFlux
field wallTangentialFlux
field minArea
init:
  f_a := (initial)_a
  original_a := (initial)_a
  stage := 0
  elapsed := 0
  mass := inside*cell*volumeCell*initialDensity/domainArea
  momentumX := 0
  momentumY := 0
  speed := 0
  densityError := inside*absval(initialDeviation)
  densityMode := inside*cell*volumeCell*initialDeviation*waveMean/domainArea
  accelerationError := 0
  lowest := if inside > 0.5 then initialDensity else 10
  equilibriumLowest := if inside > 0.5 then initialDensity else 10
  collisionResidual := 0
  forceResidual := 0
  wallMassFlux := 0
  wallTangentialFlux := 0
  minArea := if inside > 0.5 then cell*volumeCell else 10
step:
  local flux~i_a @ primal = numericalFlux f
  local advection_a = (0-∂_i flux~i_a)/volumeCell
  -- Algebraically the usual BGK equilibrium, with the static part removed.
  local deltaRho = ones~a . f_a
  local rho = background+deltaRho
  local momentum~p = frame~p~a . f_a
  local u~p = momentum~p/rho
  local cu_a = frame_p_a . u~p
  local uu = u~p . u_p
  local feq_a = weights_a*(deltaRho+rho*(3*cu_a+(9/2)*cu_a^2-(3/2)*uu))
  local collision_a = (feq_a-f_a)/tau
  -- Continuous-time force: no stream-LBM prefactor or half-step velocity shift.
  local cg_a = frame_p_a . acceleration~p
  local ug = u_p . acceleration~p
  local source_a = weights_a*(3*(deltaRho*ey_a*(0-gravity)+rho*ex_a*forceX)+rho*(9*cu_a*cg_a-3*ug))
  local euler_a = f_a+dt*(advection_a+collision_a+source_a)
  original'_a = if stage < 0.5 then f_a else original_a
  f'_a = if inside < 0.5 then (initial)_a else if stage < 0.5 then euler_a else (original_a+euler_a)/2
  stage' = if stage < 0.5 then 1 else 0
  elapsed' = if stage < 0.5 then elapsed else elapsed+dt
  local newRho = background+(ones~a . f'_a)
  local newMx = ex~a . f'_a
  local newMy = ey~a . f'_a
  local measure = inside*cell*volumeCell/domainArea
  mass' = measure*newRho
  momentumX' = measure*newMx
  momentumY' = measure*newMy
  speed' = inside*bigger (absval(newMx/newRho)) (absval(newMy/newRho))
  densityError' = inside*absval(newRho-rhoH)
  densityMode' = if stage < 0.5 then densityMode else measure*(newRho-rhoH)*waveMean
  accelerationError' = if stage < 0.5 then accelerationError else measure*(newMx-newRho*forceX*elapsed')
  local low = smaller (minPopulation (f'_a/weights_a+background)) (minPopulation (euler_a/weights_a+background))
  lowest' = if inside < 0.5 then 10 else smaller lowest low
  equilibriumLowest' = if inside < 0.5 then 10 else smaller equilibriumLowest (minPopulation (feq_a/weights_a+background))
  local collisionCheck = bigger (absval(ones~a . collision_a)) (bigger (absval(ex~a . collision_a)) (absval(ey~a . collision_a)))
  collisionResidual' = bigger collisionResidual (inside*collisionCheck)
  local forceCheck = bigger (absval(ones~a . source_a)) (bigger (absval((ex~a . source_a)-rho*forceX)) (absval((ey~a . source_a)+gravity*deltaRho)))
  forceResidual' = bigger forceResidual (inside*forceCheck)
  local lowerWall_a = sampleLower(flux~2_a,0,0)
  local upperWall_a = sampleUpper(flux~2_a,0,0)
  local wall_a = if eta < hy then lowerWall_a else if eta > extent-hy then upperWall_a else 0
  wallMassFlux' = bigger wallMassFlux (inside*absval(ones~a . wall_a))
  wallTangentialFlux' = bigger wallTangentialFlux (inside*absval(ex~a . wall_a))
  minArea' = if inside > 0.5 then cell*volumeCell else 10
