  flux_up2_down1[i,j] = (-1 / 2) * wallRight_up2_down1[i,j] * (if B_up2_down1[i,j] >= 0 then B_up2_down1[i,j] else (-1) * B_up2_down1[i,j]) + (1 / 2) * B_up2_down1[i,j] * wallLeft_up2_down1[i,j] + (1 / 2) * B_up2_down1[i,j] * wallRight_up2_down1[i,j] + (1 / 2) * wallLeft_up2_down1[i,j] * (if B_up2_down1[i,j] >= 0 then B_up2_down1[i,j] else (-1) * B_up2_down1[i,j])
  flux_up2_down2[i,j] = (-1 / 2) * wallRight_up2_down2[i,j] * (if B_up2_down2[i,j] >= 0 then B_up2_down2[i,j] else (-1) * B_up2_down2[i,j]) + (1 / 2) * B_up2_down2[i,j] * wallLeft_up2_down2[i,j] + (1 / 2) * B_up2_down2[i,j] * wallRight_up2_down2[i,j] + (1 / 2) * wallLeft_up2_down2[i,j] * (if B_up2_down2[i,j] >= 0 then B_up2_down2[i,j] else (-1) * B_up2_down2[i,j])
  flux_up2_down3[i,j] = (-1 / 2) * wallRight_up2_down3[i,j] * (if B_up2_down3[i,j] >= 0 then B_up2_down3[i,j] else (-1) * B_up2_down3[i,j]) + (1 / 2) * B_up2_down3[i,j] * wallLeft_up2_down3[i,j] + (1 / 2) * B_up2_down3[i,j] * wallRight_up2_down3[i,j] + (1 / 2) * wallLeft_up2_down3[i,j] * (if B_up2_down3[i,j] >= 0 then B_up2_down3[i,j] else (-1) * B_up2_down3[i,j])
  flux_up2_down4[i,j] = (-1 / 2) * wallRight_up2_down4[i,j] * (if B_up2_down4[i,j] >= 0 then B_up2_down4[i,j] else (-1) * B_up2_down4[i,j]) + (1 / 2) * B_up2_down4[i,j] * wallLeft_up2_down4[i,j] + (1 / 2) * B_up2_down4[i,j] * wallRight_up2_down4[i,j] + (1 / 2) * wallLeft_up2_down4[i,j] * (if B_up2_down4[i,j] >= 0 then B_up2_down4[i,j] else (-1) * B_up2_down4[i,j])
  flux_up2_down5[i,j] = (-1 / 2) * wallRight_up2_down5[i,j] * (if B_up2_down5[i,j] >= 0 then B_up2_down5[i,j] else (-1) * B_up2_down5[i,j]) + (1 / 2) * B_up2_down5[i,j] * wallLeft_up2_down5[i,j] + (1 / 2) * B_up2_down5[i,j] * wallRight_up2_down5[i,j] + (1 / 2) * wallLeft_up2_down5[i,j] * (if B_up2_down5[i,j] >= 0 then B_up2_down5[i,j] else (-1) * B_up2_down5[i,j])
  flux_up2_down6[i,j] = (-1 / 2) * wallRight_up2_down6[i,j] * (if B_up2_down6[i,j] >= 0 then B_up2_down6[i,j] else (-1) * B_up2_down6[i,j]) + (1 / 2) * B_up2_down6[i,j] * wallLeft_up2_down6[i,j] + (1 / 2) * B_up2_down6[i,j] * wallRight_up2_down6[i,j] + (1 / 2) * wallLeft_up2_down6[i,j] * (if B_up2_down6[i,j] >= 0 then B_up2_down6[i,j] else (-1) * B_up2_down6[i,j])
  flux_up2_down7[i,j] = (-1 / 2) * wallRight_up2_down7[i,j] * (if B_up2_down7[i,j] >= 0 then B_up2_down7[i,j] else (-1) * B_up2_down7[i,j]) + (1 / 2) * B_up2_down7[i,j] * wallLeft_up2_down7[i,j] + (1 / 2) * B_up2_down7[i,j] * wallRight_up2_down7[i,j] + (1 / 2) * wallLeft_up2_down7[i,j] * (if B_up2_down7[i,j] >= 0 then B_up2_down7[i,j] else (-1) * B_up2_down7[i,j])
  flux_up2_down8[i,j] = (-1 / 2) * wallRight_up2_down8[i,j] * (if B_up2_down8[i,j] >= 0 then B_up2_down8[i,j] else (-1) * B_up2_down8[i,j]) + (1 / 2) * B_up2_down8[i,j] * wallLeft_up2_down8[i,j] + (1 / 2) * B_up2_down8[i,j] * wallRight_up2_down8[i,j] + (1 / 2) * wallLeft_up2_down8[i,j] * (if B_up2_down8[i,j] >= 0 then B_up2_down8[i,j] else (-1) * B_up2_down8[i,j])
  flux_up2_down9[i,j] = (-1 / 2) * wallRight_up2_down9[i,j] * (if B_up2_down9[i,j] >= 0 then B_up2_down9[i,j] else (-1) * B_up2_down9[i,j]) + (1 / 2) * B_up2_down9[i,j] * wallLeft_up2_down9[i,j] + (1 / 2) * B_up2_down9[i,j] * wallRight_up2_down9[i,j] + (1 / 2) * wallLeft_up2_down9[i,j] * (if B_up2_down9[i,j] >= 0 then B_up2_down9[i,j] else (-1) * B_up2_down9[i,j])
  advection_down1[i,j] = (-1) * (flux_up1_down1[i,j] + (-1) * flux_up1_down1[i-1,j]) / dx * volumeCell[i,j]**(-1) + (-1) * (flux_up2_down1[i,j] + (-1) * flux_up2_down1[i,j-1]) / dy * volumeCell[i,j]**(-1)
  advection_down2[i,j] = (-1) * (flux_up1_down2[i,j] + (-1) * flux_up1_down2[i-1,j]) / dx * volumeCell[i,j]**(-1) + (-1) * (flux_up2_down2[i,j] + (-1) * flux_up2_down2[i,j-1]) / dy * volumeCell[i,j]**(-1)
  advection_down3[i,j] = (-1) * (flux_up1_down3[i,j] + (-1) * flux_up1_down3[i-1,j]) / dx * volumeCell[i,j]**(-1) + (-1) * (flux_up2_down3[i,j] + (-1) * flux_up2_down3[i,j-1]) / dy * volumeCell[i,j]**(-1)
  advection_down4[i,j] = (-1) * (flux_up1_down4[i,j] + (-1) * flux_up1_down4[i-1,j]) / dx * volumeCell[i,j]**(-1) + (-1) * (flux_up2_down4[i,j] + (-1) * flux_up2_down4[i,j-1]) / dy * volumeCell[i,j]**(-1)
  advection_down5[i,j] = (-1) * (flux_up1_down5[i,j] + (-1) * flux_up1_down5[i-1,j]) / dx * volumeCell[i,j]**(-1) + (-1) * (flux_up2_down5[i,j] + (-1) * flux_up2_down5[i,j-1]) / dy * volumeCell[i,j]**(-1)
  advection_down6[i,j] = (-1) * (flux_up1_down6[i,j] + (-1) * flux_up1_down6[i-1,j]) / dx * volumeCell[i,j]**(-1) + (-1) * (flux_up2_down6[i,j] + (-1) * flux_up2_down6[i,j-1]) / dy * volumeCell[i,j]**(-1)
  advection_down7[i,j] = (-1) * (flux_up1_down7[i,j] + (-1) * flux_up1_down7[i-1,j]) / dx * volumeCell[i,j]**(-1) + (-1) * (flux_up2_down7[i,j] + (-1) * flux_up2_down7[i,j-1]) / dy * volumeCell[i,j]**(-1)
  advection_down8[i,j] = (-1) * (flux_up1_down8[i,j] + (-1) * flux_up1_down8[i-1,j]) / dx * volumeCell[i,j]**(-1) + (-1) * (flux_up2_down8[i,j] + (-1) * flux_up2_down8[i,j-1]) / dy * volumeCell[i,j]**(-1)
  advection_down9[i,j] = (-1) * (flux_up1_down9[i,j] + (-1) * flux_up1_down9[i-1,j]) / dx * volumeCell[i,j]**(-1) + (-1) * (flux_up2_down9[i,j] + (-1) * flux_up2_down9[i,j-1]) / dy * volumeCell[i,j]**(-1)
  deltaRho[i,j] = f_down1[i,j] + f_down2[i,j] + f_down3[i,j] + f_down4[i,j] + f_down5[i,j] + f_down6[i,j] + f_down7[i,j] + f_down8[i,j] + f_down9[i,j]
  rho[i,j] = deltaRho[i,j] + balanced * rhoH[i,j]
  momentum_up1[i,j] = f_down2[i,j] + f_down6[i,j] + f_down8[i,j] + (-1) * f_down3[i,j] + (-1) * f_down7[i,j] + (-1) * f_down9[i,j]
  momentum_up2[i,j] = f_down4[i,j] + f_down6[i,j] + f_down9[i,j] + (-1) * f_down5[i,j] + (-1) * f_down7[i,j] + (-1) * f_down8[i,j]
  u_up1[i,j] = momentum_up1[i,j] * rho[i,j]**(-1)
  u_up2[i,j] = momentum_up2[i,j] * rho[i,j]**(-1)
  cu_down1[i,j] = 0
  cu_down2[i,j] = u_up1[i,j]
  cu_down3[i,j] = (-1) * u_up1[i,j]
  cu_down4[i,j] = u_up2[i,j]
  cu_down5[i,j] = (-1) * u_up2[i,j]
  cu_down6[i,j] = u_up1[i,j] + u_up2[i,j]
  cu_down7[i,j] = (-1) * u_up1[i,j] + (-1) * u_up2[i,j]
  cu_down8[i,j] = u_up1[i,j] + (-1) * u_up2[i,j]
  cu_down9[i,j] = u_up2[i,j] + (-1) * u_up1[i,j]
  uu[i,j] = u_up1[i,j]**2 + u_up2[i,j]**2
  feq_down1[i,j] = (-2 / 3) * rho[i,j] * uu[i,j] + 2 * rho[i,j] * cu_down1[i,j]**2 + (4 / 3) * cu_down1[i,j] * rho[i,j] + (4 / 9) * deltaRho[i,j]
  feq_down2[i,j] = (-1 / 6) * rho[i,j] * uu[i,j] + (1 / 2) * rho[i,j] * cu_down2[i,j]**2 + (1 / 3) * cu_down2[i,j] * rho[i,j] + (1 / 9) * deltaRho[i,j]
  feq_down3[i,j] = (-1 / 6) * rho[i,j] * uu[i,j] + (1 / 2) * rho[i,j] * cu_down3[i,j]**2 + (1 / 3) * cu_down3[i,j] * rho[i,j] + (1 / 9) * deltaRho[i,j]
  feq_down4[i,j] = (-1 / 6) * rho[i,j] * uu[i,j] + (1 / 2) * rho[i,j] * cu_down4[i,j]**2 + (1 / 3) * cu_down4[i,j] * rho[i,j] + (1 / 9) * deltaRho[i,j]
  feq_down5[i,j] = (-1 / 6) * rho[i,j] * uu[i,j] + (1 / 2) * rho[i,j] * cu_down5[i,j]**2 + (1 / 3) * cu_down5[i,j] * rho[i,j] + (1 / 9) * deltaRho[i,j]
  feq_down6[i,j] = (-1 / 24) * rho[i,j] * uu[i,j] + (1 / 8) * rho[i,j] * cu_down6[i,j]**2 + (1 / 12) * cu_down6[i,j] * rho[i,j] + (1 / 36) * deltaRho[i,j]
  feq_down7[i,j] = (-1 / 24) * rho[i,j] * uu[i,j] + (1 / 8) * rho[i,j] * cu_down7[i,j]**2 + (1 / 12) * cu_down7[i,j] * rho[i,j] + (1 / 36) * deltaRho[i,j]
  feq_down8[i,j] = (-1 / 24) * rho[i,j] * uu[i,j] + (1 / 8) * rho[i,j] * cu_down8[i,j]**2 + (1 / 12) * cu_down8[i,j] * rho[i,j] + (1 / 36) * deltaRho[i,j]
  feq_down9[i,j] = (-1 / 24) * rho[i,j] * uu[i,j] + (1 / 8) * rho[i,j] * cu_down9[i,j]**2 + (1 / 12) * cu_down9[i,j] * rho[i,j] + (1 / 36) * deltaRho[i,j]
  collision_down1[i,j] = (-1) * f_down1[i,j] * tau**(-1) + feq_down1[i,j] * tau**(-1)
  collision_down2[i,j] = (-1) * f_down2[i,j] * tau**(-1) + feq_down2[i,j] * tau**(-1)
  collision_down3[i,j] = (-1) * f_down3[i,j] * tau**(-1) + feq_down3[i,j] * tau**(-1)
  collision_down4[i,j] = (-1) * f_down4[i,j] * tau**(-1) + feq_down4[i,j] * tau**(-1)
  collision_down5[i,j] = (-1) * f_down5[i,j] * tau**(-1) + feq_down5[i,j] * tau**(-1)
  collision_down6[i,j] = (-1) * f_down6[i,j] * tau**(-1) + feq_down6[i,j] * tau**(-1)
  collision_down7[i,j] = (-1) * f_down7[i,j] * tau**(-1) + feq_down7[i,j] * tau**(-1)
  collision_down8[i,j] = (-1) * f_down8[i,j] * tau**(-1) + feq_down8[i,j] * tau**(-1)
  collision_down9[i,j] = (-1) * f_down9[i,j] * tau**(-1) + feq_down9[i,j] * tau**(-1)
  cg_down1'[i,j] = cg_down1[i,j]
  cg_down2'[i,j] = cg_down2[i,j]
  cg_down3'[i,j] = cg_down3[i,j]
  cg_down4'[i,j] = cg_down4[i,j]
  cg_down5'[i,j] = cg_down5[i,j]
  cg_down6'[i,j] = cg_down6[i,j]
  cg_down7'[i,j] = cg_down7[i,j]
  cg_down8'[i,j] = cg_down8[i,j]
  cg_down9'[i,j] = cg_down9[i,j]
  ug[i,j] = (-1) * gravity * u_up2[i,j] + u_up1[i,j] * (if scenario > (3 / 2) then (1 / 1000) else 0)
