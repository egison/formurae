  wallRight_up2_down2[i,j] = if (if (-1 / 2) * hy + dy * ((1 / 2) + j) > extent + (-1 / 4) * hy then 1 else 0) > (1 / 2) then left_up2_down2[i,j] else right_up2_down2[i,j]
