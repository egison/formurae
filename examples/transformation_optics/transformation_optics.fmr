  B_down2'[i,j,k] = B_down2[i,j,k] + (-1) * dt * (E_down1'[i,j,k] + (-1) * E_down1'[i,j,k-1]) / dz + dt * (E_down3'[i,j,k] + (-1) * E_down3'[i-1,j,k]) / dx
  B_down3'[i,j,k] = B_down3[i,j,k] + (-1) * dt * (E_down2'[i,j,k] + (-1) * E_down2'[i-1,j,k]) / dx + dt * (E_down1'[i,j,k] + (-1) * E_down1'[i,j-1,k]) / dy
  H_down1'[i,j,k] = B_down1'[i,j,k] * ((1 / 2) * Minv_up1_up1[i,j,k] + (1 / 2) * Minv_up1_up1[i+1,j,k]) + ((1 / 2) * Minv_up1_up2[i,j,k] + (1 / 2) * Minv_up1_up2[i+1,j,k]) * ((1 / 4) * B_down2'[i,j-1,k] + (1 / 4) * B_down2'[i,j,k] + (1 / 4) * B_down2'[i+1,j-1,k] + (1 / 4) * B_down2'[i+1,j,k]) + ((1 / 2) * Minv_up1_up3[i,j,k] + (1 / 2) * Minv_up1_up3[i+1,j,k]) * ((1 / 4) * B_down3'[i,j,k-1] + (1 / 4) * B_down3'[i,j,k] + (1 / 4) * B_down3'[i+1,j,k-1] + (1 / 4) * B_down3'[i+1,j,k])
