  Ev_down1'[i,j,k] = Ev_down1[i,j,k] + (-1) * dt * (Bv_down2[i,j,k+1] + (-1) * Bv_down2[i,j,k]) / dz + dt * (Bv_down3[i,j+1,k] + (-1) * Bv_down3[i,j,k]) / dy
  Ev_down2'[i,j,k] = Ev_down2[i,j,k] + (-1) * dt * (Bv_down3[i+1,j,k] + (-1) * Bv_down3[i,j,k]) / dx + dt * (Bv_down1[i,j,k+1] + (-1) * Bv_down1[i,j,k]) / dz
  Ev_down3'[i,j,k] = Ev_down3[i,j,k] + (-1) * dt * (Bv_down1[i,j+1,k] + (-1) * Bv_down1[i,j,k]) / dy + dt * (Bv_down2[i+1,j,k] + (-1) * Bv_down2[i,j,k]) / dx
  Bv_down1'[i,j,k] = Bv_down1[i,j,k] + (-1) * dt * (Ev_down3'[i,j,k] + (-1) * Ev_down3'[i,j-1,k]) / dy + dt * (Ev_down2'[i,j,k] + (-1) * Ev_down2'[i,j,k-1]) / dz
