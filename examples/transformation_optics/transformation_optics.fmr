  Bv_down3'[i,j,k] = Bv_down3[i,j,k] + (-1) * dt * (Ev_down2'[i,j,k] + (-1) * Ev_down2'[i-1,j,k]) / dx + dt * (Ev_down1'[i,j,k] + (-1) * Ev_down1'[i,j-1,k]) / dy
