begin function (E_down1',E_down2',E_down3',B_down1',B_down2',B_down3',H_down1',H_down2',H_down3',Ev_down1',Ev_down2',Ev_down3',Bv_down1',Bv_down2',Bv_down3',rh_up1',rh_up2',rh_up3',ph_up1',ph_up2',ph_up3',a',b',c',epsz',ie_down1',ie_down2',ie_down3',outside',scatter',incident',energy') = step(E_down1,E_down2,E_down3,B_down1,B_down2,B_down3,H_down1,H_down2,H_down3,Ev_down1,Ev_down2,Ev_down3,Bv_down1,Bv_down2,Bv_down3,rh_up1,rh_up2,rh_up3,ph_up1,ph_up2,ph_up3,a,b,c,epsz,ie_down1,ie_down2,ie_down3,outside,scatter,incident,energy)
  double [] :: E_down1', E_down2', E_down3', B_down1', B_down2', B_down3', H_down1', H_down2', H_down3', Ev_down1', Ev_down2', Ev_down3', Bv_down1', Bv_down2', Bv_down3', rh_up1', rh_up2', rh_up3', ph_up1', ph_up2', ph_up3', a', b', c', epsz', ie_down1', ie_down2', ie_down3', outside', scatter', incident', energy'
  Minv_up1_up1[i,j,k] = 2 * b[i,j,k] * ph_up1[i,j,k] * rh_up1[i,j,k] + a[i,j,k] * rh_up1[i,j,k]**2 + c[i,j,k] * ph_up1[i,j,k]**2
  Minv_up2_up2[i,j,k] = 2 * b[i,j,k] * ph_up2[i,j,k] * rh_up2[i,j,k] + a[i,j,k] * rh_up2[i,j,k]**2 + c[i,j,k] * ph_up2[i,j,k]**2
  Minv_up3_up3[i,j,k] = 2 * b[i,j,k] * ph_up3[i,j,k] * rh_up3[i,j,k] + a[i,j,k] * rh_up3[i,j,k]**2 + c[i,j,k] * ph_up3[i,j,k]**2
  Minv_up1_up2[i,j,k] = a[i,j,k] * rh_up1[i,j,k] * rh_up2[i,j,k] + b[i,j,k] * ph_up1[i,j,k] * rh_up2[i,j,k] + b[i,j,k] * ph_up2[i,j,k] * rh_up1[i,j,k] + c[i,j,k] * ph_up1[i,j,k] * ph_up2[i,j,k]
  Minv_up1_up3[i,j,k] = a[i,j,k] * rh_up1[i,j,k] * rh_up3[i,j,k] + b[i,j,k] * ph_up1[i,j,k] * rh_up3[i,j,k] + b[i,j,k] * ph_up3[i,j,k] * rh_up1[i,j,k] + c[i,j,k] * ph_up1[i,j,k] * ph_up3[i,j,k]
  Minv_up2_up3[i,j,k] = a[i,j,k] * rh_up2[i,j,k] * rh_up3[i,j,k] + b[i,j,k] * ph_up2[i,j,k] * rh_up3[i,j,k] + b[i,j,k] * ph_up3[i,j,k] * rh_up2[i,j,k] + c[i,j,k] * ph_up2[i,j,k] * ph_up3[i,j,k]
  E_down1'[i,j,k] = 0
  E_down2'[i,j,k] = 0
