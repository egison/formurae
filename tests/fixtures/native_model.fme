dimension 2
axes x, y
param gain = 2
field q
field time
field dt
init:
  q = 1
  time = 0
  dt = 0.125
stage advance:
  q' = q + dt * gain
  time' = time + dt
runtime:
  grid 9 8
  extent 1 1
  halo 1
  time time
  timestep dt
  steps 2
  every 1
  output q
  monitor value first q 0
advance:
  call advance
observe:
  require min q > 0 0
