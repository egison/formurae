--
-- formurae-geometry.egi : differential-form geometry on structured grids
--
-- Load formurae-tensor.egi before this file.  This library contains only
-- continuum form and metric algebra; formurae-post owns grid placement, stencils,
-- conservative fluxes, and auxiliary storage.
--

def FE.formBasisSign (indices: [Integer]) : MathValue :=
  if length (unique indices) < length indices
    then 0
    else let (sign, _) := sortWithSign (map (\index -> [index]) indices)
          in sign

def FE.formBasisContains (axis: Integer) (basis: [Integer]) : Bool :=
  any (\candidate -> axis = candidate) basis

def FE.complementFormBasis
      (dim: Integer) (basis: [Integer]) : [Integer] :=
  filter (\axis -> not (FE.formBasisContains axis basis)) (between 1 dim)

-- Orthogonal metric geometry.  Storage/materialization remains a backend
-- concern; these functions own only the coordinate-free symbolic formulas.
def FE.inducedMetric
      (coords: Vector MathValue) (embedding: [MathValue])
      (a: Integer) (b: Integer) : MathValue :=
  sum (map (\component ->
              ∂/∂ component coords_a * ∂/∂ component coords_b)
           embedding)

def FE.metricTensor
      (dim: Integer)
      (component: Integer -> Integer -> MathValue) : Tensor MathValue :=
  generateTensor (\[i, j] -> component i j) [dim, dim]

def FE.diagonalMetricTensor
      (dim: Integer) (scale: Integer -> MathValue) : Tensor MathValue :=
  FE.metricTensor dim (\i j -> if i = j then (scale i) ^ 2 else 0)

def FE.inverseDiagonalMetricTensor
      (dim: Integer) (scale: Integer -> MathValue) : Tensor MathValue :=
  FE.metricTensor dim (\i j -> if i = j then 1 / ((scale i) ^ 2) else 0)

def FE.orthogonalVolume
      (axes: [Integer]) (scale: Integer -> MathValue) : MathValue :=
  product (map scale axes)

def FE.orthogonalHodgeCoefficient
      (axes: [Integer]) (scale: Integer -> MathValue)
      (basis: [Integer]) : MathValue :=
  FE.orthogonalVolume axes scale
  / product (map (\axis -> (scale axis) ^ 2) basis)

-- General (possibly non-orthogonal) metric geometry declared by its
-- components.  Only the inverse and the volume element are derived here;
-- the closed forms cover the grid dimensions Formurae supports.
def FE.metricDeterminant (dim: Integer) (t: Tensor MathValue) : MathValue :=
  let at := \i j -> FE.tensorComponentAt t [i, j]
   in if dim = 1 then at 1 1
      else if dim = 2 then at 1 1 * at 2 2 - at 1 2 * at 2 1
      else if dim = 3
        then at 1 1 * (at 2 2 * at 3 3 - at 2 3 * at 3 2)
             - at 1 2 * (at 2 1 * at 3 3 - at 2 3 * at 3 1)
             + at 1 3 * (at 2 1 * at 3 2 - at 2 2 * at 3 1)
      else if assert "metric tensor declarations support dimension 1 to 3" False
        then 0 else 0

def FE.inverseMetricTensor (dim: Integer) (t: Tensor MathValue) : Tensor MathValue :=
  let at := \i j -> FE.tensorComponentAt t [i, j]
      det := FE.metricDeterminant dim t
      others := \k -> filter (\x -> not (x = k)) (between 1 dim)
      sign := \i j -> if i = j then 1 else if abs (i - j) = 2 then 1 else -1
      -- cofactor of entry (row, column), transposed for the adjugate
      minor := \row column ->
        if dim = 1 then 1
        else if dim = 2
          then at (head (others row)) (head (others column))
          else let rs := others row
                   cs := others column
                in at (nth 1 rs) (nth 1 cs) * at (nth 2 rs) (nth 2 cs)
                   - at (nth 1 rs) (nth 2 cs) * at (nth 2 rs) (nth 1 cs)
   in generateTensor (\[i, j] -> sign i j * minor j i / det) [dim, dim]
